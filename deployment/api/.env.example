# GoCloud Chatbot API — Environment Variables
# Copy this file to .env and fill in the values

# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: CORS origin (default: https://www.gocloudeg.com)
# CORS_ORIGIN=https://www.gocloudeg.com

# Optional: Additional allowed origins (comma-separated)
# CORS_ORIGIN=https://www.gocloudeg.com,https://gocloudeg.com

# Optional: Require this header for chatbot requests: x-gocloud-chat-token
# CHATBOT_API_TOKEN=replace_with_long_random_value
# In production, set this to the same value configured in web.config rewrite
# server variable HTTP_X_GOCLOUD_CHAT_TOKEN.

# Optional: Abuse control limits
# CHAT_RATE_LIMIT_PER_MIN=10
# CHAT_RATE_LIMIT_PER_DAY=250

# Optional: Newsletter subscription protection
# NEWSLETTER_RATE_LIMIT_PER_15_MIN=8
