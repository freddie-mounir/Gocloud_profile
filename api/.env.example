# GoCloud Chatbot API — Environment Variables
# Copy this file to .env and fill in the values

# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: CORS origin (default: https://www.gocloudeg.com)
# CORS_ORIGIN=https://www.gocloudeg.com

# Optional: Additional allowed origins (comma-separated)
# CORS_ORIGIN=https://www.gocloudeg.com,https://gocloudeg.com

# Optional: Require this header for chatbot requests: x-gocloud-chat-token
# CHATBOT_API_TOKEN=replace_with_long_random_value
# In production, set this to the same value configured in web.config rewrite
# server variable HTTP_X_GOCLOUD_CHAT_TOKEN.

# Optional: Abuse control limits
# CHAT_RATE_LIMIT_PER_MIN=10
# CHAT_RATE_LIMIT_PER_DAY=250

# Optional: Newsletter subscription protection
# NEWSLETTER_RATE_LIMIT_PER_15_MIN=8

# Optional: Newsletter source label and token TTL in hours
# NEWSLETTER_SOURCE_LABEL=Website Newsletter (Subscribe for Practical Updates)
# NEWSLETTER_TOKEN_TTL_HOURS=48

# Optional: Public confirmation URL used in opt-in emails
# NEWSLETTER_CONFIRMATION_URL=https://www.gocloudeg.com/api/newsletter/confirm
# NEWSLETTER_PREFERENCES_URL=https://www.gocloudeg.com/api/newsletter/preferences
# NEWSLETTER_UNSUBSCRIBE_URL=https://www.gocloudeg.com/api/newsletter/unsubscribe
# NEWSLETTER_PREFERENCES_SECRET=replace_with_long_random_secret

# Optional: Instant welcome newsletter after confirmation
# NEWSLETTER_WELCOME_ENABLED=true
# NEWSLETTER_WELCOME_ENTRY_ID=welcome-gocloud
# NEWSLETTER_WELCOME_SEND_TIMEOUT_MS=60000

# Optional: Cloudflare Turnstile secret for server verification
# TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
# TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
# TURNSTILE_ACTION=newsletter_subscribe

# Required for double opt-in email sending
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=marketing@gocloudeg.com
# SMTP_PASS=replace_with_smtp_password
# SMTP_FROM=marketing@gocloudeg.com

# Optional: mailbox that receives service-watchdog failure alerts (defaults to SMTP_USER)
# ADMIN_ALERT_EMAIL=admin@gocloudeg.com

# Optional: Odoo CRM and Mailing sync
# ODOO_URL=https://odoo.your-domain.com
# ODOO_DB=your_odoo_database
# ODOO_USERNAME=api_user@example.com
# ODOO_PASSWORD="replace_with_odoo_password"
# ODOO_CRM_MODEL=crm.lead
# ODOO_MAILING_LIST_ID=0
# ODOO_OPPORTUNITY_SOURCES=demo,request-demo,book-demo,demo-form,contact-sales,sales-contact

# Optional request body override for high-intent forms:
# crmType=opportunity

# If any secret contains #, spaces, or special characters, wrap it in double quotes.
