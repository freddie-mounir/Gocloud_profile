# GoCloud Website Environment Variables
# Copy this file to .env and update with your actual values

# Site Configuration
SITE_URL=https://gocloud.com
SITE_NAME=GoCloud
SITE_DESCRIPTION=Professional Cloud Services and Odoo Development

# API Keys (if needed)
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# GOOGLE_MAPS_API_KEY=your_maps_api_key_here
# RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Contact Form (if backend integration needed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password_here
# CONTACT_EMAIL=info@gocloud.com

# Development
NODE_ENV=development
PORT=8000

# Build Configuration
BUILD_OUTPUT_DIR=dist
