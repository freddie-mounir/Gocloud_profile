{
  "name": "gocloud-website",
  "version": "2.0.0",
  "description": "GoCloud Professional Website - Modern, Optimized, and SEO-Ready",
  "main": "index.html",
  "author": "GoCloud Team",
  "license": "MIT",
  "homepage": "https://github.com/freddie-mounir/Gocloud_profile",
  "repository": {
    "type": "git",
    "url": "https://github.com/freddie-mounir/Gocloud_profile.git"
  },
  "keywords": [
    "gocloud",
    "cloud-services",
    "odoo",
    "web-development",
    "pug",
    "responsive-design"
  ],
  "scripts": {
    "dev": "npm run watch",
    "start": "npm run serve",
    "build": "pug views --out . --pretty",
    "build:prod": "npm run build && npm run minify:css && npm run minify:js",
    "watch": "pug views --out . --pretty --watch",
    "serve": "npx http-server . -p 8000 -o",
    "minify:css": "postcss css/main.css -o css/main.min.css",
    "minify:js": "terser js/main.js -o js/main.min.js --compress --mangle",
    "purge": "purgecss --config purgecss.config.js",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write \"**/*.{js,json,css,md,pug}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md,pug}\"",
    "test:lighthouse": "lighthouse http://localhost:8000 --output=html --output-path=./lighthouse-report.html --view",
    "test:html": "html-validate \"*.html\"",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "clean": "rimraf dist/",
    "prebuild:prod": "npm run clean",
    "postbuild:prod": "echo Build completed successfully!"
  },
  "dependencies": {
    "pug-cli": "^1.0.0-alpha6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.1.2",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.3.3",
    "purgecss": "^7.0.0",
    "rimraf": "^6.0.1",
    "terser": "^5.44.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
