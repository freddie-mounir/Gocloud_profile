//- GoCloud AI Chatbot Widget Component
style.
  .gc-chat-btn{position:fixed;bottom:170px;right:30px;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#0E38B1,#113ADC);color:#fff;border:none;cursor:pointer;z-index:1100;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(14,56,177,.35);transition:all .3s}
  .gc-chat-btn:hover{transform:scale(1.08);box-shadow:0 6px 28px rgba(14,56,177,.45)}
  .gc-chat-btn .gc-badge{position:absolute;top:-2px;right:-2px;width:18px;height:18px;background:#A1E934;border-radius:50%;border:2px solid #fff;animation:gc-pulse 2s infinite}
  @keyframes gc-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.2)}}
  .gc-chat-btn i{font-size:1.4rem}
  .gc-chat-panel{position:fixed;bottom:170px;right:30px;width:380px;height:520px;background:#fff;border-radius:20px;box-shadow:0 12px 48px rgba(0,0,0,.15);z-index:1100;display:none;flex-direction:column;overflow:hidden;border:1px solid #e9ecef}
  .gc-chat-panel.gc-open{display:flex}
  .gc-chat-header{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 100%);padding:16px 20px;display:flex;align-items:center;gap:12px;flex-shrink:0}
  .gc-chat-header img{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.15);padding:4px}
  .gc-chat-header-info{flex:1}
  .gc-chat-header-info h6{color:#fff;font-size:.9rem;font-weight:700;margin:0}
  .gc-chat-header-info span{color:rgba(255,255,255,.7);font-size:.72rem}
  .gc-chat-close{background:none;border:none;color:rgba(255,255,255,.7);font-size:1.1rem;cursor:pointer;padding:4px 8px;border-radius:8px;transition:all .2s}
  .gc-chat-close:hover{color:#fff;background:rgba(255,255,255,.15)}
  .gc-chat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;background:#f8f9fb}
  .gc-chat-messages::-webkit-scrollbar{width:4px}
  .gc-chat-messages::-webkit-scrollbar-thumb{background:#c7d2fe;border-radius:4px}
  .gc-msg{max-width:85%;padding:10px 14px;border-radius:16px;font-size:.875rem;line-height:1.6;word-wrap:break-word}
  .gc-msg a{color:inherit;text-decoration:underline}
  .gc-msg-bot{background:#fff;color:#333;align-self:flex-start;border:1px solid #e9ecef;border-bottom-left-radius:4px;box-shadow:0 1px 4px rgba(0,0,0,.04)}
  .gc-msg-user{background:linear-gradient(135deg,#0E38B1,#113ADC);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
  .gc-typing{align-self:flex-start;background:#fff;border:1px solid #e9ecef;border-radius:16px;padding:10px 18px;display:none;gap:4px;align-items:center;box-shadow:0 1px 4px rgba(0,0,0,.04)}
  .gc-typing.gc-show{display:flex}
  .gc-typing span{width:6px;height:6px;background:#0E38B1;border-radius:50%;animation:gc-bounce .6s infinite alternate}
  .gc-typing span:nth-child(2){animation-delay:.2s}
  .gc-typing span:nth-child(3){animation-delay:.4s}
  @keyframes gc-bounce{to{transform:translateY(-6px);opacity:.4}}
  .gc-chat-input{display:flex;align-items:flex-end;gap:8px;padding:12px 16px;border-top:1px solid #e9ecef;background:#fff;flex-shrink:0}
  .gc-chat-input textarea{flex:1;border:1px solid #dee2e6;border-radius:20px;padding:10px 16px;font-size:.875rem;outline:none;transition:border-color .2s;resize:none;max-height:120px;min-height:40px;height:40px;line-height:1.4;font-family:inherit;overflow-y:auto}
  .gc-chat-input textarea:focus{border-color:#0E38B1;box-shadow:0 0 0 3px rgba(14,56,177,.1)}
  .gc-chat-input button{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#0E38B1,#113ADC);color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
  .gc-chat-input button:hover{transform:scale(1.05);box-shadow:0 4px 12px rgba(14,56,177,.3)}
  .gc-chat-input button:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
  .gc-chat-powered{text-align:center;padding:6px;font-size:.65rem;color:#999;background:#fff;border-top:1px solid #f0f1f5;flex-shrink:0}
  @media (max-width: 767px){.gc-chat-btn{display:none}.gc-chat-panel{display:none!important}}
  @media(max-width:576px){.gc-chat-panel{width:100%;height:100%;bottom:0;right:0;border-radius:0}.gc-chat-btn{bottom:18px;left:12px;right:auto}}

//- Chat toggle button
button#gcChatBtn.gc-chat-btn(type="button" aria-label="Open AI Chat Assistant" title="Chat with GoCloud AI")
  i.fa-solid.fa-robot(aria-hidden="true")
  span.gc-badge(aria-hidden="true")

//- Chat panel
#gcChatPanel.gc-chat-panel(role="dialog" aria-label="GoCloud AI Chat Assistant")
  .gc-chat-header
    img(src="images/gocloud%20logo.webp" alt="GoCloud" loading="lazy")
    .gc-chat-header-info
      h6 GoCloud AI Assistant
      span
        i.fa-solid.fa-circle.me-1(style="font-size:6px;color:#A1E934;")
        | Online
    button.gc-chat-close(type="button" aria-label="Close chat")
      i.fa-solid.fa-xmark(aria-hidden="true")
  #gcChatMessages.gc-chat-messages(aria-live="polite" aria-label="Chat messages")
    .gc-typing#gcTyping(aria-label="Assistant is typing")
      span
      span
      span
  .gc-chat-input
    textarea#gcChatInput(placeholder="Ask about Odoo, ELITE, or our services..." aria-label="Type your message" autocomplete="off" maxlength="500" rows="1")
    button#gcChatSend(type="button" aria-label="Send message")
      i.fa-solid.fa-paper-plane(aria-hidden="true")
  .gc-chat-powered Powered by GoCloud AI

script(src="js/chatbot.min.js" defer)
