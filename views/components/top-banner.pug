//- Top announcement bar
- var p = typeof pathPrefix !== 'undefined' ? pathPrefix : ''
style.
  .top-bar{background:linear-gradient(90deg,#0a1e5e 0%,#0E38B1 50%,#0a1e5e 100%);padding:6px 0;position:relative;z-index:1000}
  .top-bar-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
  .top-bar-left{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
  .top-bar-item{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.8);font-size:.78rem;font-weight:500}
  .top-bar-item i{color:#A1E934;font-size:.7rem}
  .top-bar-item a{color:rgba(255,255,255,.8);text-decoration:none;transition:color .2s}
  .top-bar-item a:hover{color:#fff}
  .top-bar-lang .dropdown-toggle{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);border-radius:999px;padding:6px 12px;color:#fff;font-size:.72rem;font-weight:800;letter-spacing:.04em;line-height:1}
  .top-bar-lang .dropdown-toggle::after{margin-inline-start:4px}
  .top-bar-lang .dropdown-toggle:hover,.top-bar-lang .dropdown-toggle:focus{background:rgba(255,255,255,.18);color:#fff;box-shadow:none}
  .top-bar-lang .dropdown-toggle:focus-visible{outline:2px solid #A1E934;outline-offset:2px}
  .top-bar-lang .dropdown-menu{display:none;min-width:150px;border-radius:14px;border:1px solid #dfe6fb;box-shadow:0 18px 36px rgba(8,31,99,.12);padding:.35rem}
  .top-bar-lang .dropdown-menu.show{display:block}
  .top-bar-lang .dropdown-item{border-radius:10px;font-size:.88rem;font-weight:700;padding:.55rem .8rem;display:flex;align-items:center;justify-content:space-between;gap:.75rem}
  .top-bar-lang .dropdown-item.active,.top-bar-lang .dropdown-item:active{background:#0E38B1;color:#fff}
  .top-bar-calls{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .top-bar-call{display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:5px 12px;color:#fff;text-decoration:none;transition:background .2s,border-color .2s}
  .top-bar-call:hover{background:rgba(255,255,255,.18);border-color:rgba(255,255,255,.28);color:#fff}
  .top-bar-call i{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:rgba(161,233,52,.15);color:#A1E934;font-size:.8rem}
  .top-bar-call span{display:flex;flex-direction:column;line-height:1.15}
  .top-bar-call strong{font-size:.7rem;font-weight:700;color:rgba(255,255,255,.72);text-transform:uppercase;letter-spacing:.05em}
  .top-bar-call em{font-style:normal;font-size:.8rem;font-weight:700;color:#fff}
  .gc-phone-ltr{display:inline-block;direction:ltr;unicode-bidi:isolate}
  .top-bar-right{display:flex;align-items:center;gap:12px}
  .top-bar-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);border-radius:50px;padding:4px 12px 4px 4px;font-size:.7rem;font-weight:600;color:#fff;letter-spacing:.02em}
  .top-bar-badge img{height:22px;border-radius:50%;background:#fff;padding:1px}
  .top-bar-social a{color:rgba(255,255,255,.5);font-size:.8rem;margin-left:8px;transition:color .2s}
  .top-bar-social a:hover{color:#A1E934}
  @media(max-width:767px){.top-bar{position:relative;top:auto;left:auto;width:100%;z-index:1001;padding:5px 0}.top-bar-right{display:none}.top-bar-inner{gap:4px}.top-bar-left{width:100%;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:nowrap}.top-bar-item{display:none}.top-bar-calls{width:auto;gap:0}.top-bar-call{padding:4px 10px}.top-bar-call:nth-child(2){display:none}.top-bar-call i{width:24px;height:24px;font-size:.72rem}.top-bar-call strong{display:none}.top-bar-call em{font-size:.78rem}.top-bar-lang{margin-inline-start:auto}.top-bar-lang .dropdown-toggle{padding:6px 10px;font-size:.68rem}}

.top-bar
  .container
    .top-bar-inner
      .top-bar-left
        .top-bar-calls
          a.top-bar-call(href="tel:+201017383815" aria-label="Call GoCloud at +2 010 1738 3815")
            i.fas.fa-phone-alt
            span
              strong(data-i18n-key="topbar.call_label") Make a Call
              em.gc-phone-ltr +2 010 1738 3815
          a.top-bar-call(href="tel:+201222666635" aria-label="Call GoCloud at +20 122 266 6635")
            i.fas.fa-phone-alt
            span
              strong(data-i18n-key="topbar.call_label") Make a Call
              em.gc-phone-ltr +20 122 266 6635
        .dropdown.top-bar-lang
          button.btn.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Language switch" data-site-language-toggle)
