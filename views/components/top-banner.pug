            span(data-site-language-label) AR
          ul.dropdown-menu
            li
              button.dropdown-item(type="button" data-site-language="ar")
                span العربية
                span.small.text-muted AR
            li
              button.dropdown-item(type="button" data-site-language="en")
                span English
                span.small.text-muted EN
        .top-bar-item
          i.fas.fa-envelope
          a(href="mailto:marketing@gocloudeg.com") marketing@gocloudeg.com
        .top-bar-item
          i.fas.fa-map-marker-alt
          span Giza, Egypt
      .top-bar-right
        .top-bar-badge
          img(src=`${p}images/odoo_learning_partner_rgb%20(1).webp` alt="Odoo Official Partner" width="22" height="22")
