// Header Component
- var p = typeof pathPrefix !== 'undefined' ? pathPrefix : ''
style.
  .mobile-sidebar .gc-mobile-contact-compact h3{margin-bottom:8px!important}
  .mobile-sidebar .gc-mobile-contact-compact .contact-box{padding:3px 0!important;margin:0!important;border:0!important;align-items:flex-start}
  .mobile-sidebar .gc-mobile-contact-compact .contact-box+.contact-box{margin-top:2px!important}
  .mobile-sidebar .gc-mobile-contact-compact .contact-box .icon{margin-inline-end:10px!important;line-height:1}
  .mobile-sidebar .gc-mobile-contact-compact .contact-box .pera,.mobile-sidebar .gc-mobile-contact-compact .contact-box .pera a{line-height:1.2}
  .mobile-sidebar .gc-mobile-contact-compact .contact-box .pera a{display:inline-block;margin:0!important}
  .mobile-sidebar .gc-mobile-contact-compact .contact-box .pera p{margin:0}
  .mobile-sidebar .gc-mobile-contact-compact .d-flex.flex-column.gap-1{gap:.2rem!important}

header(role="banner")
  .header-area.header-area1.header-area-all.d-none.d-md-block.d-lg-block#header
    .container
      .row
        .col-12
          .header-elements
            div
              a(href=`${p}index.html` aria-label="GoCloud Home")
                img(src=`${p}images/gocloud%20logo.webp` alt="GoCloud Logo" height="100px" width="100px" loading="lazy")

            nav(role="navigation" aria-label="Main Navigation")
              .main-menu-ex.main-menu-ex1
                ul(role="menubar")
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}index.html` role="menuitem" data-i18n-key="nav.home") Home
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}about.html` role="menuitem" data-i18n-key="nav.about") About
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}service.html` role="menuitem" data-i18n-key="nav.services") Services
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}faq.html` role="menuitem" data-i18n-key="nav.faq") FAQ
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}blog/index.html` role="menuitem" style="display:inline-flex; align-items:center; gap:6px;")
                      i.fas.fa-blog.me-1
                      span(data-i18n-key="nav.blog") Blog
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}odoo-services.html` role="menuitem" style="color: #7c3aed; font-weight: 600;")
                      i.fab.fa-odoo.me-1
                      span(data-i18n-key="nav.odoo_services") Odoo Services
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}elite.html` role="menuitem" style="color: #ffd700; font-weight: 600; display:inline-flex; align-items:center; gap:6px;")
                      span(data-i18n-key="nav.elite") ELITE
                      span.badge.badge-warning.ms-1(data-i18n-key="nav.new_badge" style="font-size: 0.7rem; padding: 2px 6px; background: #ffd700; color: #1a237e;") NEW
                  li.dropdown-menu-parrent(role="none")
                    a(href=`${p}contact.html` role="menuitem" data-i18n-key="nav.contact") Contact

            .header1-buttons
              .button.d-flex.gap-2.flex-wrap.justify-content-end
                a.theme-btn1(href="#" data-bs-toggle="modal" data-bs-target="#demoModal" aria-label="Book a Free Demo")
                  i.fa-solid.fa-calendar-check.me-1(aria-hidden="true")
                  span(data-i18n-key="nav.book_demo") Book a Free Demo
                a.theme-btn1(href="https://wa.me/201017383815?text=Hello%2C%20I%20would%20like%20to%20get%20a%20quote" target="_blank" rel="noopener noreferrer" aria-label="Get a Quote via WhatsApp")
                  span(data-i18n-key="nav.get_quote") Get A Quote
                  span
                    i.fa-solid.fa-arrow-right(aria-hidden="true")

// Mobile Header
header(role="banner")
  .mobile-header.d-block.d-md-none.d-lg-none
    .container-fluid
      .col-12
        .mobile-header-elements
          .mobile-logo
            a(href=`${p}index.html` aria-label="GoCloud Home")
              img(src=`${p}images/gocloud%20logo.webp` height="100" width="100" alt="GoCloud Logo" loading="lazy")
          .mobile-nav-icon
            button.mobile-menu-toggle(type="button" aria-label="Open navigation menu" aria-expanded="false")
              i.fa-solid.fa-bars(aria-hidden="true")

  .mobile-sidebar.d-block.d-md-none.d-lg-none(role="dialog" aria-label="Mobile navigation menu")
    .logo-m
      a(href=`${p}index.html` aria-label="GoCloud Home")
        img(src=`${p}images/gocloud%20logo.webp` height="100" width="100" alt="GoCloud Logo" loading="lazy")
    .menu-close
      button.mobile-menu-close-btn(type="button" aria-label="Close navigation menu")
        i.fa-solid.fa-xmark(aria-hidden="true")
    .mobile-nav
      nav(role="navigation" aria-label="Mobile Navigation")
        ul(role="menubar")
          li(role="none")
            a(href=`${p}index.html` role="menuitem" data-i18n-key="nav.home") Home
          li(role="none")
            a(href=`${p}about.html` role="menuitem" data-i18n-key="nav.about_us") About Us
          li(role="none")
            a(href=`${p}service.html` role="menuitem" data-i18n-key="nav.services") Services
          li(role="none")
            a(href=`${p}faq.html` role="menuitem" data-i18n-key="nav.faq") FAQ
          li(role="none")
            a(href=`${p}blog/index.html` role="menuitem" style="display:inline-flex; align-items:center; gap:6px;")
              i.fas.fa-blog.me-2
              span(data-i18n-key="nav.blog") Blog
          li(role="none")
            a(href=`${p}odoo-services.html` role="menuitem" style="color: #7c3aed; font-weight: 600;")
              i.fab.fa-odoo.me-2
              span(data-i18n-key="nav.odoo_services") Odoo Services
          li(role="none")
            a(href=`${p}elite.html` role="menuitem" style="color: #ffd700; font-weight: 600; display:inline-flex; align-items:center; gap:6px;")
              span(data-i18n-key="nav.elite") ELITE
              span.badge.badge-warning.ms-2(data-i18n-key="nav.new_badge" style="font-size: 0.7rem; padding: 2px 6px; background: #ffd700; color: #1a237e;") NEW
          li(role="none")
            a(href=`${p}contact.html` role="menuitem" data-i18n-key="nav.contact") Contact

      .mobile-button
        a.menu-btn2.mb-2(href="#" data-bs-toggle="modal" data-bs-target="#demoModal" aria-label="Book a Free Demo")
          i.fa-solid.fa-calendar-check.me-1(aria-hidden="true")
          span(data-i18n-key="nav.book_demo") Book a Free Demo
        a.menu-btn2(href="https://wa.me/201017383815?text=Hello%2C%20I%20would%20like%20to%20get%20a%20quote" target="_blank" rel="noopener noreferrer" aria-label="Get a Quote via WhatsApp")
          span(data-i18n-key="nav.get_quote") Get A Quote
          span
            i.fa-solid.fa-arrow-right(aria-hidden="true")

      .single-footer-items.gc-mobile-contact-compact
        h3 Contact Us

        .contact-box
          .icon
            img(src=`${p}images/footer1-icon1.webp` alt="Phone Icon" width="24" height="24" loading="lazy")
          .pera
            a(href="tel://0233762533" aria-label="Call us at 0233762533") 0233762533

        .contact-box
          .icon
            img(src=`${p}images/footer1-icon2.webp` alt="Mobile Phone Icon" width="24" height="24" loading="lazy")
          .pera
            .d-flex.flex-column.gap-1
              a(href="tel://+201017383815" aria-label="Call us at +201017383815") +201017383815
              a(href="tel://+201222666635" aria-label="Call us at +201222666635") +201222666635

        .contact-box
          .icon
            img(src=`${p}images/footer1-icon3.webp` alt="Email Icon" width="24" height="24" loading="lazy")
          .pera
            a(href="mailto:marketing@gocloudeg.com" aria-label="Send email to marketing@gocloudeg.com") marketing@gocloudeg.com

        .contact-box
          .icon
            img(src=`${p}images/footer1-icon4.webp` alt="Website Icon" width="24" height="24" loading="lazy")
          .pera
            a(href="https://gocloudeg.com" aria-label="Visit GoCloud website") www.gocloudeg.com

      .contact-infos
        h3 Our Location
        ul.social-icon
          li
            a(href="https://www.linkedin.com/company/gocloud-co")
              i.fa-brands.fa-linkedin-in
          li
            a(href="https://www.google.com/search?q=gocloud+eg&sca_esv=1b465dddb89ef670&sxsrf=AE3TifPO8dDI2un8QLeuyTZoAmiw1QCmhA%3A1750690736441&ei=sGtZaLfRGoaNkdUP4_DKyAI&ved=0ahUKEwi36dOb54eOAxWGRqQEHWO4EikQ4dUDCBA&uact=5&oq=gocloud+&gs_&sclient=gws-wiz-serp")
              i.fa-brands.fa-google
          li
            a(href="https://www.youtube.com/@GoCloudeg")
              i.fa-brands.fa-youtube
