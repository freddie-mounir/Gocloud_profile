extends layout.pug

block variables
  - var pageTitle = "Odoo ERP Implementation — End-to-End Deployment | GoCloud"
  - var pageDescription = "Professional Odoo ERP implementation services — from business analysis and data migration to training and go-live support. Official Odoo partner in Egypt."
  - var pageKeywords = "Odoo implementation, ERP deployment, data migration, Odoo training, Odoo partner Egypt, business analysis"
  - var canonicalUrl = "https://www.gocloudeg.com/odoo-imp.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"

block styles
  style.
    /* ── Implementation Methodology Timeline ── */
    .impl-methodology {
      padding: 80px 0 60px;
      background: linear-gradient(135deg, #f8f9ff 0%, #eef1fb 100%);
      overflow: hidden;
    }
    .impl-methodology .section-heading {
      font-size: 2.25rem;
      font-weight: 800;
      color: #0D0E10;
      margin-bottom: .75rem;
    }
    .impl-methodology .section-sub {
      color: #6c757d;
      font-size: 1.05rem;
      max-width: 560px;
      margin: 0 auto 3.5rem;
    }

    /* timeline row */
    .impl-timeline {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      position: relative;
      gap: 0;
    }

    /* connector line */
    .impl-timeline::before {
      content: "";
      position: absolute;
      top: 40px;
      left: 12%;
      right: 12%;
      height: 3px;
      background: linear-gradient(90deg, #0E38B1, #6E18EF);
      border-radius: 2px;
      z-index: 0;
    }

    .impl-step {
      flex: 1;
      text-align: center;
      position: relative;
      z-index: 1;
      max-width: 180px;
    }

    .impl-step-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #fff;
      border: 3px solid #0E38B1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.65rem;
      color: #0E38B1;
      margin-bottom: 1rem;
      position: relative;
      transition: all .4s ease;
      box-shadow: 0 4px 16px rgba(14,56,177,.10);
    }

    .impl-step-icon .step-num {
      position: absolute;
      top: -6px;
      right: -6px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #A1E934;
      color: #0D0E10;
      font-size: .75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,.12);
    }

    .impl-step:hover .impl-step-icon {
      background: #0E38B1;
      color: #fff;
      transform: translateY(-6px);
      box-shadow: 0 10px 28px rgba(14,56,177,.25);
    }
    .impl-step:hover .impl-step-icon .step-num {
      background: #fff;
      color: #0E38B1;
    }

    .impl-step h5 {
      font-size: 1rem;
      font-weight: 700;
      color: #0D0E10;
      margin-bottom: .35rem;
    }
    .impl-step p {
      font-size: .85rem;
      color: #6c757d;
      line-height: 1.45;
      margin: 0;
      padding: 0 .25rem;
    }

    /* responsive */
    @media (max-width: 991px) {
      .impl-timeline { flex-wrap: wrap; gap: 2rem; }
      .impl-timeline::before { display: none; }
      .impl-step { flex: 0 0 calc(33.333% - 1.5rem); max-width: none; }
    }
    @media (max-width: 575px) {
      .impl-step { flex: 0 0 calc(50% - 1rem); }
      .impl-methodology { padding: 50px 0 40px; }
      .impl-methodology .section-heading { font-size: 1.75rem; }
    }

block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Section
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1 Odoo implementation
            .space16
            .span
              img(src="images/span1.webp" alt="" loading="lazy")
              |
              a(href="service.html") Service
              |
              span.arrow
                i.fa-regular.fa-angle-right
              |
              | Odoo implementation

  // Marquee Section
  include components/marquee-brands.pug

  // Implementation Process Section
  section.process-workflow.my-5.position-relative
    .container
      h2.text-center.mb-5(data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000") Our Odoo Implementation Process

      .row.g-4
        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000" style="transition: all 0.3s ease;")
          .card.h-100.border-0.shadow-sm
            .card-body.text-center
              .process-icon.mb-4
                i.fas.fa-search.fa-3x.text-primary
              h4.card-title Requirements Analysis
              p.card-text We analyze your business needs and processes to determine optimal Odoo implementation strategy.

        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="300" data-aos-duration="1000")
          .card.h-100.border-0.shadow-sm
            .card-body.text-center
              .process-icon.mb-4
                i.fas.fa-cogs.fa-3x.text-primary
              h4.card-title Configuration & Setup
              p.card-text Custom configuration of Odoo modules and features according to your requirements.

        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="400" data-aos-duration="1000")
          .card.h-100.border-0.shadow-sm
            .card-body.text-center
              .process-icon.mb-4
                i.fas.fa-code.fa-3x.text-primary
              h4.card-title Development & Integration
              p.card-text Custom module development and third-party system integration as needed.

        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="500" data-aos-duration="1000")
          .card.h-100.border-0.shadow-sm
            .card-body.text-center
              .process-icon.mb-4
                i.fas.fa-graduation-cap.fa-3x.text-primary
              h4.card-title Training & Support
              p.card-text Comprehensive training and ongoing support to ensure successful adoption.

  // Agile & Scrum Methodology Section
  section.agile-methodology.py-5.bg-light
    .container.text-center
      h2.text-center.mb-5(data-aos="fade-up" data-aos-delay="100" data-aos-duration="1000") Our Agile & Scrum Methodology

      .row.g-4
        .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
          .image.image-anime
            img(src="images/agile.webp" alt="Agile Scrum Methodology" class="img-fluid rounded shadow-sm" style="max-width: 80%;" loading="lazy")

        .col-lg-6(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000")
          .methodology-content
            h3.mb-4 Why We Choose Agile
            .methodology-features
              .feature.mb-4
                h5
                  i.fas.fa-check-circle.text-primary.me-2
                  | Iterative Development
                p Regular delivery of working software with continuous feedback and improvements.

              .feature.mb-4
                h5
                  i.fas.fa-check-circle.text-primary.me-2
                  | Flexibility & Adaptability
                p Quick response to change and evolving business requirements.

              .feature.mb-4
                h5
                  i.fas.fa-check-circle.text-primary.me-2
                  | Client Collaboration
                p Close partnership with clients throughout development process.

              .feature
                h5
                  i.fas.fa-check-circle.text-primary.me-2
                  | Sprint-Based Delivery
                p Regular sprints ensuring measurable progress and timely delivery.

  // Implementation Methodology Section
  section.impl-methodology
    .container
      .text-center
        h2.section-heading(data-aos="fade-up" data-aos-duration="600") Implementation Methodology
        p.section-sub(data-aos="fade-up" data-aos-delay="100" data-aos-duration="600") Our proven 5-phase approach ensures a smooth, transparent, and successful Odoo rollout every time.

      .impl-timeline
        .impl-step(data-aos="fade-up" data-aos-delay="100" data-aos-duration="600")
          .impl-step-icon
            i.fas.fa-clipboard-list
            span.step-num 1
          h5 REQ Analysis
          p Capture & prioritize your business requirements

        .impl-step(data-aos="fade-up" data-aos-delay="200" data-aos-duration="600")
          .impl-step-icon
            i.fas.fa-drafting-compass
            span.step-num 2
          h5 Design
          p Architect the solution & map workflows

        .impl-step(data-aos="fade-up" data-aos-delay="300" data-aos-duration="600")
          .impl-step-icon
            i.fas.fa-vial
            span.step-num 3
          h5 UAT
          p Validate with real scenarios & sign-off

        .impl-step(data-aos="fade-up" data-aos-delay="400" data-aos-duration="600")
          .impl-step-icon
            i.fas.fa-chalkboard-teacher
            span.step-num 4
          h5 Training
          p Hands-on sessions for every user role

        .impl-step(data-aos="fade-up" data-aos-delay="500" data-aos-duration="600")
          .impl-step-icon
            i.fas.fa-headset
            span.step-num 5
          h5 Support
          p Ongoing maintenance & continuous improvement

  // Include footer
  include components/footer.pug

  // Include whatsapp button
  include components/whatsapp-button.pug
