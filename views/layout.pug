block variables
- var htmlLang = typeof pageLang !== 'undefined' ? pageLang : 'en'
- var htmlDir = typeof pageDir !== 'undefined' ? pageDir : 'ltr'
- var alternateAr = typeof alternateArUrl !== 'undefined' ? alternateArUrl : null
- var alternateEn = typeof alternateEnUrl !== 'undefined' ? alternateEnUrl : null
- var alternateDefault = alternateAr || alternateEn || null
doctype html
html(lang=htmlLang, dir=htmlDir)
  head
    script.
      (function () {
        var storageKey = 'gocloud-site-language';
        var savedLanguage = null;
        try {
          savedLanguage = localStorage.getItem(storageKey);
        } catch (error) {
          savedLanguage = null;
        }
        var initialLanguage = savedLanguage === 'ar' || savedLanguage === 'en' ? savedLanguage : 'en';
        var root = document.documentElement;
        root.lang = initialLanguage;
        root.dir = initialLanguage === 'ar' ? 'rtl' : 'ltr';
        root.dataset.siteLang = initialLanguage;
        root.classList.add('site-lang-' + initialLanguage);
      }());
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title=pageTitle
    meta(name="description", content=pageDescription)
    meta(name="keywords", content=pageKeywords)
    link(rel="canonical", href=canonicalUrl)
    meta(property="og:title", content=pageTitle)
    meta(property="og:description", content=pageDescription)
    meta(property="og:type", content="website")
    meta(property="og:url", content=canonicalUrl)
    meta(property="og:image", content=ogImage)
    meta(name="twitter:card", content="summary_large_image")
    meta(name="twitter:title", content=pageTitle)
    meta(name="twitter:description", content=pageDescription)
    meta(name="twitter:image", content=ogImage)
    // Accessibility improvements
    meta(name="theme-color", content="#ffffff")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    // Accessibility meta tags
    meta(name="robots", content="index, follow")
    meta(name="googlebot", content="index, follow")
    if alternateAr
      link(rel="alternate", hreflang="ar", href=alternateAr)
    if alternateEn
      link(rel="alternate", hreflang="en", href=alternateEn)
    if alternateDefault
      link(rel="alternate", hreflang="x-default", href=alternateDefault)

    script(type="application/ld+json").
      include ../js/organization-schema.json
    meta(name="gocloud-chat-token", content="")

    // Favicon
    link(rel="icon", href="images/favicon.ico", sizes="32x32")
    link(rel="icon", href="images/gocloud logo.webp", type="image/webp")
    // Apple Touch Icon
    link(rel="apple-touch-icon", sizes="180x180", href="images/icons/icon-192x192.png")
    // PWA Manifest
    link(rel="manifest", href="manifest.json")

