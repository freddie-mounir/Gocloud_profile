extends layout.pug

block variables
  - var pageTitle = "GoCloud — Odoo ERP & Insurance Technology Experts"
  - var pageDescription = "GoCloud delivers industry-specific Odoo ERP solutions, medical insurance systems, and cloud infrastructure for healthcare, trade, and distribution businesses across Egypt and the Middle East."
  - var pageKeywords = "Odoo ERP, medical insurance system, healthcare IT, trade ERP, Odoo implementation, Odoo customization, business intelligence, cloud hosting, GoCloud Egypt"
  - var canonicalUrl = "https://www.gocloudeg.com/"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"

block styles
  style.
    .hero-badge{display:inline-flex;align-items:center;gap:8px;background:#0E38B1;border-radius:50px;padding:8px 18px;font-size:.8rem;font-weight:600;color:#fff;margin-bottom:1.5rem;box-shadow:0 4px 14px rgba(14,56,177,.3)}
    .hero-badge i{color:#A1E934;margin-right:2px}
    .hero1 .main-headding h1{font-size:2.75rem;line-height:1.2;font-weight:800;color:#0D0E10}
    .hero1 .main-headding h1 .text-accent{color:#0E38B1}
    .hero1 .main-headding .hero-sub{font-size:1.05rem;line-height:1.7;color:#4a4b5c;max-width:480px}
    .hero1 .main-headding .span{color:#0E38B1!important;font-weight:600}
    .hero-img-wrapper{position:relative;display:inline-block}
    .hero-img-wrapper img{border-radius:20px;box-shadow:0 24px 64px rgba(14,56,177,.18);transition:transform .5s ease}
    .hero-img-wrapper:hover img{transform:scale(1.03)}
    .hero-img-wrapper::before{content:"";position:absolute;top:-12px;left:-12px;right:12px;bottom:12px;border:3px solid #0E38B1;border-radius:24px;z-index:-1;opacity:.3}
    .hero-img-wrapper::after{content:"";position:absolute;top:12px;left:12px;right:-12px;bottom:-12px;background:linear-gradient(135deg,rgba(14,56,177,.08),rgba(161,233,52,.08));border-radius:24px;z-index:-1}
    .hero-img-glow{position:absolute;width:200px;height:200px;border-radius:50%;filter:blur(80px);opacity:.4;z-index:-2}
    .hero-img-glow--blue{background:#0E38B1;top:-40px;right:-40px}
    .hero-img-glow--green{background:#A1E934;bottom:-40px;left:-40px}
    .btn-hero-outline{border:2px solid #0E38B1;color:#0E38B1;background:transparent;border-radius:50px;padding:10px 24px;font-weight:600;transition:all .3s}
    .btn-hero-outline:hover{background:#0E38B1;color:#fff}
    .stat-strip{background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,.06);padding:2rem 1rem;margin-top:-3rem;position:relative;z-index:10}
    .stat-item{text-align:center;padding:.5rem}
    .stat-item .stat-num{font-size:2rem;font-weight:800;color:#0E38B1}
    .stat-item .stat-label{font-size:.825rem;color:#676879;margin-top:2px}
    .sector-card{background:#fff;border-radius:16px;padding:2.5rem 2rem;box-shadow:0 2px 20px rgba(0,0,0,.05);border:1px solid #e9ecef;transition:all .35s ease;height:100%}
    .sector-card:hover{transform:translateY(-6px);box-shadow:0 12px 36px rgba(14,56,177,.1);border-color:#0E38B1}
    .sector-card .sector-icon{width:56px;height:56px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;margin-bottom:1.25rem}
    .sector-card h4{font-size:1.15rem;font-weight:700;margin-bottom:.75rem}
    .sector-card p{color:#676879;font-size:.925rem;line-height:1.65}
    .sector-card .sector-features{list-style:none;padding:0;margin:1rem 0 0}
    .sector-card .sector-features li{padding:4px 0;font-size:.875rem;color:#676879}
    .sector-card .sector-features li i{color:#0E38B1;margin-right:8px;font-size:.75rem}
    .about-highlight{border-left:3px solid #0E38B1;padding-left:1rem;margin-bottom:1rem}
    .about-highlight h5{font-size:1rem;font-weight:700;margin-bottom:.25rem}
    .about-highlight p{font-size:.875rem;color:#676879;margin:0}
    .home-cta{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 100%);border-radius:16px;padding:3.5rem 2rem}

block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  //---------- HERO ----------
  .hero1(style="background-image: url(images/hero1-bg.png); background-position: center; background-repeat: no-repeat; background-size: cover;")
    .container
      .row
        .col-lg-5
          .main-headding
            .hero-badge
              i.fas.fa-award
              | Official Odoo Partner
            .span(style="color:blue" data-aos="zoom-in-left" data-aos-duration="700")
              img(src="images/gocloud%20logo.webp" height="40" width="40" alt="GoCloud logo")
              | GoCloud Technology
            h1.title.tg-element-title
              | Odoo ERP Experts &amp;
              br
              | Insurance Technology
              br
              span.text-accent Tailored to Your Industry
            .space16
            p.hero-sub We implement, customize, and integrate Odoo ERP for healthcare, trade, and distribution — and power medical insurance operations with our ELITE platform.
            .space30
            .buttons.d-flex.gap-3.flex-wrap
              a.theme-btn1(href="#CTA") Get Started Now
                span
                  i.fa-solid.fa-arrow-right
              a.btn.btn-hero-outline(href="service.html") View All Services

        .col-lg-7
          .hero1-all-images
            .hero-img-wrapper
              .hero-img-glow.hero-img-glow--blue
              .hero-img-glow.hero-img-glow--green
              img(src="images/odoo_partner.webp" alt="GoCloud and Odoo official partnership" width="500" height="500")
            .d-flex.counter-box.shape-animaiton2.counter-box-width.shadow-lg-3(style="background-color: #1a237e; border-radius: 15px; padding: 15px;")
              p.fs-3.text-white#yearsCounter
                | +
                span 10
              p.text-warning.fw-bold.w-auto
                | Years Of
                br
                | Experience
            .shape1
              img(src="images/header1-shape1.png" alt="")

  //---------- STATS STRIP ----------
  .container
    .stat-strip(data-aos="fade-up")
      .row.align-items-center
        .col-6.col-md-3
          .stat-item
            .stat-num +80K
            .stat-label Supported Users
        .col-6.col-md-3
          .stat-item
            .stat-num +20
            .stat-label Corporate Clients
        .col-6.col-md-3
          .stat-item
            .stat-num +10
            .stat-label Solutions Delivered
        .col-6.col-md-3
          .stat-item
            .stat-num +50
            .stat-label Completed Projects

  .space40

  // Marquee
  include components/marquee-brands.pug

  .space40

  //---------- SECTOR-SPECIFIC SOLUTIONS ----------
  section.py-5
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold Industry Solutions, Not Generic Services
        p.lead.text-muted We don't sell off-the-shelf software — we build solutions around how your industry actually works.

      .row.g-4
        //- Healthcare
        .col-lg-6(data-aos="fade-up" data-aos-delay="100")
          .sector-card
            .sector-icon(style="background:#dc3545;")
              i.fas.fa-heartbeat
            h4 Healthcare &amp; Medical Insurance
            p From provider network management to claims processing and member portals — we deliver end-to-end digital infrastructure for insurance companies and healthcare organizations.
            ul.sector-features
              li
                i.fas.fa-check-circle
                | ELITE Medical Insurance Platform
              li
                i.fas.fa-check-circle
                | Claims &amp; policy administration
              li
                i.fas.fa-check-circle
                | Provider network &amp; approvals workflow
              li
                i.fas.fa-check-circle
                | Real-time member &amp; corporate portals
            .mt-3
              a.fw-semibold.text-primary(href="elite.html") Explore Healthcare Solutions →

        //- Trade & Distribution
        .col-lg-6(data-aos="fade-up" data-aos-delay="200")
          .sector-card
            .sector-icon(style="background:#fd7e14;")
              i.fas.fa-boxes
            h4 Trade &amp; Distribution
            p Custom Odoo workflows for inventory, purchasing, sales, and logistics — built for gold trading, pharmaceutical distribution, and wholesale operations.
            ul.sector-features
              li
                i.fas.fa-check-circle
                | Gold investment management system
              li
                i.fas.fa-check-circle
                | Pharma CRM &amp; supply chain
              li
                i.fas.fa-check-circle
                | Inventory &amp; warehouse automation
              li
                i.fas.fa-check-circle
                | Multi-branch &amp; multi-currency support
            .mt-3
              a.fw-semibold.text-primary(href="odoo-services.html") Explore Trade Solutions →

      .row.g-4.mt-2
        //- Cloud & Infrastructure
        .col-lg-4(data-aos="fade-up" data-aos-delay="300")
          .sector-card
            .sector-icon(style="background:#0E38B1;")
              i.fas.fa-cloud
            h4 Cloud &amp; Infrastructure
            p Reliable hosting, containerization, and Linux server management with 24/7 support.
            ul.sector-features
              li
                i.fas.fa-check-circle
                | Docker &amp; Kubernetes
              li
                i.fas.fa-check-circle
                | Server security hardening
              li
                i.fas.fa-check-circle
                | Migration &amp; optimization
            .mt-3
              a.fw-semibold.text-primary(href="cloud-services.html") Learn more →

        //- Odoo ERP
        .col-lg-4(data-aos="fade-up" data-aos-delay="400")
          .sector-card
            .sector-icon(style="background:#6E18EF;")
              i.fas.fa-cogs
            h4 Odoo ERP &amp; CRM
            p Full-cycle Odoo services — from module development and customization to deployment and staff training.
            ul.sector-features
              li
                i.fas.fa-check-circle
                | Custom module development
              li
                i.fas.fa-check-circle
                | Third-party integrations
              li
                i.fas.fa-check-circle
                | End-to-end implementation
            .mt-3
              a.fw-semibold.text-primary(href="odoo-dev.html") Learn more →

        //- Business Intelligence
        .col-lg-4(data-aos="fade-up" data-aos-delay="500")
          .sector-card
            .sector-icon(style="background:#ffc107;")
              i.fas.fa-chart-bar
            h4 Business Intelligence
            p Interactive dashboards, automated reporting, and data consolidation powered by Power BI and Metabase.
            ul.sector-features
              li
                i.fas.fa-check-circle
                | Real-time KPI dashboards
              li
                i.fas.fa-check-circle
                | Automated report delivery
              li
                i.fas.fa-check-circle
                | Multi-source data integration
            .mt-3
              a.fw-semibold.text-primary(href="business.html") Learn more →

  //---------- ABOUT ----------
  .about1.sp
    .container
      .row.align-items-center
        .col-lg-6
          .about-image
            .image1
              img(src="images/about1-img1.webp" alt="GoCloud team working on ERP solutions")
            .image2.image-anime
              img(src="images/about1-img2.webp" alt="GoCloud office workspace")
            .icon-box
              img(src="images/gocloud%20logo.webp" height="50" width="50" alt="GoCloud logo")
              h4 24/7 Support
              p GoCloud Technology

        .col-lg-6
          .heading1
            .span(style="color: green;" data-aos="zoom-in-left" data-aos-duration="700")
              img(src="images/gocloud%20logo.webp" height="50" width="50" alt="GoCloud logo")
              | About GoCloud
            h2.title.tg-element-title A Decade of Turning Complex Operations into Streamlined Systems
            .space16
            p(data-aos="fade-left" data-aos-duration="800") Since our founding, we've focused on two things: mastering Odoo ERP and building technology that solves real operational problems. From insurance workflows to multi-branch trade operations, our team delivers systems that companies actually use every day.

            .space16
            .about-highlight(data-aos="fade-left" data-aos-duration="900")
              h5 Official Odoo Partner
              p Certified expertise in customization, implementation, and integration
            .about-highlight(data-aos="fade-left" data-aos-duration="1000")
              h5 Insurance Technology Pioneer
              p Built ELITE — a full medical insurance management platform
            .about-highlight(data-aos="fade-left" data-aos-duration="1100")
              h5 Full-Stack Delivery
              p From cloud infrastructure to analytics dashboards — one team, end to end

            .space20
            div(data-aos="fade-left" data-aos-duration="900")
              a.theme-btn1(href="about.html") Learn More About Us
                span
                  i.fa-solid.fa-arrow-right

  //---------- ODOO PARTNERSHIP ----------
  section.py-5(style="background:#f8f9fa;")
    .container
      .row.align-items-center
        .col-lg-6(data-aos="fade-right")
          .heading1
            .span(data-aos="zoom-in-left" data-aos-duration="700")
              img(src="images/gocloud%20logo.webp" height="50" width="50" alt="GoCloud logo")
              | Odoo Partnership
            h2.title.tg-element-title Why Businesses Choose Our Odoo ERP
            .space16
            p Even startups and SMEs can monitor their entire business through a robust ERP system. As an official Odoo partner, we bring certified expertise to every project.

            .single-items(data-aos="fade-right" data-aos-duration="700")
              div
                .icon
                  img(src="images/crm.png" alt="CRM solutions")
              div
                h4 CRM to Manage Your Customer Relations
                .space10
                p Capture every lead, automate follow-ups, and build lasting customer relationships with a CRM built around your sales process.

            .single-items(data-aos="fade-right" data-aos-duration="900")
              div
                .icon
                  img(src="images/erp.png" alt="ERP systems")
              div
                h4 Industry-Specific ERP Workflows
                .space10
                p Pharma distribution, gold trading, healthcare operations — we configure Odoo modules to match your real-world processes.

            .single-items(data-aos="fade-right" data-aos-duration="1100")
              div
                .icon
                  img(src="images/business-intelligence.png" alt="Business intelligence")
              div
                h4 Built-In Business Intelligence
                .space10
                p From real-time dashboards to scheduled reports, get visibility into every corner of your operation.

        .col-lg-6
          .image-anime
            img(src="images/work-bg.png" alt="Odoo ERP workflow illustration" class="bg-image shape-animaiton4")

  //---------- LATEST ARTICLES ----------
  section.py-5(style="background:#f7f9ff")
    .container
      .text-center.mb-5(data-aos="fade-up")
        span.badge.rounded-pill.mb-3(style="background:#EEF2FF;color:#0E38B1;font-weight:600;font-size:.8rem;padding:6px 16px") أحدث المقالات — Latest Articles
        h2.fw-bold From Our Blog
        p.text-muted Insights on Medical Insurance Technology &amp; Odoo Business Solutions
      .row.g-4
        .col-md-6.col-lg-4(data-aos="fade-up")
          .card.h-100.border-0.shadow-sm.rounded-4.overflow-hidden
            img.card-img-top(src="images/blog-crm-medical-dashboard.png" alt="Odoo CRM for Medical Supplies" loading="lazy" style="height:200px;object-fit:cover")
            .card-body.p-4
              span.badge.rounded-pill.mb-2(style="background:#EEF2FF;color:#0E38B1;font-size:.72rem") تطبيقات أودو
              h5.card-title.fw-bold(style="font-size:.95rem") Odoo CRM لشركات المستلزمات الطبية — مراقبة فرق المبيعات وزيادة الإيرادات
              p.card-text.text-muted(style="font-size:.85rem") كيف يساعد Odoo CRM المخصص شركات المستلزمات الطبية في مراقبة فرق المبيعات الميدانية وتحسين التنبؤ بالمبيعات.
            .card-footer.bg-white.border-0.p-4.pt-0
              a.fw-semibold.text-decoration-none(href="blog/odoo-crm-medical-supplies.html" style="color:#0E38B1;font-size:.85rem") اقرأ المزيد &larr;
        .col-md-6.col-lg-4(data-aos="fade-up" data-aos-delay="100")
          .card.h-100.border-0.shadow-sm.rounded-4.overflow-hidden
            img.card-img-top(src="images/elite-dashboard.webp" alt="Unified Medical Insurance Portal" loading="lazy" style="height:200px;object-fit:cover")
            .card-body.p-4
              span.badge.rounded-pill.mb-2(style="background:#EEF2FF;color:#0E38B1;font-size:.72rem") التأمين الطبي
              h5.card-title.fw-bold(style="font-size:.95rem") بوابة تأمين طبي موحدة — لماذا النظام الواحد أفضل من ثلاثة أنظمة منفصلة؟
              p.card-text.text-muted(style="font-size:.85rem") أهمية وجود بوابة تأمين طبي واحدة تخدم شركة التأمين و TPA ومقدمي الخدمة الطبية.
            .card-footer.bg-white.border-0.p-4.pt-0
              a.fw-semibold.text-decoration-none(href="blog/unified-medical-insurance-portal.html" style="color:#0E38B1;font-size:.85rem") اقرأ المزيد &larr;
        .col-md-6.col-lg-4(data-aos="fade-up" data-aos-delay="200")
          .card.h-100.border-0.shadow-sm.rounded-4.overflow-hidden
            img.card-img-top(src="images/blog-branch-dashboard.png" alt="Odoo CRM for Gold Trading" loading="lazy" style="height:200px;object-fit:cover")
            .card-body.p-4
              span.badge.rounded-pill.mb-2(style="background:#EEF2FF;color:#0E38B1;font-size:.72rem") تطبيقات أودو
              h5.card-title.fw-bold(style="font-size:.95rem") كيف يُحدث Odoo CRM ثورة في إدارة شركات تجارة الذهب؟
              p.card-text.text-muted(style="font-size:.85rem") اكتشف كيف يساعد Odoo CRM شركات تجارة الذهب في ضبط سياسات البيع ومتابعة أداء الفروع لحظياً.
            .card-footer.bg-white.border-0.p-4.pt-0
              a.fw-semibold.text-decoration-none(href="blog/odoo-crm-gold-trading.html" style="color:#0E38B1;font-size:.85rem") اقرأ المزيد &larr;
      .text-center.mt-4(data-aos="fade-up")
        a.btn.btn-outline-primary.btn-lg.rounded-pill.px-4.fw-semibold(href="blog/index.html")
          | تصفح جميع المقالات
          i.fas.fa-arrow-left.ms-2

  //---------- CTA ----------
  section.py-5#CTA
    .container
      .home-cta.text-center.text-white(data-aos="fade-up")
        h2.fw-bold.mb-3 Let's Build Something That Works for Your Industry
        p.lead.mb-4.opacity-75 Schedule a free consultation — tell us about your operations and we'll show you what's possible.
        .d-flex.justify-content-center.gap-3.flex-wrap
          a.btn.btn-light.btn-lg.fw-semibold.px-4(href="https://wa.me/201017383815" target="_blank" rel="noopener noreferrer")
            i.fab.fa-whatsapp.me-2
            | Start a Conversation
          a.btn.btn-outline-light.btn-lg.fw-semibold.px-4(href="images/company profile.pdf" download)
            i.fas.fa-download.me-2
            | Company Profile

  // Include footer
  include components/footer.pug

  // Include whatsapp button
  include components/whatsapp-button.pug




