extends layout.pug

block variables
  - var pageTitle = "GoCloud — خبراء أودو والتقنية"
  - var pageDescription = "تقدم GoCloud حلول Odoo ERP المتخصصة وأنظمة التأمين الطبي والبنية التحتية السحابية للشركات في مجالات الرعاية الصحية والتجارة والتوزيع في مصر والشرق الأوسط."
  - var pageKeywords = "Odoo ERP, نظام تأمين طبي, تقنية الرعاية الصحية, نظام تجارة, تنفيذ أودو, تخصيص أودو, ذكاء الأعمال, استضافة سحابية, GoCloud Egypt"
  - var canonicalUrl = "https://www.gocloudeg.com/"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles
  style.
    .hero-badge{display:inline-flex;align-items:center;gap:8px;background:#0E38B1;border-radius:50px;padding:8px 18px;font-size:.8rem;font-weight:600;color:#fff;margin-bottom:1.5rem;box-shadow:0 4px 14px rgba(14,56,177,.3)}
    .hero-badge i{color:#A1E934;margin-right:2px}
    .hero-actions{display:flex;gap:1rem;flex-wrap:wrap}
    .hero1 .main-headding h1{font-size:2.75rem;line-height:1.2;font-weight:800;color:#0D0E10}
    .hero1 .main-headding h1 .text-accent{color:#0E38B1}
    .hero1 .main-headding .hero-sub{font-size:1.05rem;line-height:1.7;color:#4a4b5c;max-width:480px}
    .hero1 .main-headding .span{color:#0E38B1!important;font-weight:600}
    .hero-img-wrapper{position:relative;display:inline-block}
    .hero-img-wrapper img{border-radius:20px;box-shadow:0 24px 64px rgba(14,56,177,.18);transition:transform .5s ease}
    .hero-img-wrapper:hover img{transform:scale(1.03)}
    .hero-image-cta{position:absolute;left:50%;bottom:20px;transform:translateX(-50%);z-index:2}
    .hero-image-cta .hero-image-cta-btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:999px;background:linear-gradient(180deg,#4da7a2 0%,#3f8f8b 100%);color:#fff;padding:10px 24px;min-width:240px;font-size:.78rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap;box-shadow:0 10px 24px rgba(49,119,115,.42);transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}
    .hero-image-cta .hero-image-cta-btn:hover{color:#fff;transform:translateY(-1px);box-shadow:0 14px 28px rgba(49,119,115,.5);filter:brightness(1.04)}
    .hero-image-cta .hero-image-cta-btn:focus-visible{outline:3px solid rgba(161,233,52,.95);outline-offset:3px}
    @media (max-width: 767px){.hero-image-cta{bottom:12px}.hero-image-cta .hero-image-cta-btn{min-width:210px;padding:9px 18px;font-size:.7rem;letter-spacing:.04em}}
    .hero-img-wrapper::before{content:"";position:absolute;top:-12px;left:-12px;right:12px;bottom:12px;border:3px solid #0E38B1;border-radius:24px;z-index:-1;opacity:.3}
    .hero-img-wrapper::after{content:"";position:absolute;top:12px;left:12px;right:-12px;bottom:-12px;background:linear-gradient(135deg,rgba(14,56,177,.08),rgba(161,233,52,.08));border-radius:24px;z-index:-1}
    .hero-img-glow{position:absolute;width:200px;height:200px;border-radius:50%;filter:blur(80px);opacity:.4;z-index:-2}
    .hero-img-glow--blue{background:#0E38B1;top:-40px;right:-40px}
    .hero-img-glow--green{background:#A1E934;bottom:-40px;left:-40px}
    .btn-hero-outline{border:2px solid #0E38B1;color:#0E38B1;background:transparent;border-radius:50px;padding:10px 24px;font-weight:600;transition:all .3s}
    .btn-hero-outline:hover{background:#0E38B1;color:#fff}
    .stat-strip{background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,.06);padding:2rem 1rem;margin-top:-3rem;position:relative;z-index:10}
    .stat-item{text-align:center;padding:.5rem}
    .stat-item .stat-num{font-size:2rem;font-weight:800;color:#0E38B1}
    .stat-item .stat-label{font-size:.825rem;color:#676879;margin-top:2px}
    .sector-card{background:#fff;border-radius:16px;padding:2.5rem 2rem;box-shadow:0 2px 20px rgba(0,0,0,.05);border:1px solid #e9ecef;transition:all .35s ease;height:100%}
    .sector-card:hover{transform:translateY(-6px);box-shadow:0 12px 36px rgba(14,56,177,.1);border-color:#0E38B1}
    .sector-card .sector-icon{width:56px;height:56px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;margin-bottom:1.25rem}
    .sector-card h3{font-size:1.15rem;font-weight:700;margin-bottom:.75rem}
    .sector-card p{color:#676879;font-size:.925rem;line-height:1.65}
    .sector-card .sector-features{list-style:none;padding:0;margin:1rem 0 0}
    .sector-card .sector-features li{padding:4px 0;font-size:.875rem;color:#676879}
    .sector-card .sector-features li i{color:#0E38B1;margin-right:8px;font-size:.75rem}
    .about-highlight{border-left:3px solid #0E38B1;padding-left:1rem;margin-bottom:1rem}
    .about-highlight h5{font-size:1rem;font-weight:700;margin-bottom:.25rem}
    .about-highlight p{font-size:.875rem;color:#676879;margin:0}
    .home-cta{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 100%);border-radius:16px;padding:3.5rem 2rem}

block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  //---------- HERO ----------
  .hero1(style="background-image: url(images/hero1-bg.png); background-position: center; background-repeat: no-repeat; background-size: cover;")
    .container
      .row
        .col-lg-5
          .main-headding
            .hero-badge
              i.fas.fa-award
              span(data-i18n-key="home.hero_badge") شريك أودو المعتمد
            .span(style="color:blue" data-aos="zoom-in-left" data-aos-duration="700")
              img(src="images/gocloud%20logo.webp" height="40" width="40" alt="GoCloud logo")
              span(data-i18n-key="home.brand_line") GoCloud Technology
            h1.title
              span(data-i18n-key="home.hero_title_line1") خبراء Odoo ERP و
              br
              span(data-i18n-key="home.hero_title_line2") تقنيات التأمين الطبي
              br
              span.text-accent(data-i18n-key="home.hero_title_line3") مصممة حسب احتياج قطاعك
            .space16
            p.hero-sub(data-i18n-key="home.hero_sub") ننفذ ونخصص وندمج Odoo ERP لقطاعات الرعاية الصحية والتجارة والتوزيع، ونشغّل عمليات التأمين الطبي عبر منصة ELITE.

        .col-lg-7
          .hero1-all-images
            .hero-img-wrapper
              .hero-img-glow.hero-img-glow--blue
              .hero-img-glow.hero-img-glow--green
              img(src="images/odoo_partner.png" alt="GoCloud and Odoo official partnership" width="500" height="500" fetchpriority="high")
              .hero-image-cta
                a.hero-image-cta-btn(href="https://wa.me/201017383815" target="_blank" rel="noopener noreferrer")
                  span(data-i18n-key="home.hero_image_cta_button") اطلب استشارة
            .d-flex.counter-box.shape-animaiton2.counter-box-width.shadow-lg-3(style="background-color: #1a237e; border-radius: 15px; padding: 15px;")
              p.fs-3.text-white#yearsCounter
                | +
                span 10
              p.text-warning.fw-bold.w-auto
                span(data-i18n-key="home.years_of") سنوات من
                br
                span(data-i18n-key="home.experience") الخبرة
            .shape1
              img(src="images/header1-shape1.png" alt="" width="131" height="130")

  //---------- STATS STRIP ----------
  .container
    .stat-strip(data-aos="fade-up")
      .row.align-items-center
        .col-6.col-md-3
          .stat-item
            .stat-num +80K
            .stat-label(data-i18n-key="home.stats.users") مستخدم مدعوم
        .col-6.col-md-3
          .stat-item
            .stat-num +20
            .stat-label(data-i18n-key="home.stats.clients") عميل مؤسسي
        .col-6.col-md-3
          .stat-item
            .stat-num +10
            .stat-label(data-i18n-key="home.stats.solutions") حلول تم تنفيذها
        .col-6.col-md-3
          .stat-item
            .stat-num +50
            .stat-label(data-i18n-key="home.stats.projects") مشروع منجز

  .space40

  // Marquee
  include components/marquee-brands.pug

  .space40

  //---------- SECTOR-SPECIFIC SOLUTIONS ----------
  section.py-5
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold(data-i18n-key="home.solutions_title") حلول متخصصة، لا خدمات عامة
        p.lead.text-muted(data-i18n-key="home.solutions_subtitle") نحن لا نبيع برمجيات جاهزة — بل نبني حلولاً حول طريقة عمل قطاعك فعلياً.

      .row.g-4
        //- Healthcare
        .col-lg-6(data-aos="fade-up" data-aos-delay="100")
          .sector-card
            .sector-icon(style="background:#dc3545;")
              i.fas.fa-heartbeat
            h3(data-i18n-key="home.healthcare_title") الرعاية الصحية والتأمين الطبي
            p(data-i18n-key="home.healthcare_text") من إدارة شبكة مقدمي الخدمة إلى معالجة المطالبات وبوابات المشتركين — نوفر بنية رقمية متكاملة لشركات التأمين ومؤسسات الرعاية الصحية.
            ul.sector-features
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.healthcare_feature_1") منصة ELITE للتأمين الطبي
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.healthcare_feature_2") إدارة المطالبات والسياسات
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.healthcare_feature_3") شبكة مقدمي الخدمة ومسار الموافقات
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.healthcare_feature_4") بوابات الأعضاء والشركات في الوقت الفعلي
            .mt-3
              a.fw-semibold.text-primary(href="elite.html")
                span(data-i18n-key="home.healthcare_link") استكشف حلول الرعاية الصحية →

        //- Trade & Distribution
        .col-lg-6(data-aos="fade-up" data-aos-delay="200")
          .sector-card
            .sector-icon(style="background:#fd7e14;")
              i.fas.fa-boxes
            h3(data-i18n-key="home.trade_title") التجارة والتوزيع
            p(data-i18n-key="home.trade_text") مسارات عمل Odoo مخصصة للمخزون والمشتريات والمبيعات واللوجستيات — مصممة لتجارة الذهب وتوزيع الأدوية والعمليات الجملة.
            ul.sector-features
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.trade_feature_1") نظام إدارة استثمارات الذهب
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.trade_feature_2") CRM وسلسلة الإمداد للدواء
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.trade_feature_3") أتمتة المخزون والمستودعات
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.trade_feature_4") دعم الفروع المتعددة والعملات المتعددة
            .mt-3
              a.fw-semibold.text-primary(href="odoo-services.html")
                span(data-i18n-key="home.trade_link") استكشف حلول التجارة →

      .row.g-4.mt-2
        //- Cloud & Infrastructure
        .col-lg-4(data-aos="fade-up" data-aos-delay="300")
          .sector-card
            .sector-icon(style="background:#0E38B1;")
              i.fas.fa-cloud
            h3(data-i18n-key="home.cloud_title") السحابة والبنية التحتية
            p(data-i18n-key="home.cloud_text") استضافة موثوقة، وحاويات، وإدارة خوادم لينكس مع دعم على مدار الساعة.
            ul.sector-features
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.cloud_feature_1") Docker و Kubernetes
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.cloud_feature_2") تقوية أمان الخوادم
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.cloud_feature_3") الترحيل والتحسين
            .mt-3
              a.fw-semibold.text-primary(href="cloud-services.html")
                span(data-i18n-key="home.cloud_link") اعرف المزيد →

        //- Odoo ERP
        .col-lg-4(data-aos="fade-up" data-aos-delay="400")
          .sector-card
            .sector-icon(style="background:#6E18EF;")
              i.fas.fa-cogs
            h3(data-i18n-key="home.odoo_title") Odoo ERP و CRM
            p(data-i18n-key="home.odoo_text") خدمات Odoo الكاملة — من تطوير الوحدات والتخصيص إلى النشر وتدريب الموظفين.
            ul.sector-features
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.odoo_feature_1") تطوير وحدات مخصصة
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.odoo_feature_2") تكاملات مع الأطراف الخارجية
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.odoo_feature_3") تنفيذ شامل من البداية للنهاية
            .mt-3
              a.fw-semibold.text-primary(href="odoo-dev.html")
                span(data-i18n-key="home.odoo_link") اعرف المزيد →

        //- Business Intelligence
        .col-lg-4(data-aos="fade-up" data-aos-delay="500")
          .sector-card
            .sector-icon(style="background:#ffc107;")
              i.fas.fa-chart-bar
            h3(data-i18n-key="home.bi_title") ذكاء الأعمال
            p(data-i18n-key="home.bi_text") لوحات تحكم تفاعلية وتقارير مؤتمتة وتوحيد للبيانات مدعوم عبر Power BI وMetabase.
            ul.sector-features
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.bi_feature_1") لوحات KPI لحظية
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.bi_feature_2") تسليم التقارير تلقائياً
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.bi_feature_3") تكامل بيانات من مصادر متعددة
            .mt-3
              a.fw-semibold.text-primary(href="business.html")
                span(data-i18n-key="home.bi_link") اعرف المزيد →

  //---------- ABOUT ----------
  .about1.sp
    .container
      .row.align-items-center
        .col-lg-6
          .about-image
            .image1
              img(src="images/about1-img1.webp" alt="GoCloud team working on ERP solutions" width="100" height="321" loading="lazy")
            .image2.image-anime
              img(src="images/about1-img2.webp" alt="GoCloud office workspace" width="440" height="582" loading="lazy")
            .icon-box
              img(src="images/gocloud%20logo.webp" height="50" width="50" alt="GoCloud logo")
              h4 24/7 Support
              p GoCloud Technology

        .col-lg-6
          .heading1
            .span(style="color: green;" data-aos="zoom-in-left" data-aos-duration="700")
              img(src="images/gocloud%20logo.webp" height="50" width="50" alt="GoCloud logo")
              span(data-i18n-key="home.about_kicker") من نحن في GoCloud
            h2.title(data-i18n-key="home.about_title") عقد من تحويل العمليات المعقدة إلى أنظمة سلسة
            .space16
            p(data-aos="fade-left" data-aos-duration="800" data-i18n-key="home.about_text") منذ تأسيسنا ركزنا على أمرين: إتقان Odoo ERP وبناء تقنية تحل مشكلات تشغيلية حقيقية. من مسارات التأمين إلى عمليات التجارة متعددة الفروع، يقدم فريقنا أنظمة يستخدمها العملاء فعلياً كل يوم.

            .space16
            .about-highlight(data-aos="fade-left" data-aos-duration="900")
              h5(data-i18n-key="home.about_point_1_title") شريك أودو المعتمد
              p(data-i18n-key="home.about_point_1_text") خبرة معتمدة في التخصيص والتنفيذ والتكامل
            .about-highlight(data-aos="fade-left" data-aos-duration="1000")
              h5(data-i18n-key="home.about_point_2_title") رائد في تقنيات التأمين
              p(data-i18n-key="home.about_point_2_text") بنينا ELITE — منصة متكاملة لإدارة التأمين الطبي
            .about-highlight(data-aos="fade-left" data-aos-duration="1100")
              h5(data-i18n-key="home.about_point_3_title") تسليم متكامل
              p(data-i18n-key="home.about_point_3_text") من البنية السحابية إلى لوحات التحليل — فريق واحد من البداية للنهاية

            .space20
            div(data-aos="fade-left" data-aos-duration="900")
              a.theme-btn1(href="about.html")
                span(data-i18n-key="home.about_link") اعرف المزيد عنا
                span
                  i.fa-solid.fa-arrow-right

  //---------- ODOO PARTNERSHIP ----------
  section.py-5(style="background:#f8f9fa;")
    .container
      .row.align-items-center
        .col-lg-6(data-aos="fade-right")
          .heading1
            .span(data-aos="zoom-in-left" data-aos-duration="700")
              img(src="images/gocloud%20logo.webp" height="50" width="50" alt="GoCloud logo")
              span(data-i18n-key="home.partner_kicker") شراكة أودو
            h2.title(data-i18n-key="home.partner_title") لماذا تختار الشركات Odoo ERP من GoCloud؟
            .space16
            p(data-i18n-key="home.partner_text") حتى الشركات الناشئة والمتوسطة يمكنها مراقبة أعمالها بالكامل عبر نظام ERP قوي. وبصفتنا شريك أودو معتمد، نقدم خبرة موثقة لكل مشروع.

            .single-items(data-aos="fade-right" data-aos-duration="700")
              div
                .icon
                  img(src="images/crm.png" alt="CRM solutions" width="24" height="24")
              div
                h3(data-i18n-key="home.partner_item_1_title") CRM لإدارة علاقات العملاء
                .space10
                p(data-i18n-key="home.partner_item_1_text") التقط كل فرصة، وأتمت المتابعات، وابنِ علاقات دائمة عبر CRM مصمم حول دورة البيع لديك.

            .single-items(data-aos="fade-right" data-aos-duration="900")
              div
                .icon
                  img(src="images/erp.png" alt="ERP systems" width="24" height="24")
              div
                h3(data-i18n-key="home.partner_item_2_title") مسارات ERP خاصة بكل قطاع
                .space10
                p(data-i18n-key="home.partner_item_2_text") توزيع الأدوية وتجارة الذهب والرعاية الصحية — نهيئ وحدات Odoo لتناسب عملياتك الواقعية.

            .single-items(data-aos="fade-right" data-aos-duration="1100")
              div
                .icon
                  img(src="images/business-intelligence.png" alt="Business intelligence" width="24" height="24")
              div
                h3(data-i18n-key="home.partner_item_3_title") ذكاء أعمال مدمج
                .space10
                p(data-i18n-key="home.partner_item_3_text") من لوحات التحكم اللحظية إلى التقارير المجدولة، احصل على رؤية كاملة لكل جزء من نشاطك.

        .col-lg-6
          .image-anime
            img(src="images/work-bg.png" alt="Odoo ERP workflow illustration" width="536" height="494" loading="lazy" class="bg-image shape-animaiton4")

  //---------- LATEST ARTICLES ----------
  section.py-5(style="background:#f7f9ff")
    .container
      .text-center.mb-5(data-aos="fade-up")
        span.badge.rounded-pill.mb-3(style="background:#EEF2FF;color:#0E38B1;font-weight:600;font-size:.8rem;padding:6px 16px" data-i18n-key="home.blog_badge") أحدث المقالات — Latest Articles
        h2.fw-bold(data-i18n-key="home.blog_title") من مدونتنا
        p.text-muted(data-i18n-key="home.blog_subtitle") رؤى حول تقنيات التأمين الطبي وحلول أعمال Odoo
      .row.g-4
        .col-md-6.col-lg-4(data-aos="fade-up")
          .card.h-100.border-0.shadow-sm.rounded-4.overflow-hidden
            img.card-img-top(src="images/blog-crm-medical-dashboard.png" alt="Odoo CRM for Medical Supplies" loading="lazy" width="1879" height="686" style="height:200px;object-fit:cover")
            .card-body.p-4
              span.badge.rounded-pill.mb-2(style="background:#EEF2FF;color:#0E38B1;font-size:.72rem") تطبيقات أودو
              h5.card-title.fw-bold(style="font-size:.95rem" data-i18n-key="home.blog_card_1_title") Odoo CRM لشركات المستلزمات الطبية — مراقبة فرق المبيعات وزيادة الإيرادات
