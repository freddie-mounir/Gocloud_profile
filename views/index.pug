extends layout.pug

block variables
  - var pageTitle = "GoCloud — خبراء أودو والتقنية"
  - var pageDescription = "تقدم GoCloud حلول Odoo ERP المتخصصة وأنظمة التأمين الطبي والبنية التحتية السحابية للشركات في مجالات الرعاية الصحية والتجارة والتوزيع في مصر والشرق الأوسط."
  - var pageKeywords = "Odoo ERP, نظام تأمين طبي, تقنية الرعاية الصحية, نظام تجارة, تنفيذ أودو, تخصيص أودو, ذكاء الأعمال, استضافة سحابية, GoCloud Egypt"
  - var canonicalUrl = "https://www.gocloudeg.com/"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles
  style.
    .hero1{position:relative;padding:4.5rem 0 4.5rem}
    .hero1::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at top left,rgba(161,233,52,.18),transparent 26%),radial-gradient(circle at bottom right,rgba(14,56,177,.12),transparent 30%);pointer-events:none}
    .hero-copy-col{order:1}
    .hero-visual-col{order:2}
    .hero-copy-shell{position:relative;max-width:600px;padding:.5rem 0 0}
    .hero-badge{display:inline-flex;align-items:center;gap:8px;background:#0E38B1;border-radius:50px;padding:8px 18px;font-size:.8rem;font-weight:700;color:#fff;box-shadow:0 4px 14px rgba(14,56,177,.3)}
    .hero-badge i{color:#A1E934;margin-right:2px}
    .hero-copy-stack{display:flex;flex-direction:column;gap:1rem}
    .hero-actions{display:flex;gap:1rem;flex-wrap:wrap}
    .hero-title-wrap{position:relative;padding-inline-start:18px}
    .hero-title-wrap::before{content:"";position:absolute;inset-inline-start:0;top:.45rem;bottom:.45rem;width:4px;border-radius:999px;background:linear-gradient(180deg,#0E38B1 0%,#A1E934 100%)}
    .hero1 .main-headding h1{font-size:2.55rem;line-height:1.12;font-weight:800;color:#0D0E10;letter-spacing:-.02em;margin:0}
    .hero1 .main-headding h1 .text-accent{color:#0E38B1}
    .hero1 .main-headding .hero-sub{font-size:.98rem;line-height:1.85;color:#4a4b5c;max-width:560px;margin:0}
    .hero-eyebrow{font-size:.92rem;line-height:1.75;color:#445079;font-weight:600;max-width:550px;margin:0}
    .hero-proof-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:4rem;position:relative;z-index:2}
    .hero-proof-item{display:flex;align-items:flex-start;gap:12px;background:rgba(255,255,255,.94);border:1px solid rgba(14,56,177,.09);border-radius:18px;padding:16px 18px;box-shadow:0 12px 30px rgba(14,56,177,.07);backdrop-filter:blur(10px);min-height:100%}
    .hero-proof-item--wide{grid-column:auto}
    .hero-proof-item i{color:#0E38B1;font-size:1rem;margin-top:3px}
    .hero-proof-item span{font-size:.92rem;line-height:1.6;color:#1f2940;font-weight:600}
    .hero-visual-grid{display:grid;grid-template-columns:1fr;gap:14px;max-width:490px;margin-inline-start:auto}
    .hero-info-stack{display:grid;grid-template-columns:minmax(0,1fr) 156px;gap:12px;align-items:start}
    .hero-img-wrapper{position:relative;display:block}
    .hero-img-wrapper img{display:block;width:100%;height:auto;border-radius:28px;box-shadow:0 24px 64px rgba(14,56,177,.18);transition:transform .5s ease}
    .hero-img-wrapper:hover img{transform:scale(1.03)}
    .hero-image-cta{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:2;width:min(100%,320px)}
    .hero-image-cta .hero-image-cta-btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:999px;background:linear-gradient(180deg,#4da7a2 0%,#3f8f8b 100%);color:#fff;padding:10px 24px;min-width:240px;font-size:.78rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap;box-shadow:0 10px 24px rgba(49,119,115,.42);transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}
    .hero-image-cta .hero-image-cta-btn:hover{color:#fff;transform:translateY(-1px);box-shadow:0 14px 28px rgba(49,119,115,.5);filter:brightness(1.04)}
    .hero-image-cta .hero-image-cta-btn:focus-visible{outline:3px solid rgba(161,233,52,.95);outline-offset:3px}
    @media (max-width: 767px){.hero-image-cta{left:14px;right:14px;bottom:14px}.hero-image-cta .hero-image-cta-btn{width:100%;min-width:0;padding:9px 18px;font-size:.7rem;letter-spacing:.04em}}
    .hero-img-wrapper::before{content:"";position:absolute;top:-12px;left:-12px;right:12px;bottom:12px;border:3px solid #0E38B1;border-radius:24px;z-index:-1;opacity:.3}
    .hero-img-wrapper::after{content:"";position:absolute;top:12px;left:12px;right:-12px;bottom:-12px;background:linear-gradient(135deg,rgba(14,56,177,.08),rgba(161,233,52,.08));border-radius:24px;z-index:-1}
    .hero-img-glow{position:absolute;width:200px;height:200px;border-radius:50%;filter:blur(80px);opacity:.4;z-index:-2}
    .hero-img-glow--blue{background:#0E38B1;top:-40px;right:-40px}
    .hero-img-glow--green{background:#A1E934;bottom:-40px;left:-40px}
    .hero-method-card{position:relative;max-width:none;min-height:292px;background:rgba(10,24,78,.96);color:#fff;border-radius:24px;padding:.95rem 1rem .9rem;box-shadow:0 24px 60px rgba(7,23,70,.28);border:1px solid rgba(255,255,255,.08)}
    .hero-method-card .method-label{display:inline-flex;align-items:center;gap:8px;border-radius:999px;background:rgba(255,255,255,.08);padding:6px 11px;font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#A1E934;margin-bottom:.7rem;max-width:100%}
    .hero-method-card h3{font-size:.86rem;line-height:1.42;margin-bottom:.65rem;color:#fff}
    .hero-method-card ul{list-style:none;padding:0;margin:0}
    .hero-method-card li{display:flex;align-items:flex-start;gap:9px;font-size:.73rem;line-height:1.48;color:rgba(255,255,255,.84)}
    .hero-method-card li+li{margin-top:.5rem}
    .hero-method-card li i{color:#A1E934;margin-top:4px}
    .hero-years-card{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:5px;background:#fff;border:1px solid rgba(14,56,177,.1);border-radius:22px;padding:.84rem .9rem;min-height:292px;box-shadow:0 18px 34px rgba(14,56,177,.09)}
    .hero-years-card .years-value{font-size:1.55rem;line-height:1;font-weight:800;color:#0E38B1}
    .hero-years-card .years-copy{font-size:.78rem;line-height:1.38;color:#35405f;font-weight:700}
    html[dir='rtl'] .hero-method-card{text-align:right}
    html[dir='rtl'] .hero-method-card .method-label{flex-direction:row-reverse}
    html[dir='rtl'] .hero-method-card li{flex-direction:row-reverse}
    html[dir='rtl'] .hero-years-card{align-items:flex-end;text-align:right}
    html[dir='ltr'] .hero-method-card{text-align:left}
    html[dir='ltr'] .hero-method-card .method-label{flex-direction:row}
    html[dir='ltr'] .hero-method-card li{flex-direction:row}
    html[dir='ltr'] .hero-years-card{align-items:flex-start;text-align:left}
    .btn-hero-outline{border:2px solid #0E38B1;color:#0E38B1;background:transparent;border-radius:50px;padding:10px 24px;font-weight:600;transition:all .3s}
    .btn-hero-outline:hover{background:#0E38B1;color:#fff}
    .stat-strip{background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,.06);padding:2rem 1rem;margin-top:-3rem;position:relative;z-index:10}
    .stat-item{text-align:center;padding:.5rem}
    .stat-item .stat-num{font-size:2rem;font-weight:800;color:#0E38B1}
    .stat-item .stat-label{font-size:.825rem;color:#676879;margin-top:2px}
    .intro-methods{position:relative;overflow:hidden;background:linear-gradient(180deg,#f6f9ff 0%,#fff 100%)}
    .intro-methods::before{content:"";position:absolute;width:280px;height:280px;border-radius:50%;top:-140px;left:-120px;background:rgba(14,56,177,.08);filter:blur(6px)}
    .intro-methods::after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;bottom:-110px;right:-80px;background:rgba(161,233,52,.15);filter:blur(6px)}
    .intro-method-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:#EEF2FF;color:#0E38B1;font-size:.82rem;font-weight:700;margin-bottom:1rem}
    .intro-method-card{position:relative;background:rgba(255,255,255,.9);border:1px solid rgba(14,56,177,.08);border-radius:22px;padding:2rem 1.5rem;box-shadow:0 20px 40px rgba(14,56,177,.08);height:100%}
    .intro-method-card .method-number{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#0E38B1 0%,#123fe0 100%);color:#fff;font-size:1rem;font-weight:800;margin-bottom:1rem}
    .intro-method-card h3{font-size:1.1rem;font-weight:700;margin-bottom:.7rem}
    .intro-method-card p{font-size:.93rem;line-height:1.8;color:#5a6278;margin:0}
    .sector-card{background:#fff;border-radius:16px;padding:2.5rem 2rem;box-shadow:0 2px 20px rgba(0,0,0,.05);border:1px solid #e9ecef;transition:all .35s ease;height:100%}
    .sector-card:hover{transform:translateY(-6px);box-shadow:0 12px 36px rgba(14,56,177,.1);border-color:#0E38B1}
    .sector-card .sector-icon{width:56px;height:56px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;margin-bottom:1.25rem}
    .sector-card h3{font-size:1.15rem;font-weight:700;margin-bottom:.75rem}
    .sector-card p{color:#676879;font-size:.925rem;line-height:1.65}
    .sector-card .sector-features{list-style:none;padding:0;margin:1rem 0 0}
    .sector-card .sector-features li{padding:4px 0;font-size:.875rem;color:#676879}
    .sector-card .sector-features li i{color:#0E38B1;margin-right:8px;font-size:.75rem}
    .about-highlight{border-left:3px solid #0E38B1;padding-left:1rem;margin-bottom:1rem}
    .about-highlight h5{font-size:1rem;font-weight:700;margin-bottom:.25rem}
    .about-highlight p{font-size:.875rem;color:#676879;margin:0}
    .home-cta{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 100%);border-radius:16px;padding:3.5rem 2rem}
    @media (max-width: 1399px){.hero1 .main-headding h1{font-size:2.35rem}.hero-visual-grid{max-width:460px}.hero-info-stack{grid-template-columns:minmax(0,1fr) 148px}.hero-method-card,.hero-years-card{min-height:284px}}
    @media (max-width: 1199px){.hero1{padding-top:3.5rem}.hero-proof-grid{grid-template-columns:1fr 1fr;gap:18px;margin-top:3rem}.hero-visual-grid{max-width:none}.hero-info-stack{grid-template-columns:minmax(0,1fr) 148px;align-items:start}.hero-years-card{height:100%}}
    @media (max-width: 991px){.hero1{padding:3rem 0 4.5rem}.hero-copy-col,.hero-visual-col{order:initial}.hero1 .main-headding h1{font-size:2rem}.hero-copy-shell{max-width:none}.hero-proof-grid{grid-template-columns:1fr;gap:14px;margin-top:3rem}.hero-proof-item--wide{grid-column:auto}.hero-visual-grid{margin-inline-start:0}.hero-info-stack{grid-template-columns:1fr}.stat-strip{margin-top:2rem}}
    @media (max-width: 767px){.hero1{padding:1.8rem 0 3rem}.hero-copy-shell{padding-top:.85rem}.hero-copy-stack{gap:.8rem}.hero-badge{display:none}.hero-title-wrap{padding-inline-start:12px}.hero-title-wrap::before{top:.3rem;bottom:.3rem;width:3px}.hero1 .main-headding h1{font-size:1.42rem;line-height:1.16}.hero-eyebrow{font-size:.82rem;line-height:1.65}.hero1 .main-headding .hero-sub{font-size:.88rem;line-height:1.68}.hero-actions{gap:.7rem}.hero-actions a{width:100%;justify-content:center}.hero-proof-grid{margin-top:1.35rem;gap:12px}.hero-proof-item{padding:11px 13px}.hero-proof-item span{font-size:.84rem;line-height:1.5}.hero-brand-row{padding:6px 10px;border-radius:14px;box-shadow:0 8px 20px rgba(14,56,177,.06)}.hero-brand-row img{width:28px;height:28px}.hero-brand-row span{font-size:1rem}.hero-image-cta .hero-image-cta-btn{font-size:.68rem}.hero-years-card{padding:.9rem 1rem}.intro-method-card{padding:1.5rem}}

block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  //---------- HERO ----------
  .hero1(style="background-image: url(images/hero1-bg.png); background-position: center; background-repeat: no-repeat; background-size: cover;")
    .container
      .row.align-items-center.gy-5
        .col-lg-6.hero-copy-col
          .main-headding
            .hero-copy-shell
              .hero-copy-stack
                .hero-badge
                  i.fas.fa-award
                  span(data-i18n-key="home.hero_badge") حلول مؤسسية بخبرة أودو معتمدة
                p.hero-eyebrow(data-i18n-key="home.hero_eyebrow") نبني منصات تشغيل مؤسسية تربط فرقك وبياناتك وعملياتك في تجربة واحدة قابلة للتوسع.
                .hero-title-wrap
                  h1.title
                    span(data-i18n-key="home.hero_title_line1") نبني أنظمة ERP وحلول تشغيل
                    br
                    span(data-i18n-key="home.hero_title_line2") مؤسسية عالية الأداء
                    br
                    span.text-accent(data-i18n-key="home.hero_title_line3") أسرع وأكثر دقة بذكاء هندسي
                p.hero-sub(data-i18n-key="home.hero_sub") نصمم وننفذ حلول Odoo ERP وتقنيات التأمين الطبي والتطبيقات التشغيلية للقطاعات المعقدة، مع منهج تطوير مدعوم بالذكاء الاصطناعي يسرّع التسليم ويحافظ على الصرامة الهندسية.
                .hero-actions
                  a.theme-btn1(href="https://wa.me/201017383815" target="_blank" rel="noopener noreferrer")
                    span(data-i18n-key="home.hero_primary_cta") احجز استشارة استراتيجية
                    span
                      i.fa-solid.fa-arrow-right
                  a.btn-hero-outline.d-inline-flex.align-items-center.justify-content-center(href="service.html")
                    span(data-i18n-key="home.hero_secondary_cta") استكشف حلولنا

        .col-lg-6.hero-visual-col
          .hero1-all-images
            .hero-visual-grid
              .hero-img-wrapper
                .hero-img-glow.hero-img-glow--blue
                .hero-img-glow.hero-img-glow--green
                img(src="images/odoo_partner-hero.jpg" alt="GoCloud and Odoo official partnership" width="500" height="500" fetchpriority="high")
                .hero-image-cta
                  a.hero-image-cta-btn(href="https://wa.me/201017383815" target="_blank" rel="noopener noreferrer")
                    span(data-i18n-key="home.hero_image_cta_button") اطلب استشارة
              .hero-info-stack
                .hero-method-card(data-aos="fade-left")
                  .method-label
                    i.fas.fa-sparkles
                    span(data-i18n-key="home.hero_panel_badge") AI-Augmented Delivery
                  h3(data-i18n-key="home.hero_panel_title") كيف نسرّع التسليم دون التضحية بجودة البنية أو دقة التنفيذ؟
                  ul
                    li
                      i.fas.fa-check-circle
                      span(data-i18n-key="home.hero_panel_item_1") أتمتة الأعمال المتكررة مثل الهياكل الأولية والتكاملات القياسية.
                    li
                      i.fas.fa-check-circle
                      span(data-i18n-key="home.hero_panel_item_2") مراجعة أسرع للسيناريوهات الحرجة والحالات الطرفية قبل وصولها للإنتاج.
                    li
                      i.fas.fa-check-circle
                      span(data-i18n-key="home.hero_panel_item_3") تركيز أكبر من الفريق على تجربة المستخدم ومنطق العمل الخاص بقطاعك.
                .hero-years-card(data-aos="fade-left" data-aos-delay="100")
                  .years-value
                    span +10
                  .years-copy
                    span(data-i18n-key="home.years_of") سنوات من
                    br
                    span(data-i18n-key="home.experience") الخبرة

      .hero-proof-grid
        .hero-proof-item.hero-proof-item--wide(data-aos="fade-up" data-aos-delay="100")
          i.fas.fa-shield-halved
          span(data-i18n-key="home.hero_proof_1") شريك Odoo معتمد لتنفيذ وتخصيص الأنظمة الحرجة.
        .hero-proof-item(data-aos="fade-up" data-aos-delay="200")
          i.fas.fa-heart-pulse
          span(data-i18n-key="home.hero_proof_2") منصة ELITE تدير عمليات التأمين الطبي على نطاق فعلي.
        .hero-proof-item(data-aos="fade-up" data-aos-delay="300")
          i.fas.fa-brain
          span(data-i18n-key="home.hero_proof_3") بيئة تطوير مدعومة بالذكاء الاصطناعي لتقليل الوقت ورفع الجودة.

  //---------- STATS STRIP ----------
  .container
    .stat-strip(data-aos="fade-up")
      .row.align-items-center
        .col-6.col-md-3
          .stat-item
            .stat-num +80K
            .stat-label(data-i18n-key="home.stats.users") مستخدم مدعوم
        .col-6.col-md-3
          .stat-item
            .stat-num +20
            .stat-label(data-i18n-key="home.stats.clients") عميل مؤسسي
        .col-6.col-md-3
          .stat-item
            .stat-num +10
            .stat-label(data-i18n-key="home.stats.solutions") حلول تم تنفيذها
        .col-6.col-md-3
          .stat-item
            .stat-num +50
            .stat-label(data-i18n-key="home.stats.projects") مشروع منجز

  .space40

  //---------- INTRO METHOD ----------
  section.intro-methods.py-5
    .container.position-relative
      .text-center.mb-5(data-aos="fade-up")
        .intro-method-badge
          i.fas.fa-microchip
          span(data-i18n-key="home.method_badge") كيف نعمل
        h2.fw-bold(data-i18n-key="home.method_title") هندسة مؤسسية يقودها الفهم التشغيلي وتسرّعها أدوات AI المتقدمة
        p.lead.text-muted.mx-auto(style="max-width:760px" data-i18n-key="home.method_subtitle") ندمج الخبرة القطاعية مع بيئة تطوير ذكية حتى ننتقل من تحليل العمليات إلى الإطلاق الفعلي بسرعة أكبر وقرارات تصميم أدق.
      .row.g-4
        .col-lg-4(data-aos="fade-up" data-aos-delay="100")
          .intro-method-card
            .method-number 01
            h3(data-i18n-key="home.method_card_1_title") تحليل تشغيلي قبل أي كود
            p(data-i18n-key="home.method_card_1_text") نبدأ بفهم مسارات العمل والاعتمادات ونقاط الاختناق حتى يكون الحل انعكاساً لواقع التشغيل وليس مجرد قالب برمجي جاهز.
        .col-lg-4(data-aos="fade-up" data-aos-delay="200")
          .intro-method-card
            .method-number 02
            h3(data-i18n-key="home.method_card_2_title") تطوير مدعوم بالذكاء الاصطناعي
            p(data-i18n-key="home.method_card_2_text") يستخدم فريقنا وكلاء برمجيين وأتمتة موجهة لتسريع التكاملات ومراجعة السيناريوهات الحساسة وتقليل الوقت الضائع في الأعمال الروتينية.
        .col-lg-4(data-aos="fade-up" data-aos-delay="300")
          .intro-method-card
            .method-number 03
            h3(data-i18n-key="home.method_card_3_title") إطلاق واعتماد بثقة
            p(data-i18n-key="home.method_card_3_text") نربط بين التسليم والتدريب والقياس التشغيلي حتى يدخل النظام إلى العمل بسرعة ويبدأ بإظهار أثر واضح على الأداء والقرارات.

  .space20

  // Marquee
  include components/marquee-brands.pug

  .space40

  //---------- SECTOR-SPECIFIC SOLUTIONS ----------
  section.py-5
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold(data-i18n-key="home.solutions_title") حلول متخصصة، لا خدمات عامة
        p.lead.text-muted(data-i18n-key="home.solutions_subtitle") نحن لا نبيع برمجيات جاهزة — بل نبني حلولاً حول طريقة عمل قطاعك فعلياً.

      .row.g-4
        //- Healthcare
        .col-lg-6(data-aos="fade-up" data-aos-delay="100")
          .sector-card
            .sector-icon(style="background:#dc3545;")
              i.fas.fa-heartbeat
            h3(data-i18n-key="home.healthcare_title") الرعاية الصحية والتأمين الطبي
            p(data-i18n-key="home.healthcare_text") من إدارة شبكة مقدمي الخدمة إلى معالجة المطالبات وبوابات المشتركين — نوفر بنية رقمية متكاملة لشركات التأمين ومؤسسات الرعاية الصحية.
            ul.sector-features
              li
                i.fas.fa-check-circle
                span(data-i18n-key="home.healthcare_feature_1") منصة ELITE للتأمين الطبي
              li
                i.fas.fa-check-circle
