extends layout.pug

block variables
  - var pageTitle = "Portfolio & E-Commerce Solutions — GoCloud Projects & Case Studies"
  - var pageDescription = "Explore GoCloud's portfolio of successful e-commerce platforms, Odoo ERP implementations, and custom software projects delivered across the MENA region."
  - var pageKeywords = "GoCloud portfolio, e-commerce solutions, Odoo projects, case studies, web development Egypt, custom software"
  - var canonicalUrl = "https://www.gocloudeg.com/portfolio.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"

block styles

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Section
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1 Website Services
            .space16
            span.span
              img(src="images/span1.webp" alt="" loading="lazy")
              |
              a(href="service.html") Service
              span.arrow
                i.fa-regular.fa-angle-right
              |  Website Services

  // Marquee
  include components/marquee-brands.pug

  // Portfolios
  .container.my-5
    .row.align-items-center
      .col-lg-6
        h2.fw-bold.mb-4(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000") Stunning portfolio websites
        p.lead.mb-4(data-aos="fade-right" data-aos-delay="300" data-aos-duration="1000") We create stunning and professional portfolio websites that showcase your work needs. Our expert team specializes in:
        ul.list-unstyled(data-aos="fade-right" data-aos-delay="400" data-aos-duration="1000")
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            |  Amazing responsive designs
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            |  Branding solutions
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            |  SEO & Performance Optimization
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            |  Technical Support & Maintenance

      .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime(style="transition: transform 0.3s ease-in-out;" onmouseover="this.style.transform='skew(3deg, 3deg)'" onmouseout="this.style.transform='scale(1)'")
          img.img-fluid.rounded.shadow-lg(src="images/portfolio.webp" alt="Odoo Development")
          .position-absolute.top-0.start-0.w-100.h-100

  // Ecommerce
  .container.my-5
    .row.align-items-center
      .col-lg-6(data-aos="fade-left" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime(style="transition: transform 0.3s ease-in-out;" onmouseover="this.style.transform='skew(3deg, 3deg)'" onmouseout="this.style.transform='scale(1)'")
          img.img-fluid.rounded.shadow-lg(src="images/ecommerce.webp" alt="Odoo Development")
          .position-absolute.top-0.start-0.w-100.h-100
      .col-lg-6
        h2.fw-bold.mb-4.mt-4(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000") Ecommerce websites
        p.lead.mb-4(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000") We create stunning and conversion-focused ecommerce websites that help businesses thrive in the digital marketplace. Our expert team crafts engaging online stores with intuitive navigation, secure payment gateways, and mobile-optimized designs to maximize your sales potential and deliver exceptional shopping experiences to your customers.

  // Blogs
  .container.my-5
    .row.align-items-center
      .col-lg-6
        h2.fw-bold.mb-4(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000") Blogs
        p.lead.mb-4(data-aos="fade-right" data-aos-delay="300" data-aos-duration="1000") We create engaging and dynamic blog platforms and websites that drive traffic and engagement. Our expert team delivers custom content management systems, interactive features, and SEO-optimized architecture to help your content reach the right audience. From personal blogs to enterprise publishing platforms, we build scalable solutions that grow with your needs.
      .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime(style="transition: transform 0.3s ease-in-out;" onmouseover="this.style.transform='skew(3deg, 3deg)'" onmouseout="this.style.transform='scale(1)'")
          img.img-fluid.rounded.shadow-lg(src="images/blog.webp" alt="blogs")
          .position-absolute.top-0.start-0.w-100.h-100

  include components/footer.pug
  include components/whatsapp-button.pug
