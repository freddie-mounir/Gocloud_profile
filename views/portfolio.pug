extends layout.pug

block variables
  - var pageTitle = "حلول المواقع والتجارة الإلكترونية — أعمال GoCloud"
  - var pageDescription = "استكشف أعمال GoCloud الناجحة في التجارة الإلكترونية وتنفيذ Odoo ERP والمشاريع البرمجية المخصصة في المنطقة."
  - var pageKeywords = "أعمال GoCloud, حلول تجارة إلكترونية, مشاريع Odoo, دراسات حالة, تطوير مواقع مصر, برمجيات مخصصة"
  - var canonicalUrl = "https://www.gocloudeg.com/portfolio.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Section
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1(data-i18n-key="portfolio.hero_title") خدمات المواقع
            .space16
            span.span
              img(src="images/span1.webp" alt="" loading="lazy")
              |
              a(href="service.html" data-i18n-key="portfolio.breadcrumb_service") الخدمات
              span.arrow
                i.fa-regular.fa-angle-right
              |
              span(data-i18n-key="portfolio.breadcrumb_current") خدمات المواقع

  // Marquee
  include components/marquee-brands.pug

  // Portfolios
  .container.my-5
    .row.align-items-center
      .col-lg-6
        h2.fw-bold.mb-4(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000" data-i18n-key="portfolio.section1_title") مواقع أعمال احترافية
        p.lead.mb-4(data-aos="fade-right" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="portfolio.section1_text") نصمم مواقع أعمال احترافية تعكس هوية شركتك وتعرض خدماتك بشكل مميز. فريقنا المتخصص يقدّم:
        ul.list-unstyled(data-aos="fade-right" data-aos-delay="400" data-aos-duration="1000")
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="portfolio.point_1") تصاميم متجاوبة وجذابة
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="portfolio.point_2") حلول متكاملة للهوية التجارية
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="portfolio.point_3") تحسين SEO والأداء
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="portfolio.point_4") دعم فني وصيانة مستمرة

      .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime(style="transition: transform 0.3s ease-in-out;")
          img.img-fluid.rounded.shadow-lg(src="images/portfolio.webp" alt="Odoo Development")
          .position-absolute.top-0.start-0.w-100.h-100

  // Ecommerce
  .container.my-5
    .row.align-items-center
      .col-lg-6(data-aos="fade-left" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime(style="transition: transform 0.3s ease-in-out;")
          img.img-fluid.rounded.shadow-lg(src="images/ecommerce.webp" alt="Odoo Development")
          .position-absolute.top-0.start-0.w-100.h-100
      .col-lg-6
        h2.fw-bold.mb-4.mt-4(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="portfolio.section2_title") مواقع التجارة الإلكترونية
        p.lead.mb-4(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="portfolio.section2_text") ننشئ مواقع تجارة إلكترونية جذابة وموجهة للتحويل تساعد الشركات على النمو في السوق الرقمي. نبني متاجر بتجربة تنقل سهلة وبوابات دفع آمنة وتصميم متوافق مع الموبايل لتعظيم المبيعات وتقديم تجربة شراء ممتازة.

  // Blogs
  .container.my-5
    .row.align-items-center
      .col-lg-6
        h2.fw-bold.mb-4(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000" data-i18n-key="portfolio.section3_title") منصات المدونات
        p.lead.mb-4(data-aos="fade-right" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="portfolio.section3_text") نبني منصات مدونات ديناميكية وجذابة تساعد على زيادة الزيارات والتفاعل. يقدّم فريقنا أنظمة إدارة محتوى مخصصة وميزات تفاعلية وبنية محسّنة لمحركات البحث لضمان وصول المحتوى للجمهور المناسب. من المدونات الفردية إلى منصات النشر المؤسسية، نوفر حلولاً قابلة للتوسع مع نمو أعمالك.
      .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime(style="transition: transform 0.3s ease-in-out;")
          img.img-fluid.rounded.shadow-lg(src="images/blog.webp" alt="blogs")
          .position-absolute.top-0.start-0.w-100.h-100

  include components/footer.pug
  include components/whatsapp-button.pug
