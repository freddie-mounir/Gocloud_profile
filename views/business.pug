extends layout.pug

block variables
  - var pageTitle = "حلول ذكاء الأعمال | GoCloud"
  - var pageDescription = "حوّل البيانات الخام إلى رؤى قابلة للتنفيذ مع حلول GoCloud لذكاء الأعمال. تحليلات متقدمة ولوحات تفاعلية وتقارير لحظية عبر Power BI وMetabase."
  - var pageKeywords = "ذكاء الأعمال, تحليلات البيانات, Power BI, Metabase, لوحات تحكم, تقارير, مستودع بيانات, GoCloud"
  - var canonicalUrl = "https://www.gocloudeg.com/business.html"
  - var ogImage = "https://www.gocloudeg.com/images/Data-Science.webp"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles
  style.
    .bi-hero-img {
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,.15);
    }
    .bi-feature-card {
      background: #fff;
      border-radius: 12px;
      padding: 2rem 1.5rem;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0,0,0,.06);
      transition: transform .3s ease, box-shadow .3s ease;
      height: 100%;
    }
    .bi-feature-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 32px rgba(0,0,0,.12);
    }
    .bi-feature-icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
    .bi-process-step {
      position: relative;
      padding: 2rem 1.5rem;
      background: #f8f9fa;
      border-radius: 12px;
      text-align: center;
      height: 100%;
    }
    .bi-process-step .step-number {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #0d6efd;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      margin-bottom: 1rem;
    }
block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Section
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1(data-i18n-key="business.hero_title") ذكاء الأعمال
            .space16
            .span
              img(src="images/span1.webp" alt="decorative divider" loading="lazy")
              |
              a(href="service.html" data-i18n-key="business.breadcrumb_service") الخدمات
              |
              span.arrow
                i.fa-regular.fa-angle-right
              |
              span(data-i18n-key="business.breadcrumb_current") ذكاء الأعمال

  // Marquee Section
  include components/marquee-brands.pug

  .space40

  // Overview Section — Text + Image
  .container.my-5
    .row.align-items-center
      .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
        h2.fw-bold.mb-4(data-i18n-key="business.overview_title") ابدأ قراراتك المدفوعة بالبيانات من هنا
        p.lead.mb-4(data-i18n-key="business.overview_text") حوّل بياناتك الخام إلى رؤى عملية عبر حلول ذكاء أعمال شاملة. نساعد المؤسسات على اتخاذ قرارات واثقة بالاعتماد على التحليلات المتقدمة ولوحات التحكم التفاعلية والتقارير اللحظية.
        ul.list-unstyled
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="business.overview_point_1") متابعة وتنبيهات مؤشرات الأداء لحظياً
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="business.overview_point_2") لوحات تحكم مخصصة حسب احتياجات عملك
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="business.overview_point_3") إنشاء وتسليم التقارير تلقائياً
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="business.overview_point_4") دمج البيانات من مصادر متعددة
      .col-lg-6(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000")
        .position-relative.image-anime
          img.bi-hero-img.img-fluid(src="images/Data-Science.webp" alt="Business intelligence data analytics dashboard" loading="lazy")

  .space40

  // Services Feature Cards
  section.py-5(style="background: #f8f9fa;")
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold(data-i18n-key="business.offer_title") ماذا نقدم
        p.lead.text-muted(data-i18n-key="business.offer_text") خدمات ذكاء أعمال متكاملة لاستخراج القيمة الكاملة من بياناتك
      .row.g-4
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="100")
          .bi-feature-card
            .bi-feature-icon(style="background: rgba(13,110,253,.1); color: #0d6efd;")
              i.fas.fa-chart-line
            h5.fw-bold(data-i18n-key="business.feature_1_title") تحليلات متقدمة
            p.text-muted.mb-0(data-i18n-key="business.feature_1_text") اكتشف الأنماط والاتجاهات المخفية عبر التحليل الإحصائي والنمذجة التنبؤية وقدرات تعلم الآلة.
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="200")
          .bi-feature-card
            .bi-feature-icon(style="background: rgba(25,135,84,.1); color: #198754;")
              i.fas.fa-tachometer-alt
            h5.fw-bold(data-i18n-key="business.feature_2_title") لوحات تحكم تفاعلية
            p.text-muted.mb-0(data-i18n-key="business.feature_2_text") اعرض البيانات المعقدة عبر لوحات بديهية وتفاعلية تتحدث في الوقت الفعلي لاتخاذ قرار أسرع.
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="300")
          .bi-feature-card
            .bi-feature-icon(style="background: rgba(255,193,7,.1); color: #ffc107;")
              i.fas.fa-database
            h5.fw-bold(data-i18n-key="business.feature_3_title") مستودعات البيانات
            p.text-muted.mb-0(data-i18n-key="business.feature_3_text") وحّد ونظّم بياناتك من مصادر متفرقة في مستودع واحد موثوق لتقارير متسقة.
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="400")
          .bi-feature-card
            .bi-feature-icon(style="background: rgba(220,53,69,.1); color: #dc3545;")
              i.fas.fa-file-alt
            h5.fw-bold(data-i18n-key="business.feature_4_title") تقارير مؤتمتة
            p.text-muted.mb-0(data-i18n-key="business.feature_4_text") جدولة وأتمتة إنشاء التقارير لتقليل الجهد اليدوي وضمان وصول أحدث المعلومات لأصحاب القرار.
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="500")
          .bi-feature-card
            .bi-feature-icon(style="background: rgba(111,66,193,.1); color: #6f42c1;")
              i.fas.fa-plug
            h5.fw-bold(data-i18n-key="business.feature_5_title") تكامل البيانات
            p.text-muted.mb-0(data-i18n-key="business.feature_5_text") اربط بسلاسة أنظمة ERP وCRM وجداول البيانات وواجهات API الخارجية ضمن مسار تحليلي موحد.
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="600")
          .bi-feature-card
            .bi-feature-icon(style="background: rgba(13,202,240,.1); color: #0dcaf0;")
              i.fas.fa-shield-alt
            h5.fw-bold(data-i18n-key="business.feature_6_title") حوكمة البيانات
            p.text-muted.mb-0(data-i18n-key="business.feature_6_text") طبّق ضوابط الوصول وقواعد جودة البيانات ومعايير الامتثال للحفاظ على تحليلات موثوقة وآمنة.

  .space40

  // Our Process Section
  section.py-5
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold(data-i18n-key="business.approach_title") منهجيتنا
        p.lead.text-muted(data-i18n-key="business.approach_text") مسار مجرب لتحويل البيانات الخام إلى قيمة أعمال
      .row.g-4
        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="100")
          .bi-process-step
            .step-number 1
            h5.fw-bold(data-i18n-key="business.step_1_title") الاكتشاف
            p.text-muted.mb-0(data-i18n-key="business.step_1_text") نقيّم مشهد بياناتك وأهدافك التجارية والتحديات الحالية.
        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="200")
          .bi-process-step
            .step-number 2
            h5.fw-bold(data-i18n-key="business.step_2_title") التصميم
            p.text-muted.mb-0(data-i18n-key="business.step_2_text") نصمم نموذج البيانات ونختار الأدوات المناسبة ونخطط لوحات التحكم.
        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="300")
          .bi-process-step
            .step-number 3
            h5.fw-bold(data-i18n-key="business.step_3_title") التنفيذ
            p.text-muted.mb-0(data-i18n-key="business.step_3_text") نبني ونختبر ونطلق حل ذكاء الأعمال مع تدريب كامل للأطراف المعنية.
        .col-lg-3.col-md-6(data-aos="fade-up" data-aos-delay="400")
          .bi-process-step
            .step-number 4
            h5.fw-bold(data-i18n-key="business.step_4_title") التحسين
            p.text-muted.mb-0(data-i18n-key="business.step_4_text") مراقبة وتحسين ودعم مستمر لتعظيم العائد على الاستثمار.

  // Include footer
  include components/footer.pug

  // Include whatsapp button
  include components/whatsapp-button.pug
