extends layout.pug

block variables
  - var pageTitle = "Privacy Policy — GoCloud"
  - var pageDescription = "GoCloud's privacy policy explaining how we collect, use, and protect your personal data across our website and services."
  - var pageKeywords = "GoCloud privacy policy, data protection, personal data, GDPR"
  - var canonicalUrl = "https://www.gocloudeg.com/privacy.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"

block styles
  style.
    .security-commitment {
      background: linear-gradient(135deg, #0E38B1 0%, #1a237e 100%);
      padding: 80px 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .security-commitment::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at 30% 50%, rgba(161, 233, 52, 0.08) 0%, transparent 50%);
      pointer-events: none;
    }
    .security-commitment-card {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 50px 40px;
      backdrop-filter: blur(10px);
    }
    .security-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #A1E934, #7cc020);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    .security-icon i {
      font-size: 2rem;
      color: #1a237e;
    }
    .security-title {
      color: #fff;
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 20px;
      font-family: 'Tahoma', 'Arial', 'Segoe UI', sans-serif;
    }
    .security-text {
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2rem;
      line-height: 2;
      max-width: 700px;
      margin: 0 auto 30px;
      font-family: 'Tahoma', 'Arial', 'Segoe UI', sans-serif;
    }
    .security-badges {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .security-badge {
      display: inline-flex;
      align-items: center;
      background: rgba(161, 233, 52, 0.15);
      border: 1px solid rgba(161, 233, 52, 0.3);
      border-radius: 50px;
      padding: 8px 20px;
      color: #A1E934;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: 'Tahoma', 'Arial', 'Segoe UI', sans-serif;
    }
    @media (max-width: 767px) {
      .security-commitment { padding: 50px 0; }
      .security-commitment-card { padding: 30px 20px; }
      .security-title { font-size: 1.5rem; }
      .security-text { font-size: 1rem; }
    }

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Area
  .hero-privacy
    .container
      h1.title Privacy Policy
      p Last Updated: October 2025

  // Privacy Content
  .privacy-section
    .container
      .row
        .col-lg-10.m-auto.privacy-content
          p At GoCloud, we are committed to protecting your privacy and ensuring the security of your personal information. This Privacy Policy outlines how we collect, use, disclose, and safeguard your data when you visit our website or use our services.

          h3 1. Information We Collect
          p We may collect personal identification information from Users in a variety of ways, including, but not limited to, when Users visit our site, register on the site, place an order, fill out a form, and in connection with other activities, services, features, or resources we make available on our Site.
          ul
            li
              strong Personal Identification Information:
              |  Name, email address, phone number, company name, and job title.
            li
              strong Technical Data:
              |  IP address, browser type, operating system, and access times.
            li
              strong Usage Data:
              |  Information about how you use our website and services.

          h3 2. How We Use Your Information
          p GoCloud collects and uses Users personal information for the following purposes:
          ul
            li To improve customer service: Information you provide helps us respond to your customer service requests and support needs more efficiently.
            li To personalize user experience: We may use information in the aggregate to understand how our Users as a group use the services and resources provided on our Site.
            li To improve our Site: We may use feedback you provide to improve our products and services.
            li To send periodic emails: We may use the email address to send User information and updates pertaining to their order.

          h3 3. Web Browser Cookies
          p Our Site may use "cookies" to enhance User experience. User's web browser places cookies on their hard drive for record-keeping purposes and sometimes to track information about them. User may choose to set their web browser to refuse cookies, or to alert you when cookies are being sent.

          h3 4. Sharing Your Personal Information
          p We do not sell, trade, or rent Users personal identification information to others. We may share generic aggregated demographic information not linked to any personal identification information regarding visitors and users with our business partners, trusted affiliates, and advertisers.

          h3 5. Security of Your Data
          p We adopt appropriate data collection, storage, and processing practices and security measures to protect against unauthorized access, alteration, disclosure, or destruction of your personal information, username, password, transaction information, and data stored on our Site.

          h3 6. Contact Us
          p If you have any questions about this Privacy Policy, please contact us at:
          p
            strong GoCloud
            br
            | Email:
            a(href="mailto:marketing@gocloudeg.com") marketing@gocloudeg.com
            br
            | Phone: +201017383815

  // Security Commitment Section (Arabic)
  section.security-commitment(dir="rtl" lang="ar" aria-label="صفحة الأمان")
    .container
      .row.justify-content-center
        .col-lg-10
          .security-commitment-card
            .security-icon(aria-hidden="true")
              i.fa-solid.fa-shield-halved
            h2.security-title صفحة الأمان
            p.security-text نحن نلتزم بأعلى معايير حماية البيانات والخصوصية، ويتم تشفير كافة البيانات والعمليات المالية والغير مالية وفقاً للمعايير الدولية.
            .security-badges
              span.security-badge
                i.fa-solid.fa-lock.me-2
                | تشفير البيانات
              span.security-badge
                i.fa-solid.fa-user-shield.me-2
                | حماية الخصوصية
              span.security-badge
                i.fa-solid.fa-globe.me-2
                | معايير دولية

  include components/footer.pug
  include components/whatsapp-button.pug
