extends layout.pug

block variables
  - var pageTitle = "Privacy Policy — GoCloud"
  - var pageDescription = "GoCloud's privacy policy explaining how we collect, use, and protect your personal data across our website and services."
  - var pageKeywords = "GoCloud privacy policy, data protection, personal data, GDPR"
  - var canonicalUrl = "https://www.gocloudeg.com/privacy.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"

block styles
  style.
    /* ── Hero ── */
    .privacy-hero{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 60%,#0E38B1 100%);padding:6rem 0 4rem;position:relative;overflow:hidden}
    .privacy-hero::after{content:"";position:absolute;bottom:-2px;left:0;right:0;height:80px;background:#fff;clip-path:polygon(0 60%,100% 0,100% 100%,0 100%)}
    .privacy-hero h1{font-size:2.75rem;font-weight:800;color:#fff}
    .privacy-hero p{color:rgba(255,255,255,.8);max-width:540px}
    .privacy-hero .breadcrumb-link{color:rgba(255,255,255,.6);text-decoration:none;font-size:.9rem}
    .privacy-hero .breadcrumb-link:hover{color:#fff}
    .privacy-hero .breadcrumb-sep{color:rgba(255,255,255,.35);margin:0 8px}
    .privacy-hero .breadcrumb-current{color:#A1E934;font-weight:600;font-size:.9rem}

    /* ── Section helpers ── */
    .section-tag{display:inline-flex;align-items:center;gap:8px;background:#EEF2FF;border-radius:50px;padding:6px 16px;font-size:.8rem;font-weight:600;color:#0E38B1;margin-bottom:1rem}
    .section-tag img{height:24px;width:24px}
    .section-heading{font-size:2rem;font-weight:800;color:#0D0E10;margin-bottom:1rem}
    .section-lead{color:#4a4b5c;font-size:1.05rem;line-height:1.7;max-width:620px}

    /* ── Privacy content ── */
    .privacy-section{padding:5rem 0}
    .privacy-content h3{font-size:1.25rem;font-weight:700;color:#0D0E10;margin-top:2.5rem;margin-bottom:.75rem;padding-left:14px;border-left:3px solid #0E38B1}
    .privacy-content p{color:#4a4b5c;font-size:.95rem;line-height:1.75}
    .privacy-content ul{color:#4a4b5c;font-size:.95rem;line-height:1.75;padding-left:1.25rem}
    .privacy-content ul li{margin-bottom:.5rem}
    .privacy-content .intro-text{font-size:1.05rem;line-height:1.8;color:#4a4b5c;margin-bottom:2rem}

    /* ── Highlight cards ── */
    .privacy-highlight{background:#f7f9ff;border:1px solid #e9ecef;border-radius:16px;padding:2rem;margin:2rem 0;box-shadow:0 2px 16px rgba(0,0,0,.04)}
    .privacy-highlight h4{font-size:1.1rem;font-weight:700;color:#0E38B1;margin-bottom:1rem}
    .privacy-highlight ul{margin-bottom:0}

    /* ── Contact box ── */
    .contact-info-box{background:#fff;border:1px solid #e9ecef;border-left:4px solid #0E38B1;border-radius:12px;padding:1.5rem 2rem;box-shadow:0 2px 16px rgba(0,0,0,.04)}
    .contact-info-box a{color:#0E38B1;text-decoration:none;transition:color .3s}
    .contact-info-box a:hover{color:#113ADC}
    @media(max-width:767px){.privacy-hero h1{font-size:2rem}}

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  //---------- HERO ----------
  .privacy-hero
    .container
      .row.align-items-center
        .col-lg-7
          .mb-3
            a.breadcrumb-link(href="index.html") Home
            span.breadcrumb-sep /
            span.breadcrumb-current Privacy Policy
          h1 Privacy Policy
          .space16
          p Learn how GoCloud collects, uses, and protects your personal information across our website and services.
          .mt-3
            span.badge.rounded-pill.bg-light.text-dark.px-3.py-2
              i.fa-solid.fa-calendar-alt.me-2
              | Last Updated: April 2026

  //---------- PRIVACY CONTENT ----------
  section.privacy-section
    .container
      .row.text-center.mb-5
        .col-lg-8.mx-auto
          .section-tag
            img(src="images/gocloud%20logo.webp" alt="" loading="lazy")
            | Data Privacy
          h2.section-heading Your Privacy Matters to Us
          p.text-muted We are committed to transparency in how we handle your data.

      .row
        .col-lg-10.m-auto.privacy-content
          p.intro-text At GoCloud, we are committed to protecting your privacy and safeguarding your personal information. This Privacy Policy describes how we collect, use, and protect your data when you visit our website or engage with our services — including Odoo ERP consultations, cloud solutions, and the ELITE medical-insurance platform.

          h3 1. Information We Collect
          p We may collect the following types of information when you interact with our website — for example, by submitting a contact form, requesting a consultation, or browsing our pages:
          ul
            li
              strong Contact Information:
              |  Name, email address, phone number, company name, and job title.
            li
              strong Technical Data:
              |  IP address, browser type, operating system, referring URLs, and access timestamps.
            li
              strong Usage Data:
              |  Pages visited, time spent on pages, and navigation paths across our website.

          h3 2. How We Use Your Information
          p We use the information we collect for the following purposes:
          ul
            li
              strong Service Delivery:
              |  To respond to your inquiries, provide consultations, and deliver the services you request.
            li
              strong Website Improvement:
              |  To analyze usage patterns and improve our website's content, performance, and user experience.
            li
              strong Communication:
              |  To send relevant updates about our services, only when you have opted in to receive such communications.

          h3 3. Cookies &amp; Tracking Technologies
          p Our website uses cookies and similar technologies to enhance your browsing experience and gather analytics data. You can manage your cookie preferences through your browser settings. We use:
          ul
            li
              strong Essential Cookies:
              |  Required for core website functionality.
            li
              strong Analytics Cookies:
              |  Help us understand how visitors interact with our website (e.g., Google Analytics).

          h3 4. Data Sharing &amp; Third Parties
          p We do not sell, trade, or rent your personal information. We may share anonymized, aggregated data with trusted partners for analytics purposes. Any third-party service providers we work with are contractually obligated to protect your data and use it only for the purposes we specify.

          h3 5. Data Security
          p We implement industry-standard security measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. This includes encryption of data in transit, secure server infrastructure, and regular security assessments.

          .privacy-highlight
            h4
              i.fa-solid.fa-shield-halved.me-2
              | Our Security Commitments
            ul
              li SSL/TLS encryption for all data transmitted through our website.
              li Secure server infrastructure hosted in compliance with international standards.
              li Regular security audits and vulnerability assessments.
              li Access control policies limiting data access to authorized personnel only.

          h3 6. Your Rights
          p You have the right to:
          ul
            li Request access to the personal data we hold about you.
            li Request correction or deletion of your personal data.
            li Opt out of marketing communications at any time.
            li Lodge a complaint with a relevant data protection authority.

          h3 7. Data Retention
          p We retain your personal data only for as long as necessary to fulfill the purposes outlined in this policy or as required by law. When data is no longer needed, it is securely deleted or anonymized.

          h3 8. Third-Party Links
          p Our website may contain links to third-party websites or services that are not operated by GoCloud. We have no control over, and assume no responsibility for, the content, privacy policies, or practices of any third-party sites. We encourage you to review the privacy policy of every site you visit.

          h3 9. Changes to This Policy
          p We may update this Privacy Policy from time to time. Any changes will be posted on this page with an updated revision date. We encourage you to review this policy periodically to stay informed about how we protect your data.

          h3 10. Contact Us
          p If you have any questions or concerns about this Privacy Policy or how we handle your data, please contact us:
          .contact-info-box.mt-3
            p.mb-2
              strong
                i.fa-solid.fa-building.me-2
                | GoCloud
            p.mb-2
              i.fa-solid.fa-envelope.me-2
              a(href="mailto:marketing@gocloudeg.com") marketing@gocloudeg.com
            p.mb-0
              i.fa-solid.fa-phone.me-2
              a(href="tel:+201017383815") +20 101 738 3815

  include components/footer.pug
  include components/whatsapp-button.pug
