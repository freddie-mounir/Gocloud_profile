extends layout.pug

block variables
  - var pageTitle = "سياسة الخصوصية — GoCloud"
  - var pageDescription = "توضح سياسة الخصوصية في GoCloud كيفية جمع بياناتك الشخصية واستخدامها وحمايتها عبر الموقع والخدمات."
  - var pageKeywords = "سياسة خصوصية GoCloud, حماية البيانات, البيانات الشخصية"
  - var canonicalUrl = "https://www.gocloudeg.com/privacy.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles
  style.
    /* ── Hero ── */
    .privacy-hero{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 60%,#0E38B1 100%);padding:6rem 0 4rem;position:relative;overflow:hidden}
    .privacy-hero::after{content:"";position:absolute;bottom:-2px;left:0;right:0;height:80px;background:#fff;clip-path:polygon(0 60%,100% 0,100% 100%,0 100%)}
    .privacy-hero h1{font-size:2.75rem;font-weight:800;color:#fff}
    .privacy-hero p{color:rgba(255,255,255,.8);max-width:540px}
    .privacy-hero .breadcrumb-link{color:rgba(255,255,255,.6);text-decoration:none;font-size:.9rem}
    .privacy-hero .breadcrumb-link:hover{color:#fff}
    .privacy-hero .breadcrumb-sep{color:rgba(255,255,255,.35);margin:0 8px}
    .privacy-hero .breadcrumb-current{color:#A1E934;font-weight:600;font-size:.9rem}

    /* ── Section helpers ── */
    .section-tag{display:inline-flex;align-items:center;gap:8px;background:#EEF2FF;border-radius:50px;padding:6px 16px;font-size:.8rem;font-weight:600;color:#0E38B1;margin-bottom:1rem}
    .section-tag img{height:24px;width:24px}
    .section-heading{font-size:2rem;font-weight:800;color:#0D0E10;margin-bottom:1rem}
    .section-lead{color:#4a4b5c;font-size:1.05rem;line-height:1.7;max-width:620px}

    /* ── Privacy content ── */
    .privacy-section{padding:5rem 0}
    .privacy-content h3{font-size:1.25rem;font-weight:700;color:#0D0E10;margin-top:2.5rem;margin-bottom:.75rem;padding-left:14px;border-left:3px solid #0E38B1}
    .privacy-content p{color:#4a4b5c;font-size:.95rem;line-height:1.75}
    .privacy-content ul{color:#4a4b5c;font-size:.95rem;line-height:1.75;padding-left:1.25rem}
    .privacy-content ul li{margin-bottom:.5rem}
    .privacy-content .intro-text{font-size:1.05rem;line-height:1.8;color:#4a4b5c;margin-bottom:2rem}

    /* ── Highlight cards ── */
    .privacy-highlight{background:#f7f9ff;border:1px solid #e9ecef;border-radius:16px;padding:2rem;margin:2rem 0;box-shadow:0 2px 16px rgba(0,0,0,.04)}
    .privacy-highlight h4{font-size:1.1rem;font-weight:700;color:#0E38B1;margin-bottom:1rem}
    .privacy-highlight ul{margin-bottom:0}

    /* ── Contact box ── */
    .contact-info-box{background:#fff;border:1px solid #e9ecef;border-left:4px solid #0E38B1;border-radius:12px;padding:1.5rem 2rem;box-shadow:0 2px 16px rgba(0,0,0,.04)}
    .contact-info-box a{color:#0E38B1;text-decoration:none;transition:color .3s}
    .contact-info-box a:hover{color:#113ADC}
    @media(max-width:767px){.privacy-hero h1{font-size:2rem}}

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  //---------- HERO ----------
  .privacy-hero
    .container
      .row.align-items-center
        .col-lg-7
          .mb-3
            a.breadcrumb-link(href="index.html" data-i18n-key="privacy.breadcrumb_home") الرئيسية
            span.breadcrumb-sep /
            span.breadcrumb-current(data-i18n-key="privacy.breadcrumb_current") سياسة الخصوصية
          h1(data-i18n-key="privacy.hero_title") سياسة الخصوصية
          .space16
          p(data-i18n-key="privacy.hero_text") تعرّف على كيفية جمع GoCloud لمعلوماتك الشخصية واستخدامها وحمايتها عبر موقعنا وخدماتنا.
          .mt-3
            span.badge.rounded-pill.bg-light.text-dark.px-3.py-2
              i.fa-solid.fa-calendar-alt.me-2
              span(data-i18n-key="privacy.last_updated") آخر تحديث: أبريل 2026

  //---------- PRIVACY CONTENT ----------
  section.privacy-section
    .container
      .row.text-center.mb-5
        .col-lg-8.mx-auto
          .section-tag
            img(src="images/gocloud%20logo.webp" alt="" loading="lazy")
            span(data-i18n-key="privacy.tag") خصوصية البيانات
          h2.section-heading(data-i18n-key="privacy.section_title") خصوصيتك تهمنا
          p.text-muted(data-i18n-key="privacy.section_intro") نلتزم بالشفافية الكاملة في كيفية التعامل مع بياناتك.

      .row
        .col-lg-10.m-auto.privacy-content
          p.intro-text(data-i18n-key="privacy.intro") في GoCloud نحن ملتزمون بحماية خصوصيتك والحفاظ على معلوماتك الشخصية. توضح هذه السياسة كيفية جمع بياناتك واستخدامها وحمايتها عند زيارة موقعنا أو الاستفادة من خدماتنا، بما يشمل استشارات Odoo ERP والحلول السحابية ومنصة ELITE للتأمين الطبي.

          h3(data-i18n-key="privacy.s1_title") 1. المعلومات التي نجمعها
          p(data-i18n-key="privacy.s1_intro") قد نجمع الأنواع التالية من المعلومات عند تفاعلك مع موقعنا، مثل إرسال نموذج تواصل أو طلب استشارة أو تصفح الصفحات:
          ul
            li
              strong(data-i18n-key="privacy.s1_li1_label") معلومات التواصل:
              span(data-i18n-key="privacy.s1_li1_text")  الاسم والبريد الإلكتروني ورقم الهاتف واسم الشركة والمسمى الوظيفي.
            li
              strong(data-i18n-key="privacy.s1_li2_label") بيانات تقنية:
              span(data-i18n-key="privacy.s1_li2_text")  عنوان IP ونوع المتصفح ونظام التشغيل وروابط الإحالة وتوقيتات الوصول.
            li
              strong(data-i18n-key="privacy.s1_li3_label") بيانات الاستخدام:
              span(data-i18n-key="privacy.s1_li3_text")  الصفحات التي تمت زيارتها والوقت المقضي ومسارات التنقل داخل الموقع.

          h3(data-i18n-key="privacy.s2_title") 2. كيفية استخدام معلوماتك
          p(data-i18n-key="privacy.s2_intro") نستخدم المعلومات التي نجمعها للأغراض التالية:
          ul
            li
              strong(data-i18n-key="privacy.s2_li1_label") تقديم الخدمة:
              span(data-i18n-key="privacy.s2_li1_text")  للرد على استفساراتك وتقديم الاستشارات وتنفيذ الخدمات التي تطلبها.
            li
              strong(data-i18n-key="privacy.s2_li2_label") تحسين الموقع:
              span(data-i18n-key="privacy.s2_li2_text")  لتحليل أنماط الاستخدام وتحسين المحتوى والأداء وتجربة المستخدم.
            li
              strong(data-i18n-key="privacy.s2_li3_label") التواصل:
              span(data-i18n-key="privacy.s2_li3_text")  لإرسال تحديثات متعلقة بخدماتنا فقط عند موافقتك المسبقة على ذلك.

          h3(data-i18n-key="privacy.s3_title") 3. ملفات تعريف الارتباط وتقنيات التتبع
          p(data-i18n-key="privacy.s3_intro") يستخدم موقعنا ملفات تعريف الارتباط وتقنيات مشابهة لتحسين تجربة التصفح وجمع بيانات التحليل. يمكنك إدارة تفضيلات الكوكيز من إعدادات المتصفح. نحن نستخدم:
          ul
            li
              strong(data-i18n-key="privacy.s3_li1_label") ملفات أساسية:
              span(data-i18n-key="privacy.s3_li1_text")  ضرورية لوظائف الموقع الأساسية.
            li
              strong(data-i18n-key="privacy.s3_li2_label") ملفات تحليلية:
              span(data-i18n-key="privacy.s3_li2_text")  تساعدنا على فهم تفاعل الزوار مع الموقع (مثل Google Analytics).

          h3(data-i18n-key="privacy.s4_title") 4. مشاركة البيانات والأطراف الثالثة
          p(data-i18n-key="privacy.s4_text") نحن لا نبيع أو نؤجر أو نتاجر بمعلوماتك الشخصية. قد نشارك بيانات مجمعة ومجهولة الهوية مع شركاء موثوقين لأغراض تحليلية. ويكون مزودو الخدمات من الأطراف الثالثة ملزمين تعاقدياً بحماية بياناتك واستخدامها فقط للأغراض المحددة من قبلنا.

          h3(data-i18n-key="privacy.s5_title") 5. أمن البيانات
          p(data-i18n-key="privacy.s5_text") نطبق إجراءات أمنية وفق معايير الصناعة لحماية معلوماتك الشخصية من الوصول غير المصرح به أو التعديل أو الإفصاح أو الإتلاف. ويشمل ذلك تشفير البيانات أثناء النقل وبنية خوادم آمنة وتقييمات أمنية دورية.

          .privacy-highlight
            h4
              i.fa-solid.fa-shield-halved.me-2
              span(data-i18n-key="privacy.highlight_title") التزاماتنا الأمنية
            ul
              li(data-i18n-key="privacy.highlight_li1") تشفير SSL/TLS لجميع البيانات المرسلة عبر موقعنا.
              li(data-i18n-key="privacy.highlight_li2") بنية خوادم آمنة مستضافة وفق المعايير الدولية.
              li(data-i18n-key="privacy.highlight_li3") تدقيقات أمنية دورية وتقييمات للثغرات.
              li(data-i18n-key="privacy.highlight_li4") سياسات تحكم بالوصول تقيّد الاطلاع على البيانات للمخولين فقط.

          h3(data-i18n-key="privacy.s6_title") 6. حقوقك
          p(data-i18n-key="privacy.s6_intro") يحق لك:
          ul
            li(data-i18n-key="privacy.s6_li1") طلب الوصول إلى البيانات الشخصية التي نحتفظ بها عنك.
            li(data-i18n-key="privacy.s6_li2") طلب تصحيح أو حذف بياناتك الشخصية.
            li(data-i18n-key="privacy.s6_li3") إلغاء الاشتراك في الرسائل التسويقية في أي وقت.
            li(data-i18n-key="privacy.s6_li4") تقديم شكوى لدى الجهة المختصة بحماية البيانات.

          h3(data-i18n-key="privacy.s7_title") 7. الاحتفاظ بالبيانات
          p(data-i18n-key="privacy.s7_text") نحتفظ ببياناتك الشخصية فقط للمدة اللازمة لتحقيق الأغراض الموضحة في هذه السياسة أو وفق ما يتطلبه القانون. وعند عدم الحاجة إليها، يتم حذفها أو إخفاء هويتها بشكل آمن.

          h3(data-i18n-key="privacy.s8_title") 8. روابط الأطراف الثالثة
          p(data-i18n-key="privacy.s8_text") قد يحتوي موقعنا على روابط لمواقع أو خدمات خارجية لا تديرها GoCloud. نحن لا نتحكم في محتوى أو سياسات الخصوصية أو ممارسات تلك الجهات ولا نتحمل المسؤولية عنها. ننصحك بمراجعة سياسة الخصوصية لكل موقع تزوره.

          h3(data-i18n-key="privacy.s9_title") 9. التعديلات على هذه السياسة
          p(data-i18n-key="privacy.s9_text") قد نقوم بتحديث سياسة الخصوصية من وقت لآخر. وسيتم نشر أي تغييرات في هذه الصفحة مع تاريخ تحديث جديد. ننصحك بمراجعة هذه السياسة بشكل دوري لمعرفة كيفية حماية بياناتك.

          h3(data-i18n-key="privacy.s10_title") 10. تواصل معنا
          p(data-i18n-key="privacy.s10_text") إذا كانت لديك أي أسئلة أو ملاحظات بخصوص سياسة الخصوصية أو طريقة تعاملنا مع بياناتك، يرجى التواصل معنا:
          .contact-info-box.mt-3
            p.mb-2
              strong
                i.fa-solid.fa-building.me-2
                | GoCloud
            p.mb-2
              i.fa-solid.fa-envelope.me-2
              a(href="mailto:marketing@gocloudeg.com") marketing@gocloudeg.com
            p.mb-0
              i.fa-solid.fa-phone.me-2
              a(href="tel:+201017383815") +20 101 738 3815

  include components/footer.pug
  include components/whatsapp-button.pug
