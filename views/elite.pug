//- ELITE Medical Insurance System - Dedicated Landing Page
//- Premium landing page for ELITE product

extends layout

block variables
  - var pageTitle = "ELITE - نظام إدارة التأمين الطبي | GoCloud"
  - var pageDescription = "نظام ELITE المتكامل لإدارة التأمين الطبي مع ربط تلقائي بـ Odoo ERP - الحل الوحيد في مصر"
  - var pageKeywords = "ELITE, التأمين الطبي, نظام TPA, Odoo, Healthcare, Medical Insurance"
  - var canonicalUrl = "https://www.gocloudeg.com/elite.html"
  - var ogImage = "https://www.gocloudeg.com/images/elite-dashboard.webp"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  //- ===== ELITE Hero Section =====
  section.elite-hero
    .container
      .row.align-items-center
        .col-lg-6
          //- Trust Badges
          .trust-badges.mb-4
            .badge.badge-primary.me-2
              i.fas.fa-award.me-2
              span(data-i18n-key="elite.badge_partner") شريك Odoo الرسمي
            .badge.badge-success
              i.fas.fa-check-circle.me-2
              span(data-i18n-key="elite.badge_iso") معتمد ISO

          //- Main Headline
          h1.elite-title.mb-4(dir="rtl" style="text-align: right;" data-i18n-key="elite.hero_title") نظام ELITE لإدارة التأمين الطبي

          .elite-subtitle.mb-4(dir="rtl" style="text-align: right;")
            span(data-i18n-key="elite.hero_subtitle_line1") الحل الوحيد في مصر الذي يربط نظام التأمين الطبي
            br
            span(data-i18n-key="elite.hero_subtitle_line2") بـ Odoo ERP تلقائياً - دورة مالية 100% بدون أخطاء

          //- Key Benefits
          .key-benefits.mb-4(dir="rtl")
            .benefit-item(style="flex-direction: row-reverse;")
              span(style="margin-left: 15px;" data-i18n-key="elite.benefit_1") معالجة فورية للمطالبات (24 ساعة بدلاً من 5 أيام)
              i.fas.fa-bolt.text-warning

            .benefit-item(style="flex-direction: row-reverse;")
              span(style="margin-left: 15px;" data-i18n-key="elite.benefit_2") كشف الاحتيال بالذكاء الاصطناعي
              i.fas.fa-shield-alt.text-success

            .benefit-item(style="flex-direction: row-reverse;")
              span(style="margin-left: 15px;" data-i18n-key="elite.benefit_3") ربط تلقائي مع Odoo ERP
              i.fas.fa-sync.text-primary

          //- CTA Buttons
          .cta-buttons(dir="rtl" style="text-align: right;")
            a.btn.btn-outline-primary.btn-lg(href="contact.html")
              i.fas.fa-calendar-check.ms-2
              span(data-i18n-key="elite.cta_demo") احجز عرضاً تجريبياً مجانياً

            a.btn.btn-primary.btn-lg.ms-3(
              href="https://www.youtube.com/watch?v=Z1u1bJNl_m4"
              target="_blank"
              rel="noopener noreferrer"
            )
              i.fas.fa-play-circle.ms-2
              span(data-i18n-key="elite.cta_video") شاهد الفيديو (2 دقيقة)

        .col-lg-6
          .elite-dashboard-preview
            img.img-fluid.rounded.shadow-lg(
              src="images/elite-dashboard.webp"
              alt="ELITE Dashboard"
            )

            //- Floating Stats
            .floating-stat.stat-1(dir="rtl")
              .stat-number 10,000+
              .stat-label(data-i18n-key="elite.stat_1") مطالبة شهرياً

            .floating-stat.stat-2(dir="rtl")
              .stat-number 100%
              .stat-label(data-i18n-key="elite.stat_2") دقة المعالجة

            .floating-stat.stat-3(dir="rtl")
              .stat-number 24h
              .stat-label(data-i18n-key="elite.stat_3") وقت الاستجابة

  //- ===== Problem Statement =====
  section.problem-section.py-5.bg-light
    .container
      .section-header.text-center.mb-5(dir="rtl")
        h2(data-i18n-key="elite.problems_title") المشاكل التي نحلها
        p.lead(data-i18n-key="elite.problems_text") تحديات شركات TPA والتأمين الطبي في مصر

      .row.g-4
        .col-md-4
          .problem-card(dir="rtl")
            .problem-icon.bg-danger
              i.fas.fa-clock
            h4(data-i18n-key="elite.problem_1_title") التأخير في المعالجة
            p(data-i18n-key="elite.problem_1_text") معالجة المطالبات تأخذ 3-7 أيام مما يسبب استياء المؤمن عليهم

        .col-md-4
          .problem-card(dir="rtl")
            .problem-icon.bg-warning
              i.fas.fa-exclamation-triangle
            h4(data-i18n-key="elite.problem_2_title") أخطاء الإدخال اليدوي
            p(data-i18n-key="elite.problem_2_text") إدخال يدوي للبيانات يؤدي لأخطاء محاسبية وتأخير المدفوعات

        .col-md-4
          .problem-card(dir="rtl")
            .problem-icon.bg-info
              i.fas.fa-user-secret
            h4(data-i18n-key="elite.problem_3_title") الاحتيال الطبي
            p(data-i18n-key="elite.problem_3_text") صعوبة كشف المطالبات المزورة أو المبالغ فيها

  //- ===== Solution: ELITE Features =====
  section.solution-section.py-5
    .container
      .section-header.text-center.mb-5(dir="rtl")
        h2(data-i18n-key="elite.solution_title") كيف يحل ELITE هذه المشاكل
        p.lead(data-i18n-key="elite.solution_text") حل شامل ومتكامل لإدارة التأمين الطبي

      .row.g-4
        //- Feature 1: Fast Processing
        .col-lg-6
          .feature-box(dir="rtl")
            .row
              .col-md-8
                h3(data-i18n-key="elite.feature_1_title") معالجة فورية
                p.mb-3(data-i18n-key="elite.feature_1_text") تقليل وقت معالجة المطالبات من 5 أيام إلى 24 ساعة
                ul.feature-list(style="text-align: right;")
                  li(data-i18n-key="elite.feature_1_point_1") موافقة/رفض تلقائي حسب الشروط
                  li(data-i18n-key="elite.feature_1_point_2") إشعارات فورية للمؤمن عليهم
                  li(data-i18n-key="elite.feature_1_point_3") تتبع حالة المطالبة لحظياً
              .col-md-4
                .feature-icon.bg-gradient-primary
                  i.fas.fa-rocket

        //- Feature 2: Odoo Integration
        .col-lg-6
          .feature-box(dir="rtl")
            .row
              .col-md-8
                h3(data-i18n-key="elite.feature_2_title") ربط تلقائي مع Odoo
                p.mb-3(data-i18n-key="elite.feature_2_text") كل مطالبة تتحول لقيد محاسبي تلقائياً
                ul.feature-list(style="text-align: right;")
                  li(data-i18n-key="elite.feature_2_point_1") مزامنة فورية مع نظام المحاسبة
                  li(data-i18n-key="elite.feature_2_point_2") تسوية تلقائية مع المستشفيات
                  li(data-i18n-key="elite.feature_2_point_3") تقارير مالية دقيقة 100%
              .col-md-4
                .feature-icon.bg-gradient-success
                  i.fas.fa-link

        //- Feature 3: AI Fraud Detection
        .col-lg-6
          .feature-box(dir="rtl")
            .row
              .col-md-8
                h3(data-i18n-key="elite.feature_3_title") كشف الاحتيال بالذكاء الاصطناعي
                p.mb-3(data-i18n-key="elite.feature_3_text") نظام AI يكتشف المطالبات المشبوهة تلقائياً
                ul.feature-list(style="text-align: right;")
                  li(data-i18n-key="elite.feature_3_point_1") تحليل نمط المطالبات
                  li(data-i18n-key="elite.feature_3_point_2") كشف التكرار والمبالغة
                  li(data-i18n-key="elite.feature_3_point_3") تنبيهات فورية للمراجعة
              .col-md-4
                .feature-icon.bg-gradient-warning
                  i.fas.fa-brain

        //- Feature 4: Mobile Apps
        .col-lg-6
          .feature-box(dir="rtl")
            .row
              .col-md-8
                h3(data-i18n-key="elite.feature_4_title") تطبيقات موبايل
                p.mb-3(data-i18n-key="elite.feature_4_text") تطبيقات للمؤمن عليهم والأطباء
                ul.feature-list(style="text-align: right;")
                  li(data-i18n-key="elite.feature_4_point_1") تقديم المطالبات من الموبايل
                  li(data-i18n-key="elite.feature_4_point_2") موافقات الأطباء إلكترونياً
                  li(data-i18n-key="elite.feature_4_point_3") تتبع حالة المطالبة
              .col-md-4
                .feature-icon.bg-gradient-info
                  i.fas.fa-mobile-alt

  //- ===== Complete Features Grid =====
  section.features-grid.py-5.bg-light
    .container
      .section-header.text-center.mb-5(dir="rtl")
        h2(data-i18n-key="elite.grid_title") المميزات الكاملة لنظام ELITE

      .row.g-4
        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-users.text-primary
            h5(data-i18n-key="elite.grid_1_title") إدارة المؤمن عليهم
            p(data-i18n-key="elite.grid_1_text") قاعدة بيانات شاملة مع السجل الطبي

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-hospital.text-success
            h5(data-i18n-key="elite.grid_2_title") شبكة مقدمي الخدمة
            p(data-i18n-key="elite.grid_2_text") ربط إلكتروني مع المستشفيات

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-file-medical.text-info
            h5(data-i18n-key="elite.grid_3_title") إدارة الوثائق
            p(data-i18n-key="elite.grid_3_text") أرشفة إلكترونية للوثائق الطبية

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-chart-line.text-warning
            h5(data-i18n-key="elite.grid_4_title") تقارير وإحصائيات
            p(data-i18n-key="elite.grid_4_text") لوحات تحكم تفاعلية ومؤشرات

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-shield-virus.text-danger
            h5(data-i18n-key="elite.grid_5_title") الأمان والخصوصية
            p(data-i18n-key="elite.grid_5_text") تشفير كامل للبيانات الطبية

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-globe.text-primary
            h5(data-i18n-key="elite.grid_6_title") متعدد اللغات
            p(data-i18n-key="elite.grid_6_text") واجهة عربي/إنجليزي

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-cloud.text-info
            h5(data-i18n-key="elite.grid_7_title") Cloud Native
            p(data-i18n-key="elite.grid_7_text") نشر سحابي آمن ومستقر

        .col-md-3
          .feature-card-mini(dir="rtl")
            i.fas.fa-headset.text-success
            h5(data-i18n-key="elite.grid_8_title") دعم فني 24/7
            p(data-i18n-key="elite.grid_8_text") فريق دعم متاح على مدار الساعة

  //- ===== Success Story / Case Study =====
  section.case-study.py-5
    .container
      .row.align-items-center
        //- النص على اليمين (في RTL)
        .col-lg-6.order-2.order-lg-1(dir="rtl")
          .badge.badge-success.mb-3(dir="rtl" style="display: inline-flex; align-items: center;")
            span(data-i18n-key="elite.case_badge") قصة نجاح
            i.fas.fa-star.ms-2

          h2.mb-4(style="text-align: right;" data-i18n-key="elite.case_title") كيف ساعدنا شركة TPA رائدة في تحويل عملياتها

          .case-stats.mb-4
            .stat-item.d-flex.align-items-center.mb-3(style="justify-content: flex-end;")
              .stat-content(style="text-align: right; margin-left: 20px;")
                h3.mb-0 80%
                p.mb-0(data-i18n-key="elite.case_stat_1") تقليل وقت معالجة المطالبات
              .stat-icon
                i.fas.fa-arrow-down.text-success(style="font-size: 2rem;")

            .stat-item.d-flex.align-items-center.mb-3(style="justify-content: flex-end;")
              .stat-content(style="text-align: right; margin-left: 20px;")
                h3.mb-0 95%
                p.mb-0(data-i18n-key="elite.case_stat_2") زيادة رضا المؤمن عليهم
              .stat-icon
                i.fas.fa-arrow-up.text-success(style="font-size: 2rem;")

            .stat-item.d-flex.align-items-center.mb-3(style="justify-content: flex-end;")
              .stat-content(style="text-align: right; margin-left: 20px;")
                h3.mb-0 100%
                p.mb-0(data-i18n-key="elite.case_stat_3") دقة البيانات المحاسبية
              .stat-icon
                i.fas.fa-check-circle.text-success(style="font-size: 2rem;")

          blockquote.testimonial(style="text-align: right; border-right: 4px solid #10b981; border-left: none; padding-right: 20px; padding-left: 0;")
            p.quote(style="font-style: italic; font-size: 1.1rem; line-height: 1.8;" data-i18n-key="elite.case_quote") "نظام ELITE غيّر طريقة عملنا بالكامل. دلوقتي بنعالج أكثر من 10,000 مطالبة شهرياً بدقة 100% وفي وقت قياسي."
            .author(style="margin-top: 15px;")
              strong(style="display: block;" data-i18n-key="elite.case_author") م. أحمد محمود
              span(style="color: #64748b; font-size: 0.9rem;" data-i18n-key="elite.case_role") مدير تكنولوجيا المعلومات - شركة TPA رائدة

        //- الصورة على اليسار
        .col-lg-6.order-1.order-lg-2.mb-4.mb-lg-0
          .success-image-wrapper
            img.img-fluid.rounded.shadow-lg(
              src="images/elite-success-story.webp"
              alt="Success Story"
              style="width: 100%; height: auto; object-fit: cover;"
            )

  //- ===== Pricing Section =====
  section.pricing-section.py-5.bg-light
    .container
      .section-header.text-center.mb-5(dir="rtl")
        h2(data-i18n-key="elite.pricing_title") خطط الأسعار
        p.lead(data-i18n-key="elite.pricing_text") اختر الخطة المناسبة لحجم شركتك

      .row.g-4.justify-content-center
        //- Starter Plan
        .col-lg-4
          .pricing-card(dir="rtl")
            .plan-header
              h3(data-i18n-key="elite.plan_starter") Starter
              .plan-price
                span.amount 20,000
                span.currency EGP
                span.period(data-i18n-key="elite.plan_period") /شهرياً

            ul.plan-features(style="text-align: right;")
              li
                span(data-i18n-key="elite.starter_feature_1") حتى 1,000 مطالبة شهرياً
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.starter_feature_2") دعم فني
                i.fas.fa-check.ms-2
              li.disabled
                span(data-i18n-key="elite.starter_feature_3") تطبيق موبايل
                i.fas.fa-times.ms-2
              li.disabled
                span(data-i18n-key="elite.starter_feature_4") ربط مع Odoo ERP
                i.fas.fa-times.ms-2
              li.disabled
                span(data-i18n-key="elite.starter_feature_5") AI Fraud Detection
                i.fas.fa-times.ms-2

            a.btn.btn-outline-primary.w-100(
              href="https://wa.me/201017383815?text=مرحباً، أريد الاشتراك في خطة Starter (20,000 EGP/شهرياً)"
              target="_blank"
              rel="noopener noreferrer"
            )
              i.fab.fa-whatsapp.ms-2
              span(data-i18n-key="elite.start_whatsapp") ابدأ الآن عبر WhatsApp

        //- Professional Plan (Featured)
        .col-lg-4
          .pricing-card.featured(dir="rtl")
            .popular-badge(data-i18n-key="elite.popular_badge") الأكثر طلباً
            .plan-header
              h3(data-i18n-key="elite.plan_professional") Professional
              .plan-price
                span.amount 30,000
                span.currency EGP
                span.period(data-i18n-key="elite.plan_period") /شهرياً

            ul.plan-features(style="text-align: right;")
              li
                span(data-i18n-key="elite.pro_feature_1") حتى 5,000 مطالبة شهرياً
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.pro_feature_2") تطبيقات موبايل متقدمة
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.pro_feature_3") دعم فني 24/7
                i.fas.fa-check.ms-2
              li.disabled
                span(data-i18n-key="elite.pro_feature_4") ربط مع Odoo ERP
                i.fas.fa-times.ms-2
              li.disabled
                span(data-i18n-key="elite.pro_feature_5") AI Fraud Detection
                i.fas.fa-times.ms-2

            a.btn.btn-primary.w-100(
              href="https://wa.me/201017383815?text=مرحباً، أريد الاشتراك في خطة Professional (30,000 EGP/شهرياً)"
              target="_blank"
              rel="noopener noreferrer"
            )
              i.fab.fa-whatsapp.ms-2
              span(data-i18n-key="elite.start_whatsapp") ابدأ الآن عبر WhatsApp

        //- Enterprise Plan
        .col-lg-4
          .pricing-card(dir="rtl")
            .plan-header
              h3(data-i18n-key="elite.plan_enterprise") Enterprise
              .plan-price
                span.amount(data-i18n-key="elite.enterprise_amount") مخصص

            ul.plan-features(style="text-align: right;")
              li
                span(data-i18n-key="elite.enterprise_feature_1") مطالبات غير محدودة
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.enterprise_feature_2") ربط كامل مع Odoo ERP
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.enterprise_feature_3") AI Fraud Detection
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.enterprise_feature_4") تطبيقات موبايل متقدمة
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.enterprise_feature_5") فريق دعم مخصص
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.enterprise_feature_6") تخصيص كامل
                i.fas.fa-check.ms-2
              li
                span(data-i18n-key="elite.enterprise_feature_7") تقارير متقدمة
                i.fas.fa-check.ms-2

            a.btn.btn-outline-primary.w-100(href="contact.html")
              i.fas.fa-calendar-check.ms-2
              span(data-i18n-key="elite.book_consultation") احجز استشارة مجانية

  //- ===== FAQ Section =====
  section.faq-section.py-5
    .container
      .section-header.text-center.mb-5(dir="rtl")
        h2(data-i18n-key="elite.faq_title") الأسئلة الشائعة
        p.lead(data-i18n-key="elite.faq_text") إجابات على أكثر الأسئلة تكراراً

      .row.justify-content-center
        .col-lg-8
          .accordion#eliteFAQ(dir="rtl")
            //- Q1
            .accordion-item
              h2.accordion-header#faq1
                button.accordion-button(type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" dir="rtl")
                  span(data-i18n-key="elite.faq_q1") كم يستغرق تطبيق نظام ELITE؟
              #collapse1.accordion-collapse.collapse.show(data-bs-parent="#eliteFAQ")
                .accordion-body(dir="rtl" style="text-align: right;" data-i18n-key="elite.faq_a1") عادة من 4-8 أسابيع حسب حجم الشركة وتعقيد المتطلبات. نقدم خطة تطبيق تدريجية لضمان انتقال سلس.

            //- Q2
            .accordion-item
              h2.accordion-header#faq2
                button.accordion-button.collapsed(type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" dir="rtl")
                  span(data-i18n-key="elite.faq_q2") هل يدعم ELITE التكامل مع أنظمة أخرى؟
              #collapse2.accordion-collapse.collapse(data-bs-parent="#eliteFAQ")
                .accordion-body(dir="rtl" style="text-align: right;" data-i18n-key="elite.faq_a2") نعم، ELITE يدعم الربط مع Odoo ERP بشكل أساسي، كما يمكن الربط مع أنظمة المستشفيات والصيدليات عبر APIs.

            //- Q3
            .accordion-item
              h2.accordion-header#faq3
                button.accordion-button.collapsed(type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" dir="rtl")
                  span(data-i18n-key="elite.faq_q3") هل البيانات آمنة ومشفرة؟
              #collapse3.accordion-collapse.collapse(data-bs-parent="#eliteFAQ")
                .accordion-body(dir="rtl" style="text-align: right;" data-i18n-key="elite.faq_a3") بالتأكيد. نستخدم تشفير AES-256 لجميع البيانات، مع استضافة سحابية آمنة ونسخ احتياطية يومية.

            //- Q4
            .accordion-item
              h2.accordion-header#faq4
                button.accordion-button.collapsed(type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" dir="rtl")
                  span(data-i18n-key="elite.faq_q4") هل يمكن تجربة النظام قبل الشراء؟
              #collapse4.accordion-collapse.collapse(data-bs-parent="#eliteFAQ")
                .accordion-body(dir="rtl" style="text-align: right;" data-i18n-key="elite.faq_a4") نعم، نقدم عرضاً تجريبياً مجانياً لمدة 14 يوم مع بياناتك الفعلية لتتأكد من ملاءمة النظام لاحتياجاتك.

  //- ===== Video Gallery Section =====
  section.video-gallery.py-5.bg-light
    .container
      .section-header.text-center.mb-5(dir="rtl")
        h2(data-i18n-key="elite.video_title") شاهد ELITE في العمل
        p.lead(data-i18n-key="elite.video_text") فيديوهات توضيحية شاملة عن جميع المميزات

      .row.justify-content-center
        .col-lg-10
          //- Playlist Embed (More Reliable)
          .featured-video.mb-4
            .ratio.ratio-16x9.rounded.shadow-lg
              iframe(
                src="https://www.youtube.com/embed/videoseries?list=PL4gLQMepBmISlPelJuRx09EtDa27O-mN0"
                title="ELITE System - Complete Playlist"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
