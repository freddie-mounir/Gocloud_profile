extends layout.pug

block variables
  - var pageTitle = "تطوير Odoo المخصص — وحدات وتكاملات حسب احتياجك | GoCloud"
  - var pageDescription = "خدمات GoCloud لتطوير Odoo المخصص — وحدات خاصة وتكاملات API وأتمتة مسارات العمل وتقارير متقدمة مصممة حسب عملياتك."
  - var pageKeywords = "تطوير Odoo مخصص, وحدات Odoo, تكامل API, أتمتة المسارات, مطور Odoo مصر, ERP مخصص"
  - var canonicalUrl = "https://www.gocloudeg.com/odoo-dev.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles

block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Section
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1(data-i18n-key="odoo_dev.hero_title") تطوير Odoo
            .space16
            .span
              img(src="images/span1.webp" alt="" loading="lazy")
              |
              a(href="service.html" data-i18n-key="odoo_dev.breadcrumb_service") الخدمات
              |
              span.arrow
                i.fa-regular.fa-angle-right
              |
              span(data-i18n-key="odoo_dev.breadcrumb_current") تطوير Odoo

  // Marquee Section
  include components/marquee-brands.pug

  // Text & Image Section
  .container.my-5
    .row.align-items-center
      .col-lg-6
        h2.fw-bold.mb-4(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000" data-i18n-key="odoo_dev.section1_title") تميز في تطوير Odoo
        p.lead.mb-4(data-aos="fade-right" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="odoo_dev.section1_text") نقدم حلول تطوير Odoo شاملة ومصممة وفق احتياجات أعمالك. فريقنا المتخصص يركز على:
        ul.list-unstyled(data-aos="fade-right" data-aos-delay="400" data-aos-duration="1000")
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="odoo_dev.point_1") تطوير وحدات مخصصة
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="odoo_dev.point_2") تكاملات مع أنظمة خارجية
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="odoo_dev.point_3") تحسين الأداء
          li.mb-3
            i.fas.fa-check-circle.text-primary.me-2
            span(data-i18n-key="odoo_dev.point_4") دعم فني وصيانة

      .col-lg-6(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime.image-hover-skew
          img(src="images/odoo fix.webp" alt="Odoo Development" class="img-fluid rounded shadow-lg" loading="lazy")
          .position-absolute.top-0.start-0.w-100.h-100

  // Image & Text Section
  .container.my-5
    .row.align-items-center
      .col-lg-6(data-aos="fade-left" data-aos-delay="200" data-aos-duration="1000")
        .position-relative.image-anime.image-hover-skew
          img(src="images/visit CRM.webp" alt="Odoo Development" class="img-fluid rounded shadow-lg" loading="lazy")
          .position-absolute.top-0.start-0.w-100.h-100

      .col-lg-6
        h2.fw-bold.mb-4(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="odoo_dev.section2_title") مسارات Odoo مخصصة لكل قطاع
        p.lead.mb-4(data-aos="fade-left" data-aos-delay="300" data-aos-duration="1000" data-i18n-key="odoo_dev.section2_text") حلول مسارات العمل في Odoo لدينا مصممة بعناية لقطاعات متعددة من التصنيع إلى التجزئة. نحلل احتياجات قطاعك ونحسّن العمليات ونطبق وحدات Odoo مخصصة تسهّل التشغيل وترفع الإنتاجية.
        ul.list-unstyled(data-aos="fade-left" data-aos-delay="400" data-aos-duration="1000")
          li.mb-3
            button.btn.rounded-pill.px-4.py-2.bg-primary.text-white.border-0.hover-intense(style="transition: all 0.3s ease;")
              i.fas.fa-check-circle.me-2
              span(data-i18n-key="odoo_dev.badge_1") نظام Pharma CRM

          li.mb-3
            button.btn.rounded-pill.px-4.py-2.bg-warning.text-white.border-0.hover-intense(style="transition: all 0.3s ease;")
              i.fas.fa-check-circle.me-2
              span(data-i18n-key="odoo_dev.badge_2") نظام إدارة استثمارات الذهب

  // Include footer
  include components/footer.pug

  // Include whatsapp button
  include components/whatsapp-button.pug
