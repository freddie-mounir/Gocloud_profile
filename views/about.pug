extends layout.pug

block variables
  - var pageTitle = "GoCloud | خبرة عملية في Odoo والتحول الرقمي"
  - var pageDescription = "تعرف على GoCloud، شريك Odoo في مصر منذ 2015، وخبراتنا في ERP وCRM والسحابة وذكاء الأعمال وحلول التأمين الطبي والتحول الرقمي."
  - var pageKeywords = "GoCloud, Odoo Partner Egypt, Odoo ERP, ELITE medical insurance, cloud, business intelligence, digital transformation"
  - var canonicalUrl = "https://www.gocloudeg.com/about.html"
  - var ogImage = "https://www.gocloudeg.com/images/about%20us.webp"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles
  style.
    :root{--profile-blue:#0e38b1;--profile-blue-dark:#082a86;--profile-green:#a1e934;--profile-ink:#111827;--profile-muted:#586176;--profile-line:#dfe5ef;--profile-soft:#f4f7fb;--profile-white:#fff}
    .profile-en{display:none}
    html[dir='ltr'] .profile-ar{display:none}
    html[dir='ltr'] .profile-en{display:initial}
    html[dir='ltr'] div.profile-en,html[dir='ltr'] section.profile-en{display:block}
    .profile-section{padding:5.5rem 0}
    .profile-kicker{display:inline-flex;align-items:center;gap:.55rem;margin-bottom:1rem;color:var(--profile-blue);font-size:.78rem;font-weight:800;text-transform:uppercase}
    .profile-kicker::before{content:"";width:28px;height:3px;background:var(--profile-green)}
    .profile-title{max-width:760px;margin:0 0 1.15rem;color:var(--profile-ink);font-size:2.25rem;font-weight:800;line-height:1.25}
    .profile-lead{max-width:720px;margin:0;color:var(--profile-muted);font-size:1.05rem;line-height:1.85}
    .profile-hero{position:relative;min-height:520px;display:flex;align-items:center;background-image:linear-gradient(90deg,rgba(5,18,55,.94) 0%,rgba(5,25,76,.82) 48%,rgba(5,18,55,.24) 100%),url('images/about%20us.webp');background-size:cover;background-position:center}
    html[dir='rtl'] .profile-hero{background-image:linear-gradient(270deg,rgba(5,18,55,.94) 0%,rgba(5,25,76,.82) 48%,rgba(5,18,55,.24) 100%),url('images/about%20us.webp')}
    .profile-hero-content{max-width:690px;padding:5rem 0}
    .profile-hero-mark{display:inline-flex;align-items:center;gap:.65rem;margin-bottom:1.4rem;color:#fff;font-size:.82rem;font-weight:700}
    .profile-hero-mark img{width:36px;height:36px;object-fit:contain;background:#fff;border-radius:4px;padding:3px}
    .profile-hero h1{margin:0 0 1.35rem;color:#fff;font-size:3.25rem;font-weight:800;line-height:1.15}
    .profile-hero p{max-width:650px;margin:0 0 2rem;color:rgba(255,255,255,.84);font-size:1.12rem;line-height:1.8}
    .profile-actions{display:flex;flex-wrap:wrap;gap:.75rem}
    .profile-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:48px;padding:.7rem 1.3rem;border:1px solid transparent;border-radius:6px;font-size:.9rem;font-weight:800;text-decoration:none;transition:transform .2s,background .2s}
    .profile-btn:hover{transform:translateY(-2px)}
    .profile-btn-primary{background:var(--profile-green);color:#163006}
    .profile-btn-primary:hover{background:#b2f05c;color:#163006}
    .profile-btn-secondary{border-color:rgba(255,255,255,.6);color:#fff}
    .profile-btn-secondary:hover{background:#fff;color:var(--profile-blue-dark)}
    .profile-proof{margin-top:-52px;position:relative;z-index:2}
    .profile-proof-inner{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border:1px solid var(--profile-line);box-shadow:0 16px 44px rgba(5,25,76,.12)}
    .profile-proof-item{padding:1.55rem 1.7rem;border-inline-end:1px solid var(--profile-line)}
    .profile-proof-item:last-child{border-inline-end:0}
    .profile-proof-value{display:block;color:var(--profile-blue-dark);font-size:1.05rem;font-weight:800}
    .profile-proof-label{display:block;margin-top:.3rem;color:var(--profile-muted);font-size:.83rem;line-height:1.5}
    .profile-story-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);align-items:center;gap:4.5rem}
    .profile-story-image{position:relative}
    .profile-story-image img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
    .profile-story-note{position:absolute;bottom:-24px;inset-inline-start:-24px;max-width:270px;background:var(--profile-blue-dark);color:#fff;padding:1.25rem}
    .profile-story-note strong{display:block;margin-bottom:.35rem;color:var(--profile-green);font-size:1rem}
    .profile-story-note span{font-size:.82rem;line-height:1.55}
    .profile-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}
    .profile-principle{padding-top:1rem;border-top:3px solid var(--profile-line)}
    .profile-principle strong{display:block;color:var(--profile-ink);font-size:.9rem}
    .profile-principle span{display:block;margin-top:.35rem;color:var(--profile-muted);font-size:.8rem;line-height:1.5}
    .profile-capabilities{background:var(--profile-soft)}
    .profile-capability-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem;margin-top:2.5rem}
    .profile-capability{position:relative;min-height:250px;padding:1.7rem;background:#fff;border:1px solid var(--profile-line);border-radius:8px;transition:transform .25s,border-color .25s,box-shadow .25s}
    .profile-capability:hover{transform:translateY(-5px);border-color:var(--profile-blue);box-shadow:0 14px 32px rgba(14,56,177,.09)}
    .profile-capability-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;background:var(--profile-blue);border-radius:6px;color:#fff;font-size:1.15rem}
    .profile-capability h3{margin:0 0 .7rem;color:var(--profile-ink);font-size:1.08rem;font-weight:800}
    .profile-capability p{margin:0 0 1.25rem;color:var(--profile-muted);font-size:.88rem;line-height:1.7}
    .profile-capability a{position:absolute;bottom:1.5rem;color:var(--profile-blue);font-size:.82rem;font-weight:800;text-decoration:none}
    .profile-sectors{background:var(--profile-blue-dark);color:#fff}
    .profile-sectors .profile-kicker{color:var(--profile-green)}
    .profile-sectors .profile-title{color:#fff}
    .profile-sectors .profile-lead{color:rgba(255,255,255,.7)}
    .profile-sector-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:2.5rem;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.15)}
    .profile-sector{padding:1.6rem;background:var(--profile-blue-dark)}
    .profile-sector i{display:block;margin-bottom:.9rem;color:var(--profile-green);font-size:1.35rem}
    .profile-sector strong{display:block;font-size:.95rem}
    .profile-sector span{display:block;margin-top:.4rem;color:rgba(255,255,255,.65);font-size:.78rem;line-height:1.5}
    .profile-process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:2.75rem;border-top:1px solid var(--profile-line)}
    .profile-step{position:relative;padding:2rem 1.5rem 0 0}
    html[dir='rtl'] .profile-step{padding:2rem 0 0 1.5rem}
    .profile-step-number{position:absolute;top:-17px;inset-inline-start:0;width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:var(--profile-blue);border:4px solid #fff;border-radius:50%;color:#fff;font-size:.72rem;font-weight:800}
    .profile-step h3{margin:0 0 .6rem;color:var(--profile-ink);font-size:1rem;font-weight:800}
    .profile-step p{margin:0;color:var(--profile-muted);font-size:.83rem;line-height:1.65}
    .profile-why{background:var(--profile-soft)}
    .profile-why-grid{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(0,1.15fr);align-items:center;gap:4rem}
    .profile-why-visual{position:relative;background:#fff;border:1px solid var(--profile-line);padding:1rem}
    .profile-why-visual img{width:100%;aspect-ratio:1/1;object-fit:cover}
    .profile-why-badge{position:absolute;bottom:28px;inset-inline-end:-22px;background:#fff;border-left:5px solid var(--profile-green);padding:1rem 1.2rem;box-shadow:0 10px 28px rgba(5,25,76,.14)}
    .profile-why-badge strong{display:block;color:var(--profile-blue-dark);font-size:.9rem}
    .profile-why-badge span{color:var(--profile-muted);font-size:.75rem}
    .profile-check-list{display:grid;gap:1.1rem;margin-top:2rem}
    .profile-check{display:grid;grid-template-columns:38px 1fr;gap:.85rem}
    .profile-check i{width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:#eaf6cf;border-radius:50%;color:#3f6e00;font-size:.8rem}
    .profile-check strong{display:block;color:var(--profile-ink);font-size:.92rem}
    .profile-check span{display:block;margin-top:.25rem;color:var(--profile-muted);font-size:.82rem;line-height:1.55}
    .profile-leadership-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-top:2.5rem}
    .profile-leader{overflow:hidden;border:1px solid var(--profile-line);border-radius:8px;background:#fff}
    .profile-leader img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;object-position:top}
    .profile-leader-body{padding:1.3rem}
    .profile-leader h3{margin:0;color:var(--profile-ink);font-size:1rem;font-weight:800}
    .profile-leader p{margin:.35rem 0 0;color:var(--profile-blue);font-size:.8rem;font-weight:700}
    .profile-cta{padding:0 0 5.5rem}
    .profile-cta-inner{display:grid;grid-template-columns:1fr auto;align-items:center;gap:2rem;padding:2.5rem;background:var(--profile-blue);color:#fff}
    .profile-cta h2{margin:0 0 .55rem;font-size:1.75rem;font-weight:800}
    .profile-cta p{max-width:670px;margin:0;color:rgba(255,255,255,.75);font-size:.92rem;line-height:1.65}
    @media(max-width:991px){.profile-hero{min-height:500px}.profile-hero h1{font-size:2.65rem}.profile-story-grid,.profile-why-grid{grid-template-columns:1fr;gap:3rem}.profile-capability-grid{grid-template-columns:repeat(2,1fr)}.profile-process-grid{grid-template-columns:repeat(2,1fr);row-gap:2.5rem}.profile-leadership-grid{grid-template-columns:repeat(3,1fr)}}
    @media(max-width:767px){.profile-section{padding:4rem 0}.profile-hero{min-height:0;background-position:62% center}.profile-hero-content{padding:2.5rem 0}.profile-hero-mark{margin-bottom:.8rem;font-size:.72rem}.profile-hero-mark img{width:30px;height:30px}.profile-hero h1{margin-bottom:1rem;font-size:1.75rem;line-height:1.15}.profile-hero p{margin-bottom:1.25rem;font-size:.9rem;line-height:1.6}.profile-actions{gap:.5rem}.profile-btn{width:100%;min-height:42px;padding:.55rem 1rem}.profile-proof{margin-top:0}.profile-proof-inner{grid-template-columns:1fr}.profile-proof-item{padding:1rem 1.2rem;border-inline-end:0;border-bottom:1px solid var(--profile-line)}.profile-proof-item:last-child{border-bottom:0}.profile-title{font-size:1.8rem}.profile-capability-grid,.profile-sector-grid,.profile-leadership-grid{grid-template-columns:1fr}.profile-process-grid{grid-template-columns:1fr;gap:2.5rem}.profile-principles{grid-template-columns:1fr}.profile-story-note{position:static;max-width:none}.profile-why-badge{position:static;margin-top:1rem}.profile-cta-inner{grid-template-columns:1fr;padding:2rem}}

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  main
    section.profile-hero
      .container
        .profile-hero-content
          .profile-hero-mark
            img(src="images/gocloud-email-logo.png" alt="GoCloud" width="36" height="36")
            span.profile-ar شريك تقني للأعمال المعقدة منذ 2015
            span.profile-en Technology partner for complex operations since 2015
          h1
            span.profile-ar نحوّل العمليات المعقدة إلى أنظمة واضحة وقابلة للنمو
            span.profile-en We turn complex operations into clear, scalable systems
          p
            span.profile-ar تجمع GoCloud بين خبرة Odoo ERP وCRM، والحلول السحابية، وذكاء الأعمال، وتطوير البرمجيات المتخصصة لمساعدة المؤسسات على ربط فرقها وبياناتها وقراراتها.
            span.profile-en GoCloud combines Odoo ERP and CRM expertise, cloud solutions, business intelligence, and specialized software engineering to connect teams, data, and decisions.
          .profile-actions
            a.profile-btn.profile-btn-primary(href="service.html")
              span.profile-ar استكشف خدماتنا
              span.profile-en Explore our services
              i.fas.fa-arrow-left
            a.profile-btn.profile-btn-secondary(href="https://wa.me/201017383815?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20digital%20transformation%20project" target="_blank" rel="noopener noreferrer")
              i.fab.fa-whatsapp
              span.profile-ar تحدث مع مستشار
              span.profile-en Talk to a consultant

    .profile-proof
      .container
        .profile-proof-inner
          .profile-proof-item
            span.profile-proof-value 2015
            span.profile-proof-label.profile-ar بداية رحلتنا في بناء الحلول المؤسسية
            span.profile-proof-label.profile-en The start of our enterprise solutions journey
          .profile-proof-item
            span.profile-proof-value Odoo Partner
            span.profile-proof-label.profile-ar تنفيذ وتطوير وربط أنظمة ERP وCRM
            span.profile-proof-label.profile-en ERP and CRM implementation, development, and integration
          .profile-proof-item
            span.profile-proof-value Egypt · MENA
            span.profile-proof-label.profile-ar خبرة محلية برؤية إقليمية
            span.profile-proof-label.profile-en Local expertise with a regional perspective

    section.profile-section
      .container
        .profile-story-grid
          .profile-story-copy(data-aos="fade-up")
            .profile-kicker
              span.profile-ar من نحن
              span.profile-en Who we are
            h2.profile-title
              span.profile-ar شريك تنفيذ يفهم العملية قبل أن يختار التقنية
              span.profile-en An implementation partner that understands the operation before choosing the technology
            p.profile-lead
              span.profile-ar بدأت GoCloud في مصر عام 2015 بهدف عملي: مساعدة المؤسسات على التخلص من الأنظمة المنفصلة والعمل اليدوي والبيانات غير المترابطة. اليوم نصمم وننفذ منصات تجمع العمليات الأساسية في تجربة واحدة، من Odoo وELITE إلى السحابة والتحليلات والتطبيقات المخصصة.
              span.profile-en GoCloud began in Egypt in 2015 with a practical purpose: help organizations move beyond disconnected systems, manual work, and fragmented data. Today we design and deliver platforms that unite core operations, from Odoo and ELITE to cloud, analytics, and custom applications.
            .profile-principles
              .profile-principle
                strong.profile-ar نفهم العمل
                strong.profile-en Understand the work
                span.profile-ar نبدأ بالعمليات والنتائج المطلوبة.
                span.profile-en We start with operations and desired outcomes.
              .profile-principle
                strong.profile-ar نبني للتبني
                strong.profile-en Build for adoption
                span.profile-ar نصمم حلولاً يستخدمها الفريق بثقة.
                span.profile-en We design systems teams can use confidently.
              .profile-principle
                strong.profile-ar نبقى بعد الإطلاق
                strong.profile-en Stay after launch
                span.profile-ar ندعم التحسين والنمو المستمر.
                span.profile-en We support continuous improvement and growth.
          .profile-story-image(data-aos="fade-up" data-aos-delay="100")
            img(src="images/team/Walid&Ahmed.webp" alt="GoCloud leadership at an industry event" loading="lazy" width="1080" height="1440")
            .profile-story-note
              strong.profile-ar خبرة تقنية مرتبطة بنتائج الأعمال
              strong.profile-en Technical depth tied to business outcomes
              span.profile-ar نربط الهندسة والتنفيذ وفهم القطاع في فريق واحد.
              span.profile-en We bring engineering, delivery, and sector understanding into one team.

    section.profile-section.profile-capabilities
      .container
        .profile-kicker
          span.profile-ar قدراتنا
          span.profile-en Our capabilities
        h2.profile-title
          span.profile-ar خدمات مترابطة من الاستراتيجية حتى التشغيل
          span.profile-en Connected services from strategy through operation
        p.profile-lead
          span.profile-ar نختار المكونات المناسبة لكل حالة، ثم نربطها في منظومة يمكن إدارتها وقياسها وتطويرها.
          span.profile-en We select the right components for each case, then connect them into an ecosystem that can be managed, measured, and improved.
        .profile-capability-grid
          article.profile-capability
            .profile-capability-icon
              i.fas.fa-layer-group
            h3.profile-ar تنفيذ Odoo ERP وCRM
            h3.profile-en Odoo ERP & CRM implementation
            p.profile-ar تحليل المتطلبات، تهيئة الوحدات، ترحيل البيانات، التدريب، والإطلاق وفق تدفقات العمل الفعلية.
            p.profile-en Requirements analysis, module configuration, data migration, training, and launch around real workflows.
            a(href="odoo-imp.html")
              span.profile-ar تعرف على التنفيذ
              span.profile-en Explore implementation
          article.profile-capability
            .profile-capability-icon
              i.fas.fa-code
            h3.profile-ar تطوير وتكامل Odoo
            h3.profile-en Odoo development & integration
            p.profile-ar وحدات مخصصة، تكاملات خارجية، أتمتة، وتحسين أداء يوسع قدرات المنصة دون تعقيد غير ضروري.
            p.profile-en Custom modules, external integrations, automation, and performance work that extend the platform responsibly.
            a(href="odoo-dev.html")
              span.profile-ar استكشف التطوير
              span.profile-en Explore development
          article.profile-capability
            .profile-capability-icon
              i.fas.fa-heartbeat
            h3.profile-ar منصة ELITE للتأمين الطبي
            h3.profile-en ELITE medical insurance platform
            p.profile-ar إدارة الوثائق والمطالبات وشبكات مقدمي الخدمة وبوابات الأعضاء ضمن دورة تشغيل مترابطة.
            p.profile-en Policies, claims, provider networks, and member portals within one connected operating cycle.
            a(href="elite.html")
              span.profile-ar اكتشف ELITE
              span.profile-en Discover ELITE
          article.profile-capability
            .profile-capability-icon
              i.fas.fa-cloud
            h3.profile-ar السحابة وDevOps
            h3.profile-en Cloud & DevOps
            p.profile-ar بنية تحتية، نشر مؤتمت، مراقبة واستمرارية تشغيل لأنظمة أكثر استقراراً وقابلية للتوسع.
            p.profile-en Infrastructure, automated deployment, monitoring, and continuity for stable, scalable systems.
            a(href="service.html")
              span.profile-ar جميع الخدمات
              span.profile-en All services
          article.profile-capability
            .profile-capability-icon
              i.fas.fa-chart-line
            h3.profile-ar ذكاء الأعمال والتحليلات
            h3.profile-en Business intelligence & analytics
            p.profile-ar لوحات معلومات وتقارير مؤتمتة تحول البيانات التشغيلية إلى مؤشرات واضحة لصنع القرار.
            p.profile-en Dashboards and automated reporting that turn operational data into decision-ready insight.
            a(href="business.html")
              span.profile-ar استكشف التحليلات
              span.profile-en Explore analytics
          article.profile-capability
            .profile-capability-icon
              i.fas.fa-globe
            h3.profile-ar المنصات الرقمية والتجارة
            h3.profile-en Digital platforms & commerce
            p.profile-ar مواقع ومنصات تجارة وتجارب رقمية سريعة ومتجاوبة تخدم العلامة التجارية وأهداف التحويل.
            p.profile-en Fast, responsive websites, commerce platforms, and digital experiences built around brand and conversion goals.
            a(href="portfolio.html")
              span.profile-ar شاهد أعمالنا
              span.profile-en View our work

    section.profile-section.profile-sectors
      .container
        .profile-kicker
          span.profile-ar خبرة قطاعية
          span.profile-en Sector experience
        h2.profile-title
          span.profile-ar نفهم أن كل قطاع يتحدث بلغة تشغيل مختلفة
          span.profile-en We understand that every sector speaks a different operational language
        p.profile-lead
          span.profile-ar خبرتنا القطاعية تساعدنا على الوصول إلى الأسئلة الصحيحة أسرع وبناء تدفقات عمل أقرب إلى الواقع.
          span.profile-en Sector context helps us ask better questions sooner and design workflows closer to operational reality.
        .profile-sector-grid
          .profile-sector
            i.fas.fa-shield-alt
            strong.profile-ar التأمين الطبي وTPA
            strong.profile-en Medical insurance & TPA
            span.profile-ar مطالبات، وثائق، مقدمو خدمة وبوابات رقمية.
            span.profile-en Claims, policies, providers, and digital portals.
          .profile-sector
            i.fas.fa-clinic-medical
            strong.profile-ar الرعاية الصحية والمستلزمات الطبية
            strong.profile-en Healthcare & medical supplies
            span.profile-ar مبيعات مؤسسية، مستندات، متابعة وعلاقات عملاء.
            span.profile-en Institutional sales, documents, follow-up, and CRM.
          .profile-sector
            i.fas.fa-truck-loading
            strong.profile-ar التجارة والتوزيع
            strong.profile-en Trade & distribution
            span.profile-ar مخزون ومبيعات ومشتريات وفروع في تدفق واحد.
            span.profile-en Inventory, sales, purchasing, and branches in one flow.
          .profile-sector
            i.fas.fa-coins
            strong.profile-ar الذهب والاستثمار
            strong.profile-en Gold & investment
            span.profile-ar عملاء ومستثمرون وفروع وتسعير وفرص بيع.
            span.profile-en Customers, investors, branches, pricing, and opportunities.
          .profile-sector
            i.fas.fa-hard-hat
            strong.profile-ar المقاولات والمشروعات
            strong.profile-en Construction & projects
            span.profile-ar تكاليف ومشتريات ومواقع ومتابعة تنفيذ.
            span.profile-en Cost, procurement, sites, and delivery tracking.
          .profile-sector
            i.fas.fa-building
            strong.profile-ar المؤسسات متعددة الإدارات
            strong.profile-en Multi-department organizations
            span.profile-ar توحيد البيانات والصلاحيات والتقارير بين الفرق.
            span.profile-en Unified data, permissions, and reporting across teams.

    section.profile-section
