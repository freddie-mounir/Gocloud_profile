extends layout.pug

block variables
  - var pageTitle = "Our Services | GoCloud"
  - var pageDescription = "Explore GoCloud's full range of IT services: cloud solutions, Odoo ERP development & implementation, business intelligence, eCommerce, and ELITE medical insurance systems."
  - var pageKeywords = "IT services, cloud solutions, Odoo ERP, business intelligence, eCommerce, portfolio websites, medical insurance, GoCloud"
  - var canonicalUrl = "https://www.gocloudeg.com/service.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"

block styles
  style.
    .services-intro {
      max-width: 640px;
      margin: 0 auto;
    }
    .service-card {
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 2rem 1.75rem;
      position: relative;
      transition: all .35s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    .service-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 40px rgba(14,56,177,.12);
      border-color: #0E38B1;
    }
    .service-card .card-icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: #fff;
      margin-bottom: 1.25rem;
      flex-shrink: 0;
    }
    .service-card h4 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: .75rem;
    }
    .service-card h4 a {
      color: #0D0E10;
      text-decoration: none;
      transition: color .3s;
    }
    .service-card:hover h4 a {
      color: #0E38B1;
    }
    .service-card p {
      color: #676879;
      font-size: .925rem;
      line-height: 1.65;
      flex-grow: 1;
    }
    .service-card .card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      font-size: .875rem;
      color: #0E38B1;
      text-decoration: none;
      margin-top: auto;
      padding-top: 1rem;
      transition: gap .3s;
    }
    .service-card:hover .card-link {
      gap: 10px;
    }
    .services-cta {
      background: linear-gradient(135deg, #0E38B1 0%, #113ADC 100%);
      border-radius: 16px;
      padding: 3rem 2rem;
    }

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Area
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1 Our Services
            .space16
            span.span
              img(src="images/span1.webp" alt="decorative divider" loading="lazy" width="18" height="16")
              |
              a(href="index.html") Home
              |
              span.arrow
                i.fa-regular.fa-angle-right
              |  Our Services

  // Marquee
  include components/marquee-brands.pug

  .space40

  // Services Section
  section.py-5
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold What We Do
        p.lead.text-muted.services-intro End-to-end technology solutions that help businesses digitize, automate, and grow.

      .row.g-4
        //- Cloud Services
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="100")
          .service-card
            .card-icon(style="background: #0E38B1;")
              i.fas.fa-cloud
            h4
              a(href="cloud-services.html") Cloud Solutions
            p Harness the power of the cloud with scalable hosting, containerization, and Linux server management. We help you migrate, optimize, and secure your infrastructure.
            a.card-link(href="cloud-services.html")
              | Learn more
              i.fas.fa-arrow-right

        //- Odoo Development
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="200")
          .service-card
            .card-icon(style="background: #6E18EF;")
              i.fas.fa-code
            h4
              a(href="odoo-dev.html") Odoo ERP &amp; CRM Development
            p Custom module development, third-party integrations, and performance optimization. We build tailored Odoo solutions that fit your industry's unique workflow.
            a.card-link(href="odoo-dev.html")
              | Learn more
              i.fas.fa-arrow-right

        //- Odoo Implementation
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="300")
          .service-card
            .card-icon(style="background: #198754;")
              i.fas.fa-cogs
            h4
              a(href="odoo-imp.html") Odoo ERP &amp; CRM Implementation
            p From requirements analysis to go-live, we implement industry-specific Odoo workflows — including Pharma CRM, gold investment management, and more.
            a.card-link(href="odoo-imp.html")
              | Learn more
              i.fas.fa-arrow-right

        //- Portfolio & E-commerce
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="400")
          .service-card
            .card-icon(style="background: #fd7e14;")
              i.fas.fa-shopping-cart
            h4
              a(href="portfolio.html") Portfolio &amp; E-commerce
            p Stunning portfolio websites and powerful e-commerce platforms that elevate your brand and drive conversions through modern design and seamless user experience.
            a.card-link(href="portfolio.html")
              | Learn more
              i.fas.fa-arrow-right

        //- Business Intelligence
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="500")
          .service-card
            .card-icon(style="background: #ffc107;")
              i.fas.fa-chart-bar
            h4
              a(href="business.html") Business Intelligence
            p Transform raw data into actionable insights with advanced analytics, interactive dashboards, and automated reporting powered by Power BI and Metabase.
            a.card-link(href="business.html")
              | Learn more
              i.fas.fa-arrow-right

        //- ELITE Medical Insurance
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="600")
          .service-card
            .card-icon(style="background: #dc3545;")
              i.fas.fa-heartbeat
            h4
              a(href="elite.html") ELITE Medical Insurance
            p A comprehensive medical insurance management system featuring provider networks, claims processing, policy administration, and real-time member portals.
            a.card-link(href="elite.html")
              | Learn more
              i.fas.fa-arrow-right

  .space40

  // CTA Section
  section.pb-5
    .container
      .services-cta.text-center.text-white(data-aos="fade-up")
        h2.fw-bold.mb-3 Ready to Transform Your Business?
        p.lead.mb-4.opacity-75 Let's discuss how our solutions can accelerate your growth.
        a.btn.btn-light.btn-lg.fw-semibold.px-4(href="https://wa.me/201017383815" target="_blank" rel="noopener noreferrer")
          i.fab.fa-whatsapp.me-2
          | Get in Touch

  include components/footer.pug
  include components/whatsapp-button.pug
