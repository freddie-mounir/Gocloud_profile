extends layout.pug

block variables
  - var pageTitle = "خدمات GoCloud | حلول تقنية متكاملة"
  - var pageDescription = "استكشف مجموعة GoCloud الكاملة من الخدمات التقنية: الحلول السحابية وتطوير وتنفيذ Odoo وذكاء الأعمال والتجارة الإلكترونية ونظام ELITE للتأمين الطبي."
  - var pageKeywords = "خدمات تقنية, حلول سحابية, Odoo ERP, ذكاء الأعمال, التجارة الإلكترونية, مواقع الأعمال, التأمين الطبي, GoCloud"
  - var canonicalUrl = "https://www.gocloudeg.com/service.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block styles
  style.
    .services-intro {
      max-width: 640px;
      margin: 0 auto;
    }
    .service-card {
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 2rem 1.75rem;
      position: relative;
      transition: all .35s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    .service-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 40px rgba(14,56,177,.12);
      border-color: #0E38B1;
    }
    .service-card .card-icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: #fff;
      margin-bottom: 1.25rem;
      flex-shrink: 0;
    }
    .service-card h4 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: .75rem;
    }
    .service-card h4 a {
      color: #0D0E10;
      text-decoration: none;
      transition: color .3s;
    }
    .service-card:hover h4 a {
      color: #0E38B1;
    }
    .service-card p {
      color: #676879;
      font-size: .925rem;
      line-height: 1.65;
      flex-grow: 1;
    }
    .service-card .card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      font-size: .875rem;
      color: #0E38B1;
      text-decoration: none;
      margin-top: auto;
      padding-top: 1rem;
      transition: gap .3s;
    }
    .service-card:hover .card-link {
      gap: 10px;
    }
    .services-cta {
      background: linear-gradient(135deg, #0E38B1 0%, #113ADC 100%);
      border-radius: 16px;
      padding: 3rem 2rem;
    }

block content
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Area
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1(data-i18n-key="services.hero_title") خدماتنا
            .space16
            span.span
              img(src="images/span1.webp" alt="decorative divider" loading="lazy" width="18" height="16")
              |
              a(href="index.html" data-i18n-key="services.breadcrumb_home") الرئيسية
              |
              span.arrow
                i.fa-regular.fa-angle-right
              |
              span(data-i18n-key="services.breadcrumb") خدماتنا

  // Marquee
  include components/marquee-brands.pug

  .space40

  // Services Section
  section.py-5
    .container
      .text-center.mb-5(data-aos="fade-up")
        h2.fw-bold(data-i18n-key="services.section_title") ما الذي نقدمه
        p.lead.text-muted.services-intro(data-i18n-key="services.section_subtitle") حلول تقنية متكاملة تساعد الشركات على التحول الرقمي والأتمتة والنمو.

      .row.g-4
        //- Cloud Services
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="100")
          .service-card
            .card-icon(style="background: #0E38B1;")
              i.fas.fa-cloud
            h4
              a(href="cloud-services.html" data-i18n-key="services.cloud_title") الحلول السحابية
            p(data-i18n-key="services.cloud_text") استفد من قوة السحابة عبر استضافة قابلة للتوسع، وحاويات، وإدارة خوادم لينكس. نساعدك على الترحيل والتحسين وتأمين بنيتك التحتية.
            a.card-link(href="cloud-services.html")
              span(data-i18n-key="services.learn_more") اعرف المزيد
              i.fas.fa-arrow-right

        //- Odoo Development
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="200")
          .service-card
            .card-icon(style="background: #6E18EF;")
              i.fas.fa-code
            h4
              a(href="odoo-dev.html" data-i18n-key="services.odoo_dev_title") تطوير Odoo ERP و CRM
            p(data-i18n-key="services.odoo_dev_text") تطوير وحدات مخصصة وتكاملات مع الأطراف الخارجية وتحسين الأداء. نبني حلول Odoo مصممة وفقاً لتدفق العمل الخاص بقطاعك.
            a.card-link(href="odoo-dev.html")
              span(data-i18n-key="services.learn_more") اعرف المزيد
              i.fas.fa-arrow-right

        //- Odoo Implementation
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="300")
          .service-card
            .card-icon(style="background: #198754;")
              i.fas.fa-cogs
            h4
              a(href="odoo-imp.html" data-i18n-key="services.odoo_imp_title") تنفيذ Odoo ERP و CRM
            p(data-i18n-key="services.odoo_imp_text") من تحليل المتطلبات إلى الإطلاق، ننفذ مسارات عمل Odoo الخاصة بكل قطاع — بما في ذلك Pharma CRM وإدارة استثمارات الذهب والمزيد.
            a.card-link(href="odoo-imp.html")
              span(data-i18n-key="services.learn_more") اعرف المزيد
              i.fas.fa-arrow-right

        //- Portfolio & E-commerce
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="400")
          .service-card
            .card-icon(style="background: #fd7e14;")
              i.fas.fa-shopping-cart
            h4
              a(href="portfolio.html" data-i18n-key="services.portfolio_title") الأعمال التجارية والتجارة الإلكترونية
            p(data-i18n-key="services.portfolio_text") مواقع أعمال جذابة ومنصات تجارة إلكترونية قوية تعزز علامتك التجارية وتزيد التحويلات عبر تصميم حديث وتجربة مستخدم سلسة.
            a.card-link(href="portfolio.html")
              span(data-i18n-key="services.learn_more") اعرف المزيد
              i.fas.fa-arrow-right

        //- Business Intelligence
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="500")
          .service-card
            .card-icon(style="background: #ffc107;")
              i.fas.fa-chart-bar
            h4
              a(href="business.html" data-i18n-key="services.bi_title") ذكاء الأعمال
            p(data-i18n-key="services.bi_text") حوّل البيانات الخام إلى رؤى قابلة للتنفيذ عبر تحليلات متقدمة ولوحات تحكم تفاعلية وتقارير مؤتمتة مدعومة بـ Power BI وMetabase.
            a.card-link(href="business.html")
              span(data-i18n-key="services.learn_more") اعرف المزيد
              i.fas.fa-arrow-right

        //- ELITE Medical Insurance
        .col-lg-4.col-md-6(data-aos="fade-up" data-aos-delay="600")
          .service-card
            .card-icon(style="background: #dc3545;")
              i.fas.fa-heartbeat
            h4
              a(href="elite.html" data-i18n-key="services.elite_title") التأمين الطبي ELITE
            p(data-i18n-key="services.elite_text") نظام شامل لإدارة التأمين الطبي يضم شبكات مقدمي الخدمة ومعالجة المطالبات وإدارة السياسات وبوابات الأعضاء في الوقت الفعلي.
            a.card-link(href="elite.html")
              span(data-i18n-key="services.learn_more") اعرف المزيد
              i.fas.fa-arrow-right

  .space40

  // CTA Section
  section.pb-5
    .container
      .services-cta.text-center.text-white(data-aos="fade-up")
        h2.fw-bold.mb-3(data-i18n-key="services.cta_title") هل أنت مستعد لتحويل أعمالك؟
        p.lead.mb-4.opacity-75(data-i18n-key="services.cta_text") لنتحدث عن كيفية تسريع نموك عبر حلولنا.
        a.btn.btn-light.btn-lg.fw-semibold.px-4(href="https://wa.me/201017383815" target="_blank" rel="noopener noreferrer")
          i.fab.fa-whatsapp.me-2
          span(data-i18n-key="services.cta_button") تواصل معنا

  include components/footer.pug
  include components/whatsapp-button.pug
