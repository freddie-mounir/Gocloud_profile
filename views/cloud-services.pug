extends layout.pug

block variables
  - var pageTitle = "الخدمات السحابية — البنية التحتية والاستضافة والترحيل | GoCloud"
  - var pageDescription = "خدمات سحابية للمؤسسات تشمل إدارة البنية التحتية واستضافة الخوادم والترحيل السحابي والمراقبة على مدار الساعة. حلول آمنة وقابلة للتوسع للأعمال في مصر."
  - var pageKeywords = "خدمات سحابية مصر, استضافة سحابية, إدارة خوادم, ترحيل سحابي, بنية تحتية, GoCloud"
  - var canonicalUrl = "https://www.gocloudeg.com/cloud-services.html"
  - var ogImage = "https://www.gocloudeg.com/images/gocloud-logo.png"
  - var pageLang = "ar"
  - var pageDir = "rtl"

block content
  // Include components
  include components/preloader.pug
  include components/top-banner.pug
  include components/header.pug

  // Hero Section
  .common-hero
    .container
      .row.align-items-center.text-center
        .col-lg-6.m-auto
          .main-heading
            h1(data-i18n-key="cloud.hero_title") الخدمات السحابية
            .space16
            .span
              img(src="images/span1.webp" alt="" loading="lazy")
              |
              a(href="service.html" data-i18n-key="cloud.breadcrumb_service") الخدمات
              |
              span.arrow
                i.fa-regular.fa-angle-right
              |
              span(data-i18n-key="cloud.breadcrumb_current") الخدمات السحابية

  // Marquee Section
  include components/marquee-brands.pug

  // Services Cards Section
  section
    .d-flex.flex-lg-row.flex-column.container
      .col-lg-4.col-md-12.mx-2.m-2.col-12
        .servcie2-box
          .heading1
            h4.text-center.text-white(data-i18n-key="cloud.card_1_title") الاستضافة
            .space16
            p.text-white(data-i18n-key="cloud.card_1_text") توفر حلول الاستضافة لدينا بنية تحتية موثوقة وآمنة وقابلة للتوسع لتطبيقاتك ومواقعك. نقدم خيارات استضافة مرنة تشمل المشتركة والمخصصة والسحابية، مع دعم فني على مدار الساعة وإجراءات أمان قوية لضمان أعلى جاهزية وأداء لأعمالك.

      .col-lg-4.col-md-12.m-2.col-12
        div
          .servcie2-box
            .heading1
              h4.text-center.text-white(data-i18n-key="cloud.card_2_title") الحاويات
              .space16
              p.text-white(data-i18n-key="cloud.card_2_text") نتخصص في تنفيذ وإدارة حلول الحاويات باستخدام Docker وKubernetes، بما يضمن نشر التطبيقات وتوسيعها بسلاسة. كما تساعد خبراتنا في DevOps المؤسسات على أتمتة مسار التطوير وتطبيق ممارسات CI/CD.

      .col-lg-4.col-md-12.m-2.col-12
        div
          .servcie2-box
            .heading1
              h4.text-center.text-white(data-i18n-key="cloud.card_3_title") دعم لينكس
              .space16
              p.text-white(data-i18n-key="cloud.card_3_text") توفر خدمات دعم لينكس لدينا إدارة شاملة للأنظمة وتقوية الأمان وتحسين الأداء لبيئاتك. ونقدم مساعدة متخصصة في إعداد الخوادم وإدارة الحزم والمستخدمين ومعالجة المشكلات.

  // Partners Section
  .space40
  .space16
    h1.text-center(data-i18n-key="cloud.tech_title") تقنياتنا

  // Partners Logos Section
  .container.mt-5
    .row.justify-content-center.text-center
      .col-md-3.mb-4
        img(src="images/linux.webp" height="100" width="100" alt="Linux" class="img-fluid partner-logo" loading="lazy")

      .col-md-3.mb-4
        img(src="images/net.webp" height="100" width="100" alt="Microsoft" class="img-fluid partner-logo" loading="lazy")

      .col-md-3.mb-4
        img(src="images/contabo.webp" height="100" width="100" alt="Contabo" class="img-fluid partner-logo" loading="lazy")

      .col-md-3.mb-4
        img(src="images/oracle.webp" height="100" width="100" alt="Oracle" class="img-fluid partner-logo" loading="lazy")

      .col-md-3.mb-4
        img(src="images/docker.webp" height="100" width="100" alt="docker" class="img-fluid partner-logo" loading="lazy")

  // Include footer
  include components/footer.pug

  // Include whatsapp button
  include components/whatsapp-button.pug
