extends layout-rtl.pug

block variables
  - var pageTitle = post.title + " — مدونة GoCloud"
  - var pageDescription = post.excerpt
  - var pageKeywords = post.tags.join(', ')
  - var canonicalUrl = "https://www.gocloudeg.com/blog/" + post.slug + ".html"
  - var ogImage = "https://www.gocloudeg.com/" + post.image

block structuredData
  script(type="application/ld+json").
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "#{post.title}",
      "description": "#{post.excerpt}",
      "image": "https://www.gocloudeg.com/#{post.image}",
      "datePublished": "#{post.date}",
      "author": { "@type": "Person", "name": "#{post.author}" },
      "publisher": {
        "@type": "Organization",
        "name": "GoCloud",
        "logo": { "@type": "ImageObject", "url": "https://www.gocloudeg.com/images/gocloud-logo.png" }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.gocloudeg.com/blog/#{post.slug}.html" }
    }

block styles
  style.
    /* ── Blog nav ── */
    .blog-nav{background:#fff;border-bottom:1px solid #e9ecef;padding:.75rem 0;position:sticky;top:0;z-index:100}
    .blog-nav .logo-link{display:flex;align-items:center;gap:8px;text-decoration:none;color:#0D0E10;font-weight:700;font-size:1rem}
    .blog-nav .logo-link img{height:32px;width:32px}
    .blog-nav .nav-links{display:flex;align-items:center;gap:1.5rem}
    .blog-nav .nav-links a{color:#4a4b5c;text-decoration:none;font-size:.85rem;font-weight:500;transition:color .2s}
    .blog-nav .nav-links a:hover,.blog-nav .nav-links a.active{color:#0E38B1}
    .blog-nav .back-link{display:inline-flex;align-items:center;gap:6px;color:#0E38B1;text-decoration:none;font-size:.85rem;font-weight:600}
    .blog-nav .back-link:hover{text-decoration:underline}

    /* ── Post hero ── */
    .post-hero{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 60%,#0E38B1 100%);padding:4rem 0 3rem;position:relative;overflow:hidden}
    .post-hero::after{content:"";position:absolute;bottom:-2px;left:0;right:0;height:60px;background:#fff;clip-path:polygon(0 60%,100% 0,100% 100%,0 100%)}
    .post-hero .breadcrumb-link{color:rgba(255,255,255,.6);text-decoration:none;font-size:.85rem}
    .post-hero .breadcrumb-link:hover{color:#fff}
    .post-hero .breadcrumb-sep{color:rgba(255,255,255,.3);margin:0 8px}
    .post-hero .breadcrumb-current{color:#A1E934;font-weight:600;font-size:.85rem}
    .post-cat-badge{display:inline-block;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);border-radius:50px;padding:4px 14px;font-size:.75rem;font-weight:600;color:#fff;margin-bottom:.75rem}
    .post-hero h1{font-size:2rem;font-weight:800;color:#fff;line-height:1.5;max-width:700px}
    .post-hero-meta{color:rgba(255,255,255,.65);font-size:.85rem;margin-top:.75rem;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}
    .post-hero-meta i{margin-left:4px}

    /* ── Article body ── */
    .article-section{padding:3rem 0 4rem}
    .article-featured-img{width:100%;max-height:420px;object-fit:cover;border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,.08);margin-bottom:2rem}
    .article-content{font-size:1.05rem;line-height:1.9;color:#2d2e3a}
    .article-content h2{font-size:1.4rem;font-weight:700;color:#0D0E10;margin:2rem 0 .75rem;padding-bottom:.5rem;border-bottom:2px solid #EEF2FF}
    .article-content h3{font-size:1.15rem;font-weight:700;color:#0D0E10;margin:1.5rem 0 .5rem}
    .article-content p{margin-bottom:1rem}
    .article-content ul,.article-content ol{padding-right:1.5rem;margin-bottom:1rem}
    .article-content li{margin-bottom:.4rem}
    .article-content a{color:#0E38B1;text-decoration:underline}
    .article-content a:hover{color:#113ADC}
    .article-content strong{color:#0D0E10}

    /* ── Tags ── */
    .post-tags{margin-top:2rem;padding-top:1.5rem;border-top:1px solid #e9ecef;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
    .post-tag{background:#EEF2FF;color:#0E38B1;font-size:.75rem;font-weight:600;padding:4px 12px;border-radius:50px}

    /* ── Share bar ── */
    .share-bar{background:#f7f9ff;border-radius:12px;padding:1.25rem;margin-top:2rem}
    .share-bar h6{font-size:.85rem;font-weight:700;margin-bottom:.75rem;color:#0D0E10}
    .share-btn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;border:1px solid #dee2e6;background:#fff;color:#4a4b5c;font-size:1rem;text-decoration:none;transition:all .25s;cursor:pointer}
    .share-btn:hover{color:#fff}
    .share-btn.wa:hover{background:#25D366;border-color:#25D366}
    .share-btn.li:hover{background:#0077B5;border-color:#0077B5}
    .share-btn.fb:hover{background:#1877F2;border-color:#1877F2}
    .share-btn.copy:hover{background:#0E38B1;border-color:#0E38B1}

    /* ── Sidebar ── */
    .sidebar-card{background:#fff;border:1px solid #e9ecef;border-radius:16px;padding:1.5rem;box-shadow:0 2px 12px rgba(0,0,0,.04);margin-bottom:1.5rem}
    .sidebar-card h5{font-size:1rem;font-weight:700;margin-bottom:1rem;color:#0D0E10}
    .related-item{display:flex;gap:12px;padding:.75rem 0;border-bottom:1px solid #f0f1f5;text-decoration:none;color:inherit;transition:background .2s}
    .related-item:last-child{border-bottom:none}
    .related-item:hover{background:#f7f9ff;border-radius:8px}
    .related-item img{width:64px;height:64px;object-fit:cover;border-radius:10px;flex-shrink:0}
    .related-item .ri-title{font-size:.85rem;font-weight:600;color:#0D0E10;line-height:1.4;margin-bottom:4px}
    .related-item .ri-date{font-size:.72rem;color:#999}
    .cat-link{display:flex;align-items:center;justify-content:space-between;padding:.6rem 0;border-bottom:1px solid #f0f1f5;color:#4a4b5c;text-decoration:none;font-size:.875rem;font-weight:500}
    .cat-link:last-child{border-bottom:none}
    .cat-link:hover{color:#0E38B1}
    .cat-count{background:#EEF2FF;color:#0E38B1;font-size:.72rem;font-weight:700;padding:2px 10px;border-radius:50px}

    /* ── CTA ── */
    .blog-cta{background:linear-gradient(135deg,#0E38B1 0%,#113ADC 100%);border-radius:16px;padding:2.5rem;text-align:center;margin-top:2rem}
    .blog-cta h4{color:#fff;font-weight:800;font-size:1.25rem;margin-bottom:.5rem}
    .blog-cta p{color:rgba(255,255,255,.75);font-size:.9rem;max-width:400px;margin:0 auto .75rem}
    .btn-cta-blog{background:#A1E934;color:#0D0E10;border:none;border-radius:50px;padding:10px 28px;font-weight:700;font-size:.9rem;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:all .3s}
    .btn-cta-blog:hover{background:#8dd22a;transform:translateY(-2px);box-shadow:0 8px 20px rgba(161,233,52,.3);color:#0D0E10}

block content
  //---------- BLOG NAV ----------
  nav.blog-nav
    .container
      .d-flex.align-items-center.justify-content-between
        a.logo-link(href="../index.html")
          img(src="../images/gocloud%20logo.webp" alt="GoCloud" width="32" height="32")
          span GoCloud
        .nav-links.d-none.d-md-flex
          a(href="../index.html") الرئيسية
          a(href="../service.html") الخدمات
          a(href="../contact.html") تواصل معنا
          a.active(href="index.html") المدونة
        a.back-link.d-md-none(href="index.html")
          i.fas.fa-arrow-right
          | المدونة

  //---------- POST HERO ----------
  .post-hero
    .container
      .mb-3
        a.breadcrumb-link(href="../index.html") الرئيسية
        span.breadcrumb-sep /
        a.breadcrumb-link(href="index.html") المدونة
        span.breadcrumb-sep /
        span.breadcrumb-current= post.categoryLabel
      .post-cat-badge= post.categoryLabel
      h1= post.title
      .post-hero-meta
        span
          i.far.fa-calendar-alt
          = ' ' + post.date
        span
          i.far.fa-user
          = ' ' + post.author

  //---------- ARTICLE ----------
  section.article-section
    .container
      .row.g-5
        //- Main content
        .col-lg-8
          img.article-featured-img(src=`../${post.image}` alt=post.title loading="lazy")
          .article-content!= post.content

          //- Tags
          if post.tags && post.tags.length
            .post-tags
              i.fas.fa-tags.ms-2(style="color:#0E38B1")
              each tag in post.tags
                span.post-tag= tag

          //- Share
          .share-bar
            h6 شارك المقال
            .d-flex.gap-2
              a.share-btn.wa(href=`https://wa.me/?text=${encodeURIComponent(post.title + ' — ' + 'https://www.gocloudeg.com/blog/' + post.slug + '.html')}` target="_blank" rel="noopener noreferrer" aria-label="WhatsApp")
                i.fab.fa-whatsapp
              a.share-btn.li(href=`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://www.gocloudeg.com/blog/' + post.slug + '.html')}` target="_blank" rel="noopener noreferrer" aria-label="LinkedIn")
                i.fab.fa-linkedin-in
              a.share-btn.fb(href=`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://www.gocloudeg.com/blog/' + post.slug + '.html')}` target="_blank" rel="noopener noreferrer" aria-label="Facebook")
                i.fab.fa-facebook-f
              button.share-btn.copy(onclick="navigator.clipboard.writeText(window.location.href);this.innerHTML='<i class=\\'fas fa-check\\'></i>';setTimeout(()=>{this.innerHTML='<i class=\\'fas fa-link\\'></i>'},2000)" aria-label="نسخ الرابط")
                i.fas.fa-link

        //- Sidebar
        .col-lg-4
          //- Related posts
          if related && related.length
            .sidebar-card
              h5 مقالات ذات صلة
              each r in related
                a.related-item(href=`${r.slug}.html`)
                  img(src=`../${r.image}` alt=r.title loading="lazy")
                  div
                    .ri-title= r.title
                    .ri-date= r.date

          //- Categories
          .sidebar-card
            h5 التصنيفات
            a.cat-link(href="index.html")
              span الكل
            a.cat-link(href="index.html")
              span التأمين الطبي
            a.cat-link(href="index.html")
              span تطبيقات أودو

          //- CTA
          .blog-cta
            h4 هل تحتاج استشارة؟
            p تواصل معنا للحصول على استشارة مجانية حول حلول التأمين الطبي أو تطبيقات Odoo
            a.btn-cta-blog(href="../contact.html")
              | تواصل معنا
              i.fas.fa-arrow-left
